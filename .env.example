# Supabase — RRFPS project. These are browser-safe (public) values.
# Copy to .env to run the admin portal locally.
PUBLIC_SUPABASE_URL=https://amcitbazknfuhntumnlx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ZiU0fw792KwCuaKH3uLDOg_GgWp-Ti7

# ─── Google Analytics 4 ────────────────────────────────────────────────
# Measurement ID from GA4 → Admin → Data streams → Web (format G-XXXXXXXXXX).
# Public, inlined at build time. Leave blank to omit gtag.js entirely.
PUBLIC_GA_MEASUREMENT_ID=

# ─── Google Search Console ─────────────────────────────────────────────
# Only the content="…" value of the "HTML tag" verification method, e.g.
#   <meta name="google-site-verification" content="THIS_PART" />
# Public, inlined at build time. Leave blank if verifying via DNS instead.
PUBLIC_GSC_VERIFICATION=

# ─── Contact form → Resend (server-only; read at runtime by /api/contact) ─
# Never prefix these with PUBLIC_. Set in Vercel for Production (+ Preview
# if you want previews to send real mail).
# API key from resend.com → API Keys (sending access is enough).
RESEND_API_KEY=
# Inbox that receives leads. Comma-separate for multiple recipients.
CONTACT_TO_EMAIL=info@rrfps.com
# Sender. Must be on a domain verified in Resend (e.g. rrfps.com).
CONTACT_FROM_EMAIL="RRFPS Website <website@rrfps.com>"
