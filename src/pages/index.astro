---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ROUTES } from '../lib/routes';
import { about } from '../data/site';

const arrowPath = 'M0 6.78247C0 6.52555 0.102065 6.27914 0.283741 6.09746C0.465416 5.91579 0.711822 5.81372 0.96875 5.81372H12.1927L8.03288 1.65585C7.85097 1.47394 7.74878 1.22723 7.74878 0.969974C7.74878 0.712721 7.85097 0.466004 8.03288 0.284099C8.21478 0.102194 8.4615 0 8.71875 0C8.976 0 9.22272 0.102194 9.40463 0.284099L15.2171 6.0966C15.3073 6.18659 15.3789 6.29349 15.4278 6.41118C15.4766 6.52888 15.5017 6.65505 15.5017 6.78247C15.5017 6.9099 15.4766 7.03607 15.4278 7.15376C15.3789 7.27146 15.307 7.37836 15.2171 7.46835L9.40463 13.2808C9.22272 13.4628 8.976 13.5649 8.71875 13.5649C8.4615 13.5649 8.21478 13.4628 8.03288 13.2808C7.85097 13.0989 7.74878 12.8522 7.74878 12.595C7.74878 12.3377 7.85097 12.091 8.03288 11.9091L12.1927 7.75122H0.96875C0.711822 7.75122 0.465416 7.64916 0.283741 7.46748C0.102065 7.28581 0 7.0394 0 6.78247Z';
const services = [
  ['Inspections', 'mdi:clipboard-text-outline', ROUTES.serviceInspections],
  ['Fire Sprinkler Systems', 'mdi:fire-hydrant', ROUTES.serviceFireSprinkler],
  ['Fire Alarm Systems', 'mdi:fire', ROUTES.serviceFireAlarm],
  ['Monitoring Services', 'mdi:monitor-dashboard', ROUTES.serviceMonitoring],
  ['Backflow Prevention', 'mdi:water-outline', ROUTES.serviceBackflow],
  ['Portable Fire Extinguishers', 'mdi:fire-extinguisher', ROUTES.serviceExtinguishers],
  ['Distributed Antenna Systems (DAS)', 'mdi:access-point', ROUTES.serviceDas],
  ['Security Systems & Monitoring', 'mdi:shield-lock-outline', ROUTES.serviceSecurity],
  ['Kitchen Hood Suppression', 'mdi:stove', ROUTES.serviceKitchenHood],
  ['Area of Refuge Communications', 'mdi:wheelchair-accessibility', ROUTES.serviceAreaOfRefuge],
  ['Consulting Services', 'mdi:account-group-outline', ROUTES.serviceConsulting],
  ['24 Hour Service', 'mdi:alarm-light-outline', ROUTES.service24Hour],
];
const icon = (name: string) => `<iconify-icon icon="${name}"></iconify-icon>`;
---

<BaseLayout title="Red Rocks Fire Protection Services | One Vendor Life Safety Solution | Colorado" description="Colorado's family-owned life safety partner since 2010. One vendor for fire inspections, sprinklers, alarms, monitoring, and compliance across the Denver Front Range.">
  <div class="home2">
    <section class="hero2" aria-labelledby="hero2-title">
      <div class="hero2__scene">
        <div class="hero2__content">
          <div class="hero2__copy">
            <p class="eyebrow">Colorado's trusted fire protection partner</p>
            <h1 id="hero2-title">Complete fire<br />protection.<br /><span>Peace of mind.</span></h1>
            <div class="rule" aria-hidden="true"><i></i><b></b><i></i></div>
            <h2>One Vendor. One Team. One Mission.</h2>
            <p>From design and installation to inspections, monitoring and 24/7 service, we deliver complete life safety solutions that protect people, property and your peace of mind.</p>
            <div class="actions"><a class="button button--red" href={ROUTES.about}>About RRFPS <span>→</span></a><a class="button button--white" href={ROUTES.services}>Explore our services <span>→</span></a></div>
          </div>
          <aside class="story"><strong>★</strong><small>The story behind</small><h2>John's truck</h2><p>A legacy that drives everything we do.</p><a href={ROUTES.ourStory}>Read the story&nbsp; →</a></aside>
        </div>
      </div>
    </section>

    <section class="responsibility section-light" aria-label="Colorado multi-family community">
      <div class="responsibility__copy"><p class="eyebrow">Protecting people. Protecting property. Staying compliant.</p><h2>You Carry a Big Responsibility.<br /><span>You Shouldn’t Have to Manage It Alone.</span></h2><p>Whether you manage one property or an entire portfolio, life safety comes with enormous responsibility. You are protecting residents, employees, tenants, customers and visitors while navigating inspections, service needs, changing codes, multiple systems and multiple jurisdictions.</p><p class="bold">You don’t need another vendor to manage.<br />You need a life safety partner who helps you stay ahead of it all.</p><a class="button button--red" href={ROUTES.rrfpsDifference}>Discover the RRFPS difference <span>→</span></a></div>
      <p class="responsibility__values" aria-label="Compliance. Responsibility. Confidence."><b>Compliance.</b><b>Responsibility.</b><b>Confidence.</b></p>
    </section>

    <section class="accountability section-dark"><div class="accountability__copy"><p class="eyebrow">One vendor life safety solution</p><h2>One Partner.<br />Complete Accountability.</h2><p>Managing multiple life safety vendors creates more contacts, more schedules, more invoices — and more opportunities for something to fall through the cracks.</p><p>Red Rocks Fire Protection Services was built around a better approach.</p><a class="button button--red" href={ROUTES.services}>Explore our services <span>→</span></a></div><div class="accountability__pillars"><article><span set:html={icon('mdi:handshake-outline')}></span><h3>SIMPLIFY</h3><p>One trusted partner coordinating your life safety needs.</p></article><article><span set:html={icon('mdi:shield-check-outline')}></span><h3>PROTECT</h3><p>Comprehensive systems, inspections, service and monitoring designed around your life safety.</p></article><article><span set:html={icon('mdi:chart-line')}></span><h3>STAY AHEAD</h3><p>Proactive guidance to help you navigate codes, compliance and changing requirements.</p></article></div></section>

    <section class="services2 section-light"><div class="section-head"><div><p class="eyebrow">One vendor life safety solutions</p><h2>Everything Working Together.<br /><span>One Team Responsible for It All.</span></h2></div><p>Your building’s life safety systems don’t operate in isolation. Neither should the companies responsible for them.</p></div><div class="service-grid">{services.map(([title, serviceIcon, href]) => <a href={href}><span set:html={icon(serviceIcon)}></span><b>{title}</b></a>)}</div><a class="button button--outline" href={ROUTES.services}>View all services <span>→</span></a></section>

    <section class="difference2 section-dark"><div class="difference2__copy"><p class="eyebrow">Complete life protection company</p><h2>The RRFPS Difference</h2><p>No other fire protection company combines advocacy, comprehensive service and accountability into a single, unified experience.</p><a class="button button--red" href={ROUTES.rrfpsDifference}>Experience the RRFPS difference <span>→</span></a></div><div class="difference2__pillars"><article><span set:html={icon('mdi:bullhorn-outline')}></span><h3>ADVOCACY</h3><p>We work to stay ahead of evolving codes and requirements so our clients can be informed and prepared.</p></article><article><span set:html={icon('mdi:cog-outline')}></span><h3>COMPREHENSIVE SOLUTIONS</h3><p>One coordinated team. One point of contact. Complete life safety support.</p></article><article><span set:html={icon('mdi:shield-check-outline')}></span><h3>ACCOUNTABILITY</h3><p>We communicate clearly, follow through on commitments, and take ownership of the outcome.</p></article></div></section>

    <section class="industries2 section-light"><div class="section-head"><div><p class="eyebrow">Built around your industry</p><h2>Life Safety Isn’t One-Size-Fits-All.</h2></div><p>The requirements of an apartment community are different from a healthcare facility. A restaurant faces different risks than a data center. That’s why we don’t approach every customer the same way.</p></div><div class="industries__grid industries2__grid">{about.industries.items.map((item) => <a href={item.href} class="industry-card"><div class="industry-card__image-wrap"><img src={item.image ?? about.industries.cardImage} alt="" loading="lazy" decoding="async" class="industry-card__image" style={'imagePosition' in item ? `object-position: ${(item as { imagePosition: string }).imagePosition};` : undefined} /></div><div class="industry-card__body"><h3>{item.title}</h3><p class="industry-card__meta">{item.meta}</p><span class="industry-card__link">Learn more<svg viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg></span></div></a>)}</div><a class="button button--outline" href={ROUTES.industries}>View your industry <span>→</span></a></section>

    <section class="trust-band"><div class="trust-band__copy"><p class="eyebrow">Why Red Rocks Fire Protection</p><h2>Safety.<br />Advocacy.<br />Trust.</h2></div><div><p>Safety is why we exist. Advocacy is how we serve. Trust is what we earn.</p><p>We exist to protect lives and property by simplifying life safety compliance and serving as a proactive partner to the people responsible for keeping their properties safe.</p><a class="button button--red" href={ROUTES.about}>Why RRFPS <span>→</span></a><a class="button button--outline button--outline-light" href={ROUTES.ourPromise}>Our promise <span>→</span></a></div></section>

    <section class="promise-testimonial section-light"><article><p class="eyebrow">Partnership means something to us</p><h2>What You Can Expect From RRFPS</h2><ul><li>We Lead With Safety</li><li>We Respond When It Matters Most</li><li>We Advocate for Our Clients</li><li>We Communicate Clearly &amp; Price Fairly</li><li>We Do What We Say</li><li>We Take Ownership &amp; Make It Right</li><li>We Show Up When We Say We Will</li></ul><a class="button button--red" href={ROUTES.ourPromise}>Read our promise <span>→</span></a></article><article class="testimonial"><p class="eyebrow">Trust is earned</p><h2>Don’t Take Our Word for It.</h2><h3>Our clients experience the RRFPS Difference every day.</h3><blockquote>“RRFPS has been an exceptional partner. Their team is responsive, professional and truly understands the needs of our properties.”</blockquote><b>Brandon Cox</b><small>Director of Maintenance, Bell Partners, Inc.</small><a class="button button--outline" href={ROUTES.testimonials}>Read more client experiences <span>→</span></a></article></section>

    <section class="credentials"><div class="credentials__dark"><p class="eyebrow">Qualified. Certified. Accountable.</p><h2>Expertise You Can Trust With Life Safety.</h2><div class="credential-list"><span>NICET<br /><small>Certified professionals</small></span><span>STATE<br /><small>Licensed</small></span><span>DENVER<br /><small>Certified</small></span><span>CO SPRINGS<br /><small>Licensed</small></span><span>CSIA<br /><small>Certified</small></span><span>DOT<br /><small>Certified</small></span></div><a class="button button--outline button--outline-light" href={ROUTES.about}>View credentials &amp; certifications <span>→</span></a></div><div class="credentials__light"><p class="eyebrow">Local knowledge matters</p><h2>Colorado Life Safety Expertise.</h2><p>As a Colorado-based, family-owned company serving communities across the Front Range, different municipalities, different fire departments. Different jurisdictional requirements.</p><p class="bold">One local partner who understands them.</p><small>Denver Metro • Colorado Springs • Fort Collins • Front Range Communities</small><a class="button button--red" href={ROUTES.serviceAreas}>Explore our service area <span>→</span></a></div></section>

    <section class="closing"><div><p class="eyebrow">Your responsibility is big. Your life safety partner should be ready for it.</p><h2>Let’s Protect What Matters Most.</h2><p>You don’t need more vendors. You need one responsive, experienced partner who understands the responsibility you carry — and is ready to stand beside you.</p></div><div><h3>One Vendor. One Team. One Mission.</h3><h4>Your One Vendor Life Safety Solution.</h4><a class="button button--red" href={ROUTES.contact}>Schedule an appointment <span>→</span></a><a class="button button--outline button--outline-light" href={ROUTES.contact}>Contact our team <span>→</span></a></div></section>
  </div>
</BaseLayout>

<style>
  .home2{--red:var(--rr-red,#d71920);color:#0a0a0a;background:#fff;font-family:var(--av-font-body,Inter,sans-serif)}
  .home2 h1,.home2 h2,.home2 h3,.home2 h4,.home2 b,.home2 strong,.home2 .eyebrow,.home2 .button{font-family:var(--av-font-display,Space Grotesk,sans-serif)}
  .hero2{overflow:hidden}.hero2__scene{min-height:clamp(650px,48vw,780px);background:url('/images/rrfps-truck-hero-sky.png') center/cover no-repeat;position:relative}.hero2__scene:before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,255,255,.97),rgba(255,255,255,.86) 24%,rgba(255,255,255,.25) 48%,transparent 68%)}.hero2__content{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,650px) minmax(280px,1fr);gap:2rem;max-width:1600px;min-height:inherit;margin:auto;padding:clamp(8rem,11vw,12rem) clamp(1.2rem,4vw,4.5rem) 4rem}.hero2__copy{align-self:center}.eyebrow{margin:0 0 .85rem;color:var(--red);font-size:clamp(.72rem,1vw,1rem);font-weight:800;line-height:1.25;letter-spacing:.01em;text-transform:uppercase}.hero2 h1{margin:0;font-size:clamp(3.8rem,5.3vw,6.3rem);line-height:.87;letter-spacing:-.07em;text-transform:uppercase}.hero2 h1 span{color:var(--red)}.rule{display:flex;align-items:center;gap:1rem;width:min(100%,500px);margin:1.8rem 0 1.5rem;color:var(--red)}.rule i{height:1px;flex:1;background:currentColor}.rule b{width:28px;height:15px;border-top:1px solid currentColor;transform:skewY(-35deg) rotate(35deg);border-bottom:1px solid currentColor}.hero2 h2{font-size:clamp(1.2rem,1.6vw,1.6rem);line-height:1.1;letter-spacing:-.04em}.hero2__copy>p:not(.eyebrow){max-width:440px;margin:.65rem 0 1.5rem;line-height:1.45}.actions{display:flex;gap:.8rem;flex-wrap:wrap}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:1.3rem;min-height:48px;padding:.8rem 1.1rem;text-decoration:none;text-transform:uppercase;font-size:.76rem;font-weight:800;letter-spacing:.01em}.button span{font-size:1.3em}.button--red{background:var(--red);color:#fff;border:1px solid var(--red)}.button--white{background:rgba(255,255,255,.9);color:#111;border:1px solid #111}.button--outline{background:transparent;color:#111;border:1px solid #111}.button--outline-light{color:#fff;border-color:#fff}.button:hover{background:#111;color:#fff;border-color:#111}.story{position:relative;align-self:center;justify-self:end;width:min(100%,290px);margin-right:clamp(1rem,8vw,8rem);padding:1.5rem;border-radius:.65rem;background:rgba(255,255,255,.92);box-shadow:0 15px 40px #0002}.story strong{position:absolute;top:-1.2rem;left:-1.15rem;display:grid;place-items:center;width:2.7rem;height:2.7rem;border:3px solid #fff;border-radius:50%;background:var(--red);color:#fff}.story small,.story p{display:block;margin:0}.story small{text-transform:uppercase;font-weight:800}.story h2{margin:.2rem 0 .5rem;color:var(--red);text-transform:uppercase;font-size:1rem}.story p{font-size:.84rem;line-height:1.45}.story a{display:inline-block;margin-top:1rem;color:var(--red);font-family:var(--av-font-display);font-size:.78rem;font-weight:800;text-transform:uppercase;text-decoration:none}.hero2__services{display:grid;grid-template-columns:repeat(6,1fr);max-width:1600px;margin:auto;padding:1.1rem clamp(1rem,3vw,3rem) 1.3rem;background:#fff}.hero2__services a{display:grid;justify-items:center;gap:.35rem;padding:0 .8rem;border-left:1px solid #0002;text-align:center;text-decoration:none;color:#111}.hero2__services a:first-child{border-left:0}.service-icon{display:grid;place-items:center;width:3.7rem;height:3.7rem;margin-bottom:.3rem;border:1px solid #0002;border-radius:50%;color:var(--red)}.service-icon :global(iconify-icon){font-size:2rem}.hero2__services b{font-size:.78rem;text-transform:uppercase}.hero2__services small{max-width:135px;line-height:1.3}.emergency{display:flex;justify-content:space-between;align-items:center;padding:.7rem clamp(1rem,5vw,5rem);background:var(--red);color:#fff;text-transform:uppercase}.emergency strong{font-size:1.05rem}.emergency a{color:#fff;text-decoration:none}.section-light{padding:clamp(3.5rem,7vw,7rem) max(1.25rem,5vw)}.responsibility{display:grid;grid-template-columns:1fr 1.2fr;align-items:center;gap:4rem}.responsibility__copy{max-width:660px}.responsibility h2,.section-head h2,.difference2 h2,.credentials h2,.closing h2{margin:.2rem 0 1.2rem;font-size:clamp(2.2rem,3.6vw,4.3rem);line-height:.95;letter-spacing:-.06em;text-transform:uppercase}.responsibility h2 span,.section-head h2 span{color:#aaa}.responsibility__copy>p:not(.eyebrow){max-width:620px;line-height:1.5}.bold{font-weight:700}.responsibility__image img{display:block;width:100%;aspect-ratio:1.45;object-fit:cover}.responsibility__image>div{display:flex;justify-content:space-around;padding:1rem 0;color:#aaa;font-family:var(--av-font-display);font-size:clamp(.8rem,1.5vw,1.4rem)}.responsibility__image b:nth-child(2){color:#777}.section-dark{display:grid;grid-template-columns:minmax(300px,1fr) minmax(480px,1.2fr);gap:4rem;padding:clamp(4rem,7vw,7rem) max(1.25rem,5vw);background:#091316;color:#fff;background-image:linear-gradient(90deg,#091316ee,#091316d9),url('/images/rrfps-difference-hero-section.jpg');background-size:cover;background-position:center}.section-dark .eyebrow{color:#fff}.section-dark h2{color:#fff}.accountability__copy{max-width:550px}.accountability__copy>p:not(.eyebrow),.difference2__copy>p:not(.eyebrow){max-width:500px;line-height:1.5}.accountability__pillars,.difference2__pillars{display:grid;grid-template-columns:repeat(3,1fr);align-items:stretch}.accountability__pillars article,.difference2__pillars article{padding:1.5rem;border-left:1px solid #fff5}.accountability__pillars span,.difference2__pillars span{font-size:2.7rem;color:#fff}.accountability h3,.difference2 h3{font-size:1.1rem}.accountability p,.difference2 p{line-height:1.4}.services2{background:#fff;text-align:center}.section-head{display:flex;justify-content:space-between;gap:3rem;align-items:end;text-align:left;margin:0 auto 2rem;max-width:1300px}.section-head>p{max-width:360px;line-height:1.45}.service-grid{display:grid;grid-template-columns:repeat(4,1fr);max-width:1300px;margin:0 auto 1.7rem}.service-grid a{display:flex;align-items:center;justify-content:center;gap:.7rem;min-height:86px;border:1px solid #0002;text-decoration:none;color:#111;transition:.2s}.service-grid a:hover{background:#111;color:#fff}.service-grid span{font-size:1.7rem;color:var(--red)}.service-grid b{font-size:.74rem;text-transform:uppercase}.services2>.button{margin:auto}.difference2{background-image:linear-gradient(90deg,#091316ef,#091316d5),url('/images/rrfps-difference-hero-section.jpg')}.difference2__copy{max-width:600px}.difference2__pillars article{background:#0002}.industries2{background:#fff}.industry-grid{display:grid;grid-template-columns:repeat(4,1fr);max-width:1300px;margin:0 auto 2rem}.industry-grid a,.industry-more{display:flex;flex-direction:column;min-height:190px;border:1px solid #0002;text-decoration:none;color:#111}.industry-grid img{width:100%;height:135px;object-fit:cover}.industry-grid b{padding:.65rem;font-size:.78rem;text-transform:uppercase}.industry-more{align-items:center;justify-content:center;background:#111;color:#fff;text-align:center;text-transform:uppercase}.industry-more strong{font-size:1.8rem}.industry-more span{font-family:var(--av-font-display);font-size:.75rem}.industries2>.button{display:flex;width:max-content;margin:auto}.trust-band{display:grid;grid-template-columns:1fr 1fr;gap:4rem;padding:clamp(4rem,7vw,7rem) max(1.25rem,5vw);background:linear-gradient(90deg,#071115ee,#071115d9),url('/images/rrfps-our-core-purpose-bg.png') center/cover;color:#fff}.trust-band .eyebrow{color:#fff}.trust-band h2{font-size:clamp(3.2rem,5vw,5.5rem);line-height:.86;text-transform:uppercase}.trust-band p{max-width:600px;line-height:1.5}.trust-band .button{margin:.5rem .5rem 0 0}.promise-testimonial{display:grid;grid-template-columns:1fr 1fr;gap:5rem}.promise-testimonial article{max-width:620px}.promise-testimonial h2{font-size:clamp(2rem,3vw,3.4rem);line-height:.95;text-transform:uppercase;letter-spacing:-.05em}.promise-testimonial ul{columns:2;list-style:none;padding:0;margin:1.5rem 0}.promise-testimonial li{padding:.4rem 0;font-weight:700}.promise-testimonial li:before{content:'✓';margin-right:.5rem;color:var(--red)}.testimonial{padding-left:2rem;border-left:1px solid #0002}.testimonial h3{font-size:1rem}.testimonial blockquote{margin:2rem 0 1rem;padding:1rem 0 1rem 1.5rem;border-left:4px solid var(--red);font-size:1.15rem;line-height:1.45}.testimonial small,.testimonial b{display:block}.testimonial small{margin:.3rem 0 1.2rem}.credentials{display:grid;grid-template-columns:1fr 1fr}.credentials__dark,.credentials__light{padding:clamp(3rem,6vw,6rem) max(1.25rem,5vw)}.credentials__dark{background:#101b1e;color:#fff}.credentials__dark .eyebrow{color:#fff}.credentials__light{background:#e8eef0 url('/images/rrfps-serving-colorado-diverse-industries.jpg') center/cover}.credential-list{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin:2rem 0}.credential-list span{font-family:var(--av-font-display);font-weight:800}.credential-list small{font-family:var(--av-font-body);font-weight:400;text-transform:uppercase}.credentials__light>p:not(.eyebrow){max-width:550px;line-height:1.5}.credentials__light small{display:block;margin:1.3rem 0}.closing{display:grid;grid-template-columns:1.3fr 1fr;gap:4rem;padding:clamp(4rem,7vw,7rem) max(1.25rem,5vw);background:linear-gradient(90deg,#071115db,#071115bb),url('/images/rrfps-protect-what-matters-most.jpg') center/cover;color:#fff}.closing .eyebrow{color:#fff}.closing h2{color:#fff}.closing p{max-width:700px;line-height:1.5}.closing h3{font-size:1.55rem;margin:1rem 0 .3rem}.closing h4{font-size:1.2rem;margin:0 0 1.5rem}.closing .button{margin:.4rem .4rem 0 0}
  .responsibility__copy .button,
  .accountability__copy .button,
  .difference2__copy .button { margin-top: 0.85rem; }
  .trust-band > div:last-child .button { margin-top: 1.25rem; }
  .story{width:min(100%,260px);transform:translate(clamp(1rem,3vw,3rem),clamp(-14.5rem,-12.5vw,-10.5rem))}
  .hero2 .story h2{max-width:100%;margin:.2rem 0 .5rem;font-size:1.35rem!important;line-height:1;letter-spacing:-.055em;white-space:nowrap}
  @media(max-width:900px){.story{width:min(100%,290px);transform:none}}
  .trust-band{background-image:linear-gradient(90deg,#071115ee,#071115d9),url('/images/rrfps-home-safety-advocacy-trust.png')}
  .difference2{background-image:linear-gradient(90deg,#091316ef,#091316d5),url('/images/rrfps-hoa-management-community-property-services.jpg')}
  .credentials__light{background-image:url('/images/rrfps-our-vision-statement.png')}
  .credentials__light,.credentials__light h2,.credentials__light p,.credentials__light small,.credentials__light .eyebrow{color:#fff}.credentials__light>p:not(.eyebrow),.credentials__light small{color:#fff;text-shadow:0 2px 12px rgba(0,0,0,.55)}
