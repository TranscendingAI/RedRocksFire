---
/**
 * Service Areas — hub page at /service-areas/.
 *
 * Two card sections:
 *   §1 Cities — grouped by region (src/data/cities.ts → cityRegions).
 *      Each region renders its title, then a 3-up grid of city cards.
 *   §2 Counties — the key regional counties (cities.ts → counties) in
 *      the same card style, under a single "Counties" heading.
 *
 * Card links are '#' stubs for now; each becomes a real
 * /service-areas/<slug>/ (or /service-areas/counties/<slug>/) route as
 * that page is built. Closing section reuses the shared <ClosingCTA>
 * banner so this page matches the city pages and other sub-pages.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { cityRegions, counties } from '../data/cities';

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.rrfps.com';
const canonicalAbsolute = `${siteOrigin}/service-areas/`;

const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'Service Areas', item: canonicalAbsolute },
  ],
});
---

<BaseLayout
  title="Service Areas | Red Rocks Fire Protection"
  description="Fire protection services across the Colorado Front Range. RRFPS serves the Denver metro, Boulder area, Northern Colorado, and the Front Range — organized by region and county."
  canonical={canonicalAbsolute}
  type="website"
  schema={breadcrumbSchema}
>
  <div class="av-page service-areas-index">
    <div class="sai-banner" style="background-image: url('/images/red-rocks-fire-protection-home-hero.jpg');">
      <div class="sai-banner__inner">
        <h1 class="sai-banner__title">Service Areas.</h1>
        <nav class="sai-banner__breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sai-banner__divider">-</span>
          <span class="sai-banner__current">Service Areas</span>
        </nav>
      </div>
    </div>

    <section class="sai-intro">
      <div class="sai-intro__inner">
        <p class="sai-intro__eyebrow">Colorado Front Range</p>
        <h2 class="sai-intro__title">One vendor for life-safety across the Denver metro.</h2>
        <p class="sai-intro__body">
          Red Rocks Fire Protection is headquartered in Centennial and serves properties across the Colorado Front Range — from Denver and Aurora down to Colorado Springs, and up to Fort Collins. Every city we work in falls under a specific Authority Having Jurisdiction (AHJ), and our inspection reports are formatted to each AHJ's preferred layout so corrections are approved without rework.
        </p>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════
         §1 CITIES — grouped by region
         ══════════════════════════════════════════════════════════ -->
    <section class="sai-grid">
      <div class="sai-grid__inner">
        <p class="sai-grid__eyebrow">By City</p>
        <h2 class="sai-grid__heading">Cities we serve.</h2>

        {cityRegions.map((group) => (
          <div class="sai-region">
            <h3 class="sai-region__title">{group.region}</h3>
            <div class="sai-grid__list">
              {group.cities.map((c) => (
                <a class="sai-card" href={c.href}>
                  <h4 class="sai-card__city">{c.name}, CO</h4>
                  <span class="sai-card__cta">View city page →</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════
         §2 COUNTIES — key regional counties
         ══════════════════════════════════════════════════════════ -->
    <section class="sai-grid sai-grid--counties">
      <div class="sai-grid__inner">
        <p class="sai-grid__eyebrow">By County</p>
        <h2 class="sai-grid__heading">Counties.</h2>
        <div class="sai-grid__list">
          {counties.map((c) => (
            <a class="sai-card" href={c.href}>
              <h4 class="sai-card__city">{c.name}</h4>
              <span class="sai-card__cta">View county page →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════
         CLOSING — shared ClosingCTA banner (matches city / sub-pages)
         ══════════════════════════════════════════════════════════ -->
    <ClosingCTA
      backgroundImage="/images/rrfps-centennial-cta-bg.jpg"
      paragraphs={[
        "Wherever your properties sit on the Front Range, you get one local team for every life-safety system — inspections, sprinklers, alarms, monitoring, suppression, and backflow — with reports formatted to your Authority Having Jurisdiction so corrections are approved without rework.",
      ]}
    />
  </div>
</BaseLayout>

<style>
  .sai-banner {
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    min-height: 380px;
    padding-top: 154px;
    padding-bottom: 24px;
    display: flex;
    align-items: flex-end;
    position: relative;
    isolation: isolate;
  }
  .sai-banner::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: -1;
  }
  .sai-banner__inner {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 15px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .sai-banner__title {
    margin: 0;
    color: #ffffff;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: clamp(38px, 5.5vw, 75px);
    line-height: 1;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }
  .sai-banner__breadcrumbs {
    color: #ffffff;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 30px;
    letter-spacing: -0.04em;
    padding-bottom: 14px;
  }
  .sai-banner__breadcrumbs a { color: #ffffff; text-decoration: none; }
  .sai-banner__breadcrumbs a:hover { color: #ffffff99; }
  .sai-banner__divider { margin: 0 10px; }
  .sai-banner__current { text-decoration: underline; text-underline-offset: 4px; }

  .sai-intro {
    background: var(--rr-bg-light, #F4F2F1);
    padding-block: 90px;
  }
  @media (min-width: 768px) { .sai-intro { padding-block: 120px; } }
  .sai-intro__inner {
    width: 100%;
    max-width: 1080px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  @media (min-width: 768px) { .sai-intro__inner { padding-inline: 2.5rem; } }
  .sai-intro__eyebrow {
    margin: 0 0 14px;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #d41226;
  }
  .sai-intro__title {
    margin: 0 0 24px;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: clamp(32px, 4.5vw, 52px);
    color: #0a0a0a;
    text-transform: uppercase;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .sai-intro__body {
    margin: 0;
    max-width: 920px;
    font-size: var(--rr-text-lead);
    line-height: var(--rr-text-lead-lh);
    color: rgba(0, 0, 0, 0.75);
  }

  .sai-grid {
    background: #ffffff;
    padding-block: 90px;
  }
  @media (min-width: 768px) { .sai-grid { padding-block: 120px; } }
  /* Counties section sits on the light bg to separate it from the
     white cities section above it. */
  .sai-grid--counties { background: var(--rr-bg-light, #F4F2F1); }
  .sai-grid__inner {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  @media (min-width: 768px) { .sai-grid__inner { padding-inline: 2.5rem; } }
  .sai-grid__eyebrow {
    margin: 0 0 14px;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #d41226;
  }
  .sai-grid__heading {
    margin: 0 0 48px;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: clamp(32px, 4.5vw, 52px);
    color: #0a0a0a;
    text-transform: uppercase;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  /* Each region block: title + its own card grid. */
  .sai-region { margin-bottom: 56px; }
  .sai-region:last-child { margin-bottom: 0; }
  .sai-region__title {
    margin: 0 0 24px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 28px);
    color: #0a0a0a;
    text-transform: uppercase;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .sai-grid__list {
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px)  { .sai-grid__list { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .sai-grid__list { grid-template-columns: repeat(3, 1fr); } }
  .sai-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    padding: 28px 32px;
    background: var(--rr-bg-light, #F4F2F1);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: 0.3s;
  }
  /* On the light-bg counties section, flip the card fill to white so
     cards stay distinct from the section background. */
  .sai-grid--counties .sai-card { background: #ffffff; }
  .sai-card:hover {
    background: #0a0a0a;
    color: #ffffff;
    border-color: #0a0a0a;
  }
  .sai-card:hover .sai-card__cta { color: #ffffff; }
  .sai-card:hover .sai-card__city { color: #ffffff; }
  .sai-card__city {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 24px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #0a0a0a;
  }
  .sai-card__cta {
    display: inline-block;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.04em;
    color: #0a0a0a;
    text-transform: uppercase;
  }
</style>
