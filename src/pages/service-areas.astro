---
/**
 * Service Areas — hub page at /service-areas/.
 *
 * Two card sections:
 *   §1 Cities — grouped by region (src/data/cities.ts → cityRegions).
 *      Each region renders its title, then a 3-up grid of city cards.
 *   §2 Counties — the key regional counties (cities.ts → counties) in
 *      the same card style, under a single "Counties" heading.
 *
 * Card links are '#' stubs for now; each becomes a real
 * /service-areas/<slug>/ (or /service-areas/counties/<slug>/) route as
 * that page is built. Closing section reuses the shared <ClosingCTA>
 * banner so this page matches the city pages and other sub-pages.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { cityRegions, counties } from '../data/cities';

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.rrfps.com';
const canonicalAbsolute = `${siteOrigin}/service-areas/`;

const breadcrumbSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteOrigin}/` },
    { '@type': 'ListItem', position: 2, name: 'Service Areas', item: canonicalAbsolute },
  ],
});

// Shared iconography reused from the About page section patterns.
const diamondIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="20" viewBox="0 0 15 20"><path d="M0.660472 19.6191L0.47542 6.53585L13.7437 19.8041L0.660472 19.6191Z"></path><path d="M14.3396 0.939992L14.5246 14.0232L1.25635 0.754941L14.3396 0.939992Z"></path></svg>';
---

<BaseLayout
  title="Service Areas | Red Rocks Fire Protection"
  description="Fire protection services across the Colorado Front Range. RRFPS serves the Denver metro, Boulder area, Northern Colorado, and the Front Range — organized by region and county."
  canonical={canonicalAbsolute}
  type="website"
  schema={breadcrumbSchema}
>
  <div class="av-page service-areas-index">
    <div class="sai-banner" style="background-image: url('/images/red-rocks-fire-protection-home-hero.jpg');">
      <div class="sai-banner__inner">
        <h1 class="sai-banner__title">Service Areas.</h1>
        <nav class="sai-banner__breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="sai-banner__divider">-</span>
          <span class="sai-banner__current">Service Areas</span>
        </nav>
      </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════
         §A INTRO — split panel (About .overview pattern), light bg
         ══════════════════════════════════════════════════════════ -->
    <section class="sa-overview section-light">
      <div class="section-inner">
        <div class="split-grid">
          <div class="split-copy">
            <div class="section-eyebrow">
              <span class="divider-icon" set:html={diamondIcon} />
              <span>Colorado Front Range</span>
            </div>
            <h2 class="section-title sa-overview__title">One vendor for life-safety across the Denver metro.</h2>
            <div class="sa-overview__body">
              <p>
                Red Rocks Fire Protection Services is proud to provide comprehensive life safety solutions throughout the Colorado Front Range. Headquartered in Centennial, Colorado, we serve commercial, industrial, multi-family, healthcare, educational, retail, and government facilities from Colorado Springs to Fort Collins, delivering dependable fire protection services backed by local expertise and exceptional customer care.
              </p>
              <p>
                As a family-owned company in Centennial, Colorado, since 2010, we understand that every community has unique fire codes, inspection requirements, and Authority Having Jurisdiction (AHJ) standards. Our experienced team works closely with local fire departments and municipal agencies to ensure every inspection, report, repair, installation, and maintenance service is completed accurately and in compliance with local regulations. Because our inspection reports are formatted to meet each AHJ's preferred requirements, we help minimize delays, eliminate unnecessary rework, and keep your property compliant.
              </p>
            </div>
          </div>
          <div class="split-image">
            <img
              src="/images/rrfps-county-inspector-client.jpg"
              alt="A Red Rocks Fire Protection inspector meeting with a Colorado Front Range property manager"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════
         §B WHAT WE COVER — dark split panel, services callout
         ══════════════════════════════════════════════════════════ -->
    <section class="sa-services section-dark">
      <div class="section-inner">
        <div class="split-grid split-grid--reverse">
          <div class="split-image">
            <img
              src="/images/red-rocks-fire-protections-our-inspection-process.jpg"
              alt="Red Rocks Fire Protection technician servicing a life-safety system"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="split-copy">
            <div class="section-eyebrow section-eyebrow--light">
              <span class="divider-icon" set:html={diamondIcon} />
              <span>One Trusted Partner</span>
            </div>
            <h2 class="section-title section-title--light sa-services__title">Every life-safety system, one team.</h2>
            <p class="sa-services__lead">
              Whether you manage a single commercial building or oversee multiple properties across Colorado, Red Rocks Fire Protection Services is one trusted partner for all your life safety needs — responsive, professional support you can count on.
            </p>
            <ul class="sa-services__list">
              <li>Fire alarm systems</li>
              <li>Fire sprinklers</li>
              <li>Fire extinguishers</li>
              <li>Kitchen hood suppression</li>
              <li>Backflow testing</li>
              <li>BDA systems</li>
              <li>Area of Refuge systems</li>
              <li>Inspections &amp; maintenance</li>
              <li>Monitoring &amp; repairs</li>
              <li>Emergency service</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════
         §C LOCAL KNOWLEDGE — image band (About .difference pattern)
         ══════════════════════════════════════════════════════════ -->
    <section class="sa-local difference">
      <div
        class="difference__bg"
        style="background-image: url('/images/the-red-rocks-of-the-canyon.jpg');"
        aria-hidden="true"
      ></div>
      <div class="difference__overlay" aria-hidden="true"></div>
      <div class="section-inner difference__inner">
        <div class="difference__copy">
          <div class="section-eyebrow section-eyebrow--light">
            <span class="divider-icon" set:html={diamondIcon} />
            <span>Local Knowledge, Front Range Wide</span>
          </div>
          <h2 class="section-title section-title--light">Local knowledge makes the difference.</h2>
          <p class="difference__lead">
            Our technicians understand the specific requirements of each municipality and stay current on changing fire codes and compliance standards — proactive guidance that helps clients avoid costly surprises and keep operations running.
          </p>
          <div class="difference__points">
            <div class="difference__point">
              <span class="difference__point-icon" aria-hidden="true">
                <iconify-icon icon="solar:bolt-circle-bold-duotone" width="28" height="28"></iconify-icon>
              </span>
              <strong>Responsive service</strong>
            </div>
            <div class="difference__point">
              <span class="difference__point-icon" aria-hidden="true">
                <iconify-icon icon="solar:chat-round-check-bold-duotone" width="28" height="28"></iconify-icon>
              </span>
              <strong>Transparent communication</strong>
            </div>
            <div class="difference__point">
              <span class="difference__point-icon" aria-hidden="true">
                <iconify-icon icon="solar:tag-price-bold-duotone" width="28" height="28"></iconify-icon>
              </span>
              <strong>Fair pricing</strong>
            </div>
          </div>
          <p class="difference__body">
            No matter where your property sits across the Colorado Front Range, we're committed to expert solutions that keep your people, your property, and your business protected — with the professionalism, integrity, and reliability that are the foundation of our reputation. We serve 40+ communities across ten Colorado counties, including Adams, Arapahoe, Boulder, Broomfield, Denver, Douglas, El Paso, Jefferson, Larimer, and Weld — find yours below.
          </p>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════
         §1 CITIES — grouped by region
         ══════════════════════════════════════════════════════════ -->
    <section class="sai-grid">
      <div class="sai-grid__inner">
        <p class="sai-grid__eyebrow">By City</p>
        <h2 class="sai-grid__heading">Cities we serve.</h2>

        {cityRegions.map((group) => (
          <div class="sai-region">
            <h3 class="sai-region__title">{group.region}</h3>
            <div class="sai-grid__list">
              {group.cities.map((c) => (
                <a class="sai-card" href={c.href}>
                  <h4 class="sai-card__city">{c.name}, CO</h4>
                  <span class="sai-card__cta">View city page →</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════
         §2 COUNTIES — key regional counties
         ══════════════════════════════════════════════════════════ -->
    <section class="sai-grid sai-grid--counties">
      <div class="sai-grid__inner">
        <p class="sai-grid__eyebrow">By County</p>
        <h2 class="sai-grid__heading">Counties.</h2>
        <div class="sai-grid__list">
          {counties.map((c) => (
            <a class="sai-card" href={c.href}>
              <h4 class="sai-card__city">{c.name}</h4>
              <span class="sai-card__cta">View county page →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════
         CLOSING — shared ClosingCTA banner (matches city / sub-pages)
         ══════════════════════════════════════════════════════════ -->
    <ClosingCTA
      backgroundImage="/images/rrfps-centennial-cta-bg.jpg"
      paragraphs={[
        "Wherever your properties sit on the Front Range, you get one local team for every life-safety system — inspections, sprinklers, alarms, monitoring, suppression, and backflow — with reports formatted to your Authority Having Jurisdiction so corrections are approved without rework.",
      ]}
    />
  </div>
</BaseLayout>

<style>
  .sai-banner {
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    min-height: 380px;
    padding-top: 154px;
    padding-bottom: 24px;
    display: flex;
    align-items: flex-end;
    position: relative;
    isolation: isolate;
  }
  .sai-banner::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: -1;
  }
  .sai-banner__inner {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 15px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .sai-banner__title {
    margin: 0;
    color: #ffffff;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: clamp(38px, 5.5vw, 75px);
    line-height: 1;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }
  .sai-banner__breadcrumbs {
    color: #ffffff;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 30px;
    letter-spacing: -0.04em;
    padding-bottom: 14px;
  }
  .sai-banner__breadcrumbs a { color: #ffffff; text-decoration: none; }
  .sai-banner__breadcrumbs a:hover { color: #ffffff99; }
  .sai-banner__divider { margin: 0 10px; }
  .sai-banner__current { text-decoration: underline; text-underline-offset: 4px; }

  /* ── Shared section helpers (borrowed from the About page patterns) ── */
  .section-light { background: #ffffff; color: #0a0a0a; }
  .section-dark { background: #0d0d0b; color: #ffffff; }
  .section-inner {
    width: 100%;
    max-width: 1120px;
    margin-inline: auto;
    padding: 90px 1.25rem;
  }
  @media (min-width: 768px) { .section-inner { padding: 120px 2.5rem; } }
  .section-eyebrow {
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #d41226;
  }
  .section-eyebrow--light { color: rgba(255, 255, 255, 0.72); }
  .section-eyebrow .divider-icon { color: #d41226; display: inline-flex; }
  .section-eyebrow--light .divider-icon { color: #d41226; }
  .section-title {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #0a0a0a;
  }
  .section-title--light { color: #ffffff; }

  /* ── §A / §B split panels ── */
  .split-grid {
    display: grid;
    gap: 48px;
    align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 900px) {
    .split-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; }
  }
  .split-image { overflow: hidden; border-radius: 18px; }
  .split-image img { display: block; width: 100%; aspect-ratio: 4 / 3.4; object-fit: cover; }
  /* Reverse variant (§B): image sits left of copy on wide screens. */
  @media (min-width: 900px) {
    .split-grid--reverse .split-copy { order: 2; }
    .split-grid--reverse .split-image { order: 1; }
  }

  .sa-overview__body p {
    margin: 20px 0 0;
    color: rgba(0, 0, 0, 0.75);
    font-size: var(--rr-text-body);
    line-height: var(--rr-text-body-lh);
  }
  .sa-overview__title { margin-bottom: 4px; }

  .sa-services__title { margin-bottom: 4px; }
  .sa-services__lead {
    margin: 24px 0 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: var(--rr-text-lead);
    line-height: var(--rr-text-lead-lh);
  }
  .sa-services__list {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 24px;
  }
  .sa-services__list li {
    position: relative;
    padding-left: 26px;
    color: rgba(255, 255, 255, 0.9);
    font-family: "Space Grotesk", sans-serif;
    font-weight: 500;
    font-size: 15px;
    line-height: 1.4;
  }
  .sa-services__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    width: 8px;
    height: 8px;
    background: #d41226;
    transform: rotate(45deg);
  }

  /* ── §C local-knowledge image band (About .difference pattern) ── */
  .difference {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #0d0d0b;
    color: #ffffff;
  }
  .difference__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 54%;
    z-index: -2;
  }
  .difference__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.72) 55%, rgba(0, 0, 0, 0.44) 100%);
    z-index: -1;
  }
  .difference__copy { max-width: 820px; }
  .difference__lead {
    margin: 26px 0 0;
    max-width: 760px;
    color: rgba(255, 255, 255, 0.92);
    font-size: var(--rr-text-lead);
    line-height: var(--rr-text-lead-lh);
  }
  .difference__points {
    margin-top: 28px;
    display: grid;
    gap: 16px;
  }
  .difference__point { display: flex; align-items: center; gap: 16px; }
  .difference__point-icon {
    width: 58px;
    height: 58px;
    flex: 0 0 58px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #d41226;
    color: #ffffff;
  }
  .difference__points strong {
    color: #ffffff;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: clamp(20px, 2vw, 28px);
    line-height: 1.25;
  }
  .difference__body {
    max-width: 760px;
    margin: 32px 0 0;
    color: rgba(255, 255, 255, 0.8);
    font-size: var(--rr-text-body);
    line-height: var(--rr-text-body-lh);
  }
  @media (max-width: 640px) {
    .difference__overlay { background: rgba(0, 0, 0, 0.78); }
  }

  .sai-grid {
    background: #ffffff;
    padding-block: 90px;
  }
  @media (min-width: 768px) { .sai-grid { padding-block: 120px; } }
  /* Counties section sits on the light bg to separate it from the
     white cities section above it. */
  .sai-grid--counties { background: var(--rr-bg-light, #F4F2F1); }
  .sai-grid__inner {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  @media (min-width: 768px) { .sai-grid__inner { padding-inline: 2.5rem; } }
  .sai-grid__eyebrow {
    margin: 0 0 14px;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #d41226;
  }
  .sai-grid__heading {
    margin: 0 0 48px;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: clamp(32px, 4.5vw, 52px);
    color: #0a0a0a;
    text-transform: uppercase;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  /* Each region block: title + its own card grid. */
  .sai-region { margin-bottom: 56px; }
  .sai-region:last-child { margin-bottom: 0; }
  .sai-region__title {
    margin: 0 0 24px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 28px);
    color: #0a0a0a;
    text-transform: uppercase;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .sai-grid__list {
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px)  { .sai-grid__list { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .sai-grid__list { grid-template-columns: repeat(3, 1fr); } }
  .sai-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    padding: 28px 32px;
    background: var(--rr-bg-light, #F4F2F1);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: 0.3s;
  }
  /* On the light-bg counties section, flip the card fill to white so
     cards stay distinct from the section background. */
  .sai-grid--counties .sai-card { background: #ffffff; }
  .sai-card:hover {
    background: #0a0a0a;
    color: #ffffff;
    border-color: #0a0a0a;
  }
  /* County cards hover to brand red instead of the dark fill. */
  .sai-grid--counties .sai-card:hover {
    background: #d41226;
    border-color: #d41226;
  }
  .sai-card:hover .sai-card__cta { color: #ffffff; }
  .sai-card:hover .sai-card__city { color: #ffffff; }
  .sai-card__city {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 24px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #0a0a0a;
  }
  .sai-card__cta {
    display: inline-block;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.04em;
    color: #0a0a0a;
    text-transform: uppercase;
  }
</style>
