<script>
  // Accordion controller — same pattern as the city page. Defensive
  // registration to survive Astro View Transitions hoisting.
  function initCountyAccordions() {
    const panels = document.querySelectorAll<HTMLElement>('.county-page [data-acc-panel]');
    if (!panels.length) return false;
    panels.forEach((panel) => {
      const header = panel.querySelector<HTMLButtonElement>('.acc__header');
      if (!header || (panel as any).__wired) return;
      (panel as any).__wired = true;
      header.addEventListener('click', () => {
        const isActive = panel.classList.toggle('is-active');
        header.setAttribute('aria-expanded', isActive ? 'true' : 'false');
        const content = panel.querySelector<HTMLElement>('.acc__content');
        if (content) content.hidden = !isActive;
      });
    });
    return true;
  }

  function bindCountyAccordions() {
    if (!initCountyAccordions()) setTimeout(initCountyAccordions, 100);
  }

  document.addEventListener('astro:page-load', bindCountyAccordions);
  document.addEventListener('astro:after-swap', bindCountyAccordions);
  document.addEventListener('DOMContentLoaded', bindCountyAccordions);
  if (document.readyState !== 'loading') bindCountyAccordions();
</script>
