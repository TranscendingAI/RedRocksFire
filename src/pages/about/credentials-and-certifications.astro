---
/**
 * Our Credentials & Certifications — /about/credentials-and-certifications/
 *
 * Company and technician credentials, licensing, and industry standards,
 * followed by the shared credential-logo panel used on Meet Our Team.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const bannerImage = '/images/red-rocks-fire-protection-multi-family-hero.jpg';

const companyLicenses = [
  'State Sprinkler Contractor License',
  'State Backflow Contractor License',
  'State Sprinkler Fitters License',
  'Denver Fire Alarm Contractor License',
  'Denver Fire Sprinkler Contractor License',
  'Colorado Springs Fire Alarm Contractor License',
  'Colorado Springs Fire Sprinkler Contractor License',
  'Colorado Fire Extinguisher License',
  'DOT Certified Extinguisher Room',
] as const;

const technicianCertifications = [
  'NICET IV – Fire Alarm Installation',
  'NICET III – Water-Based Systems Layout and Design',
  'NICET III – Sprinkler Systems Testing and Inspection',
  'NICET II – Fire Alarm Testing and Inspection',
  'CSA – Fire Alarm Certification',
  'CSA – Fire Sprinkler Certification',
  'CSA – Fire Extinguisher Certification',
  'CSA – Kitchen Hood Suppression Systems Certification',
] as const;

const credentials = [
  { src: '/images/credential-logos/ASSE-logo.png', alt: 'American Society of Sanitary Engineering' },
  { src: '/images/credential-logos/CDFPC-logo.png', alt: 'Colorado Division of Fire Prevention & Control' },
  { src: '/images/credential-logos/CSA-logo.png', alt: 'CSA — Canadian Standards Association' },
  { src: '/images/credential-logos/pprbd-logo.png', alt: 'Pikes Peak Regional Building Department' },
  { src: '/images/credential-logos/IAPMO-logo.png', alt: 'IAPMO R&T' },
  { src: '/images/credential-logos/NICET-logo.png', alt: 'NICET' },
] as const;
---

<BaseLayout
  title="Our Credentials & Certifications | Red Rocks Fire Protection"
  description="Explore the licenses, technician certifications, and industry credentials behind Red Rocks Fire Protection Services."
>
  <div class="av-page credentials-page">
    <header class="ptbanner">
      <div class="ptbanner__bg" style={`background-image: url('${bannerImage}');`} aria-hidden="true"></div>
      <div class="ptbanner__overlay" aria-hidden="true"></div>
      <div class="ptbanner__inner">
        <h1 class="ptbanner__title">Our Credentials &amp; Certifications.</h1>
        <div class="ptbanner__breadcrumbs">
          <a href="/">Home</a><span class="ptbanner__divider">-</span>
          <a href="/about/">About</a><span class="ptbanner__divider">-</span>
          <span class="ptbanner__current">Credentials &amp; Certifications</span>
        </div>
      </div>
    </header>

    <section class="credentials-intro">
      <div class="credentials-intro__inner">
        <h2>Certifications, Licensing<br />&amp; Industry Credentials</h2>
        <div class="credentials-intro__copy">
          <p>Red Rocks Fire Protection Services operates in a highly regulated industry where certifications, licensing, and compliance are critical to ensuring the safety, reliability, and performance of life safety systems.</p>
          <p>Our team and company hold a comprehensive range of industry-recognized certifications and licenses, reflecting our commitment to maintaining the highest standards in fire protection services across Colorado.</p>
          <p>These credentials are not just qualifications, they are a direct reflection of our responsibility to deliver systems that meet code, perform when needed, and protect lives and property.</p>
        </div>
      </div>
    </section>

    <section class="license-section">
      <div class="license-section__inner">
        <div class="license-card">
          <h2>Company Licenses</h2>
          <ul>{companyLicenses.map((license) => <li>{license}</li>)}</ul>
        </div>
        <div class="license-card">
          <h2>Technician Certifications</h2>
          <p>Our team includes highly trained professionals with advanced certifications, including:</p>
          <ul>{technicianCertifications.map((certification) => <li>{certification}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="compliance-section">
      <div class="compliance-section__box">
        <div class="compliance-section__copy">
          <h2>Commitment to Compliance<br />and Excellence</h2>
          <div class="compliance-section__text">
            <p>With extensive licensing and certification across multiple disciplines, Red Rocks Fire Protection Services ensures that every system we design, install, inspect, and maintain meets or exceeds local, state, and national fire safety standards.</p>
            <p>We actively stay current with evolving codes, regulations, and jurisdictional requirements, reinforcing our role as a proactive partner and trusted advisor in life safety compliance.</p>
          </div>
        </div>
        <div class="compliance-section__image" role="img" aria-label="Commitment to compliance and excellence">
          <img src="/images/rrfps-services-cta-bg.png" alt="Red Rocks Fire Protection Services compliance and certification in action" loading="lazy" decoding="async" />
        </div>
      </div>
    </section>

    <section class="mt-credentials">
      <div class="mt-credentials__inner">
        <h2 class="mt-credentials__title">Our Credentials &amp; Certifications</h2>
        <div class="mt-credentials__grid">
          {credentials.map((credential) => (
            <div class="mt-credential"><img src={credential.src} alt={credential.alt} loading="lazy" decoding="async" /></div>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .ptbanner { position: relative; isolation: isolate; background: #0d0d0b; overflow: hidden; }
  .ptbanner__bg { position: absolute; inset: 0; background-size: cover; background-position: center 32%; z-index: -2; }
  .ptbanner__overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(7,7,7,.46), rgba(7,7,7,.58)); z-index: -1; }
  .ptbanner__inner { min-height: 448px; max-width: 1120px; margin: 0 auto 60px; padding: 136px 80px 36px; display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; }
  .ptbanner__title { margin: 0; max-width: 920px; color: #fff; font-family: "Space Grotesk", sans-serif; font-weight: 700; font-size: clamp(38px, 5.5vw, 75px); line-height: .9; letter-spacing: -.055em; text-transform: uppercase; }
  .ptbanner__breadcrumbs { padding-bottom: 10px; color: #fff; font: 600 15px "Space Grotesk", sans-serif; white-space: nowrap; }
  .ptbanner__breadcrumbs a { color: #fff; text-decoration: none; }
  .ptbanner__divider { margin-inline: 10px; }
  .ptbanner__current { text-decoration: underline; text-underline-offset: 4px; }

  .credentials-intro { background: #fff; padding: 110px 80px 60px; }
  .credentials-intro__inner, .compliance-section__box { max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 90px; }
  h2 { margin: 0; color: #0a0a0a; font: 700 clamp(34px, 4.4vw, 60px)/1.02 "Space Grotesk", sans-serif; letter-spacing: -.045em; text-transform: uppercase; }
  .credentials-intro__copy { color: #232323; font-size: var(--rr-text-body); line-height: var(--rr-text-body-lh); }
  .compliance-section__copy { display: flex; flex-direction: column; gap: 42px; }
  .compliance-section__copy h2 { color: #fff; }
  .compliance-section__text { color: #fff; font-size: var(--rr-text-body); line-height: var(--rr-text-body-lh); }
  .compliance-section__image { overflow: hidden; border-radius: 18px; min-height: 390px; background: #555; }
  .compliance-section__image img { display: block; width: 100%; aspect-ratio: 4 / 4.2; object-fit: cover; }
  p { margin: 0 0 22px; }
  p:last-child { margin-bottom: 0; }

  .license-section { background: #fff; padding: 60px 80px 110px; }
  .license-section__inner { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
  .license-card { background: #d41226; border-radius: 18px; padding: 48px 48px 52px; color: #fff; overflow: hidden; }
  .license-card h2 { color: #fff; font-size: clamp(28px, 3vw, 42px); margin-bottom: 30px; }
  .license-card p { line-height: 1.5; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { position: relative; padding: 12px 0 12px 23px; border-top: 1px solid rgba(255,255,255,.32); line-height: 1.35; }
  li:last-child { border-bottom: 1px solid rgba(255,255,255,.32); }
  li::before { content: ''; position: absolute; left: 0; top: 20px; width: 7px; height: 7px; background: #fff; transform: rotate(45deg); }

  .compliance-section { background: #0a0a0a; padding: 110px 80px; }
  .compliance-section__box { padding: 0; }
  .mt-credentials { background: #fff; padding: 56px 80px; }
  .mt-credentials__inner { max-width: 1280px; margin: 0 auto; }
  .mt-credentials__title { margin: 0 0 36px; font-size: clamp(22px, 2vw, 28px); letter-spacing: .02em; }
  .mt-credentials__grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; align-items: center; justify-items: center; }
  .mt-credential { width: 100%; max-width: 180px; display: grid; place-items: center; }
  .mt-credential img { display: block; max-width: 100%; max-height: 100px; width: auto; height: auto; object-fit: contain; }

  @media (max-width: 900px) {
    .ptbanner__inner { min-height: 376px; padding-inline: 60px; }
    .credentials-intro, .compliance-section { padding-inline: 60px; padding-bottom: 36px; }
    .license-section { padding-inline: 60px; padding-top: 36px; }
    .credentials-intro__inner, .compliance-section__box { grid-template-columns: 1fr; gap: 40px; }
    .license-section__inner { grid-template-columns: 1fr; }
    .mt-credentials { padding-inline: 60px; }
    .mt-credentials__grid { grid-template-columns: repeat(3, 1fr); row-gap: 32px; }
  }
  @media (max-width: 767px) {
    .ptbanner__inner { min-height: 312px; padding: 108px 28px 28px; flex-direction: column; align-items: flex-start; justify-content: flex-end; }
    .ptbanner__title { font-size: 50px; }
    .ptbanner__breadcrumbs { white-space: normal; }
    .credentials-intro, .compliance-section { padding: 72px 28px 36px; }
    .license-section { padding: 36px 28px 72px; }
    .license-card { padding: 34px 28px 38px; }
    .compliance-section__box { padding: 38px 28px; }
    .mt-credentials { padding: 40px 28px; }
    .mt-credentials__grid { grid-template-columns: repeat(2, 1fr); row-gap: 28px; }
  }
</style>
