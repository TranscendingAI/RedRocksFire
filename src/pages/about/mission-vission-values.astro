    color: #d41226;
    font-family: "Space Grotesk", sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .mvv-value__title {
    margin: 0 0 14px;
    /* Title defaults to black (light bg); the dark-band modifier
