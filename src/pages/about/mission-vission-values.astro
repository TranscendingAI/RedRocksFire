     * which creates a hairline where the cards meet. */
    gap: 0;
    width: 100%;
  }
  .mvv-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* Square card per client revision (was 4/5 portrait — too
     * tall). With 2 columns at 0 gap on desktop, each card is
