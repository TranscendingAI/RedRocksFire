    max-width: none;
    color: #232323;
    font-size: var(--rr-text-lead);
    line-height: var(--rr-text-lead-lh);
  }
  /* Dark-band color overrides — text + icon flip to white/light
   * so they read against the dark #262626 bg color. The red icon
