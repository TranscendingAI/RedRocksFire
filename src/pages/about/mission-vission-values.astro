     * so the two cards together form a 50vw × 100vw square
     * block (since they're side-by-side at 1:1 each, the
     * combined shape is 2:1 — a wide rectangle). */
    aspect-ratio: 1 / 1;
    /* No background-color fallback needed since both cards have
