  /* ══════════════════════════════════════════════════════════
   * §4-8. THE 5 CORE VALUES
   * Full-bleed dark bg image band per value. The bg image fills
   * the viewport edge-to-edge (no max-width); the content sits
   * inside a boxed-width .section-inner container so the text
   * has a comfortable gutter from the viewport edges while the
   * bg photo reads as a panoramic dramatic band.
   *
   * Pattern mirrors about.astro §9 .difference: position:
   * relative; isolation: isolate; bg + overlay stack behind
   * the content; overlay darkens the photo for legibility.
   *
   * Per client revision (2026-09): the band is significantly
   * shorter now (40px top/bottom vs the shared .section-inner's
   * 110px) so all 5 cards together read as a compact stacked
   * list rather than 5 full-page-height bands. The text column
   * also widens (max-width: 1100px vs the old 720px) so the
   * title and body read as a wider editorial band. The icon now
   * sits on the LEFT of the copy block (icon + copy grid) so
   * the layout reads as a horizontal row rather than a stacked
   * "icon above text" column.
   *
   * Per client revision (latest): each value band now uses the
   * CTA-style "alternating gradient blend" — the bg image sits
   * full-strength on the RIGHT side, while a SOLID color bleeds
   * from the LEFT edge (via a left→right linear-gradient
   * overlay) to fill the text area with a flat color that
   * gives the band its own visual identity. Text + icon colors
   * flip based on the bg-color lightness (light bg → dark text,
   * dark bg → light text).
   *
   * Per-band blend colors (5 cards, alternating light/dark):
   *   1. Safety First — Always        → #F0F0F0 (light)
   *   2. Advocacy for Our Clients      → #262626 (dark)
   *   3. Go the Extra Mile             → #F0F0F0 (light)
   *   4. Character                     → #262626 (dark)
   *   5. One Family                    → #F0F0F0 (light)
   * ══════════════════════════════════════════════════════════ */
  .mvv-value {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: #0d0d0b;
    color: #ffffff;
    /* Override .section-inner's 110/80 padding down to 40/0 so
     * the band is significantly shorter. Horizontal padding
     * stays 0 so the bg image bleeds edge-to-edge. The text
     * column gets its own horizontal padding via .mvv-value-
     * __inner so the copy doesn't sit flush with the viewport. */
    padding-block: 40px;
  }
  /* CTA-style alternating gradient blend — the bg photo sits in a
   * dedicated .mvv-value__media wrapper anchored to the RIGHT
   * 25% of the band (so it physically lives on the right side,
   * not just visually obscured by the gradient). The wrapper
   * contains the .mvv-value__bg div which uses background-size:
   * cover to fill the wrapper completely — this means every
   * image (whether portrait or landscape) is auto-cropped to
   * fill the right-25%-wide × band-height-tall panel with no
   * empty space, regardless of the source image's aspect ratio. */
  .mvv-value__media {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    /* The wrapper takes up the RIGHT 25% of the band width and
     * the FULL height of the band (top:0 + bottom:0 = 100% height).
     * With `left: auto` and an explicit right offset, the
     * wrapper is constrained to the right edge. */
    width: 25%;
    overflow: hidden;
    z-index: -2;
  }
  .mvv-value__bg {
    position: absolute;
    inset: 0;
    /* background-size: cover fills the wrapper completely with
     * the image, auto-cropping to fit. The 4 landscape images
     * (1.75:1) crop to show only a horizontal slice of the
     * photo's middle; the 1 portrait image (0.667:1) crops to
     * show the photo's full height with a horizontal slice cut
     * off. Either way, every image fills the band height —
     * matching the Go-the-Extra-Mile band (the-call-when-it-
     * counts.jpg) which already rendered correctly because its
     * portrait aspect ratio happened to match the band height
     * via background-size: 25% auto. */
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    z-index: -2;
  }
  /* CTA-style alternating gradient overlay. Solid bg color
   * from the LEFT edge fills the left 75% of the band, then
   * fades to fully transparent by 100% so the bg photo (which
   * sits in the right 25%) shows through cleanly. Each band
   * gets its own --blend-light or --blend-dark modifier (set
   * inline on the section element via the values loop below)
   * which controls the gradient stops. */
  .mvv-value__overlay {
    position: absolute;
    inset: 0;
    /* Default = light blend (#F0F0F0). The dark-blend modifier
     * overrides these stops via its own rule below. */
    background: linear-gradient(
      90deg,
      #f0f0f0 0%,
      #f0f0f0 75%,
      rgba(240, 240, 240, 0) 100%
    );
    z-index: -1;
  }
  .mvv-value__overlay--dark {
    background: linear-gradient(
      90deg,
      #262626 0%,
      #262626 75%,
      rgba(38, 38, 38, 0) 100%
    );
  }
  .mvv-value__inner {
    position: relative;
    z-index: 1;
    /* Horizontal grid: icon on the LEFT (auto-sized to its 56px
     * box), copy block on the RIGHT. Copy block expands to fill
     * the rest of the container up to a much wider 1100px
     * max-width so the title and body read as a wider editorial
     * column instead of a narrow text column with empty space
     * to the right. */
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 32px;
    max-width: 1100px;
    /* The .section-inner class also on this element would
     * normally apply its shared padding: 110px 80px (top/
     * bottom of the inner container). Per client revision
     * (2026-09), the value bands need a much tighter vertical
     * rhythm — 50px top/bottom here plus the .mvv-value
     * section's own padding-block: 40px = 90px total band
     * breathing room, vs the 220px (110 + 110) the shared
     * .section-inner + inherited section padding would give.
     * Horizontal padding stays 0 so the icon-to-edge spacing
     * is consistent with the other full-bleed bands. */
    padding-block: 50px;
  }
  .mvv-value__icon {
    display: inline-grid;
    place-items: center;
    /* Slightly smaller icon (56px vs 64px) since the bands are
     * shorter now — keeps the icon proportional to the new
     * 60px vertical padding instead of dwarfing it. */
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #d41226;
    color: #ffffff;
    /* Drop the margin-bottom (was 32px) — the icon no longer
     * stacks above the text, so it doesn't need a bottom
     * gutter. Vertical centering via `align-items: center` on
     * the parent grid handles the icon's vertical placement. */
    margin: 0;
    flex-shrink: 0;
  }
  .mvv-value__icon iconify-icon {
    color: currentColor;
    stroke: currentColor;
    stroke-width: 1;
  }
  .mvv-value__eyebrow {
    margin: 0 0 8px;
    /* Eyebrow defaults to the dark-text color (light bg); the
