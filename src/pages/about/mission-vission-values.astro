   * iconify-icon glyph flips to white via the existing
   * `color: currentColor` chain (the span's color is now white). */
  .mvv-value--dark .mvv-value__icon {
    color: #ffffff;
  }
  .mvv-value--dark .mvv-value__title {
    color: #ffffff;
  }
  .mvv-value--dark .mvv-value__body {
