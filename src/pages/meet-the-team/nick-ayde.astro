---
/**
 * Nick Ayde — /meet-the-team/nick-ayde/
 *
 * Individual bio page. Mirrors brian-kakac.astro 1:1:
 *   §0. Page-title banner
 *   §1. Bio — 1/3 photo + 2/3 copy
 *   §2. Closing CTA
 *
 * Photo placeholder uses the same <iconify-icon icon="mdi:account">
 * glyph the team grid renders for members without a real headshot.
 * Swap to a real portrait once assets are supplied.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';

const heroBg = '/images/rrfps-about-cta-bg.jpg';
const ctaBg = '/images/meet-our-team-rrfps-cta-banner-bg.jpg';

const bioParagraphs = [
  'Nick Ayde leads sales for Red Rocks Fire Protection Services, serving as the primary point of contact for new business opportunities and helping customers identify the fire and life safety solutions that best meet the needs of their properties. He works directly with property owners, property managers, developers, and other decision-makers to understand their facilities, address their concerns, and connect them with the comprehensive capabilities available through RRFPS.',
  'With more than 17 years of experience in sales and customer service, Nick brings a relationship-focused approach to every customer interaction. His strengths in problem solving, negotiation, strategic planning, and communication help him look beyond an immediate service request to understand the bigger picture and identify how Red Rocks can support a customer\u2019s property over the long term.',
  'Nick represents the full range of RRFPS capabilities, helping customers navigate services that include fire alarm and sprinkler systems, monitoring, backflow prevention, inspections and compliance testing, system repairs, and ongoing service. His approach is straightforward: listen carefully, communicate clearly, understand the customer\u2019s needs, and help develop the right solution.',
  'Nick joined Red Rocks Fire Protection Services because of the company\u2019s culture, core values, and genuine commitment to its customers. What stood out to him was something he hadn\u2019t experienced at previous companies: a team that truly puts the customer\u2019s best interests first rather than focusing on making a quick buck. He also values the culture Red Rocks has built\u2014people enjoy coming to work, spend time together outside of the day-to-day, look out for one another, and genuinely put the team above themselves. For Nick, the character of the people at Red Rocks and the way they take care of both their customers and each other is what makes the company special.',
  'Outside of work, Nick enjoys spending time with his wife, Jenni, their French Bulldog, Eggsy, and their two cats, Sweet Dee and Ollie. He has a passion for music and traveling the world. From Tokyo and Thailand to Cambodia, Scotland, Sweden, and Norway, Nick has always been fascinated by experiencing different cultures, traditions, and ways of life. Traveling continues to be one of his favorite ways to experience something new, and there are still plenty of places on his list to explore.',
] as const;
---

<BaseLayout
  title="Nick Ayde | Sales, Red Rocks Fire Protection Services"
  description="Meet Nick Ayde, Sales lead at Red Rocks Fire Protection Services \u2014 17+ years of relationship-driven sales helping Colorado property owners navigate fire and life safety solutions."
>
  <div class="av-page na-page">

    <header class="ptbanner">
      <div class="ptbanner__bg" style={`background-image: url('${heroBg}');`} aria-hidden="true"></div>
      <div class="ptbanner__overlay" aria-hidden="true"></div>
      <div class="ptbanner__inner">
        <h1 class="ptbanner__title">Nick Ayde.</h1>
        <div class="ptbanner__breadcrumbs">
          <a href="/">Home</a>
          <span class="ptbanner__divider">-</span>
          <a href="/meet-the-team">Meet Our Team</a>
          <span class="ptbanner__divider">-</span>
          <span class="ptbanner__current">Nick Ayde</span>
        </div>
      </div>
    </header>

    <section class="na-bio" aria-label="Nick Ayde bio">
      <div class="na-bio__inner">

        <div class="na-bio__photo" aria-hidden="true">
          <iconify-icon icon="mdi:account" width="160" height="160"></iconify-icon>
        </div>

        <div class="na-bio__copy">
          <div class="na-bio__name">Nick Ayde</div>
          <div class="na-bio__role">Sales | Red Rocks Fire Protection Services</div>
          <div class="na-bio__rule" aria-hidden="true"></div>

          <div class="na-bio__body">
            {bioParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>

      </div>
    </section>

    <ClosingCTA
      backgroundImage={ctaBg}
      paragraphs={[
        'Choosing the right life safety partner is about more than installing equipment and meeting code. It is about trusting the team you put in front of your residents, your tenants, and your inspectors \u2014 and knowing the people behind the truck have real accountability for the work they do.',
      ]}
    />

  </div>
</BaseLayout>

<style>
  .ptbanner { position: relative; isolation: isolate; background: #0d0d0b; overflow: hidden; }
  .ptbanner__bg { position: absolute; inset: 0; background-size: cover; background-position: center 32%; z-index: -2; }
  .ptbanner__overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(7, 7, 7, 0.46) 0%, rgba(7, 7, 7, 0.58) 100%); z-index: -1; }
  .ptbanner__inner { min-height: 448px; max-width: 1120px; margin-inline: auto; margin-bottom: 60px; padding: 136px 80px 36px; display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; }
  .ptbanner__title { margin: 0; max-width: 920px; color: #ffffff; font-family: "Space Grotesk", sans-serif; font-weight: 700; font-size: clamp(38px, 5.5vw, 75px); line-height: 0.9; letter-spacing: -0.055em; text-transform: uppercase; }
  .ptbanner__breadcrumbs { padding-bottom: 10px; color: #ffffff; font-family: "Space Grotesk", sans-serif; font-size: 15px; font-weight: 600; white-space: nowrap; }
  .ptbanner__breadcrumbs a { color: #ffffff; text-decoration: none; }
  .ptbanner__divider { margin-inline: 10px; }
  .ptbanner__current { text-decoration: underline; text-underline-offset: 4px; }

  .na-bio { background: #ffffff; padding: 96px 80px 120px; }
  .na-bio__inner { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); column-gap: 56px; row-gap: 48px; align-items: start; }
  .na-bio__photo { position: relative; width: 100%; aspect-ratio: 1 / 1.1; overflow: hidden; background: #d6d6d6; color: #ffffff; display: grid; place-items: center; }
  .na-bio__photo iconify-icon { color: currentColor; }
  .na-bio__copy { display: flex; flex-direction: column; min-width: 0; }
  .na-bio__name { color: #0a0a0a; font-family: "Space Grotesk", sans-serif; font-size: clamp(36px, 4vw, 56px); font-weight: 700; line-height: 1; letter-spacing: -0.04em; text-transform: uppercase; }
  .na-bio__role { margin-top: 18px; color: #d41226; font-family: "Space Grotesk", sans-serif; font-size: clamp(15px, 1.1vw, 18px); font-weight: 600; line-height: 1.4; letter-spacing: 0.02em; }
  .na-bio__rule { margin-top: 28px; width: 100%; height: 2px; background: #d41226; }
  .na-bio__body { margin-top: 36px; color: #0a0a0a; font-family: "Space Grotesk", sans-serif; font-size: 17px; font-weight: 400; line-height: 1.6; }
  .na-bio__body p + p { margin-top: 22px; }

  @media (max-width: 1100px) {
    .ptbanner__inner { min-height: 376px; padding-inline: 60px; }
    .na-bio { padding: 80px 60px 96px; }
    .na-bio__inner { column-gap: 40px; }
    .na-bio__body { font-size: 16px; }
  }
  @media (max-width: 900px) {
    .na-bio__inner { grid-template-columns: minmax(0, 1fr); row-gap: 36px; }
    .na-bio__photo { aspect-ratio: 4 / 3; max-width: 520px; }
  }
  @media (max-width: 767px) {
    .ptbanner__inner { min-height: 312px; padding: 108px 28px 28px; flex-direction: column; align-items: flex-start; justify-content: flex-end; }
    .ptbanner__title { font-size: 54px; }
    .ptbanner__breadcrumbs { white-space: normal; }
    .na-bio { padding: 64px 28px 80px; }
    .na-bio__rule { margin-top: 24px; }
    .na-bio__body { margin-top: 28px; font-size: 16px; }
    .na-bio__body p + p { margin-top: 18px; }
  }
</style>
