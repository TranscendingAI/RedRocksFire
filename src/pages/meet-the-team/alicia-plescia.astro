---
/**
 * Alicia Plescia — /meet-the-team/alicia-plescia/
 *
 * Individual bio page. Mirrors brian-kakac.astro 1:1:
 *   §0. Page-title banner
 *   §1. Bio — 1/3 photo + 2/3 copy
 *   §2. Closing CTA
 *
 * Photo placeholder uses the same <iconify-icon icon="mdi:account">
 * glyph the team grid renders for members without a real headshot.
 * Swap to a real portrait once assets are supplied.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';

const heroBg = '/images/rrfps-about-cta-bg.jpg';
const ctaBg = '/images/meet-our-team-rrfps-cta-banner-bg.jpg';

const bioParagraphs = [
  'As Test & Inspect Division Manager for Red Rocks Fire Protection Services, Alicia Plescia oversees the day-to-day coordination and operations of the division, helping ensure inspections and service work are scheduled, communicated, and followed through from start to finish. She works closely with customers, technicians, and the RRFPS team to keep work organized and moving efficiently.',
  'With three years of experience in the fire protection and life safety industry, Alicia\u2019s expertise includes inspection and service scheduling, customer communication, inspection reporting and compliance submissions, deficiency tracking, return visits, workload management, and administrative support. She coordinates annual, five-year, and other required inspections, as well as regular and emergency service calls.',
  'At RRFPS, Alicia also helps manage customer and property communications involving scheduling, access requirements, resident notifications, and site preparation. In addition, she supports employee onboarding, training, and HR management while helping provide technicians with the organization, communication, and resources they need to be successful.',
  'Alicia values being part of RRFPS because of its emphasis on teamwork, communication, customer service, and continuous improvement. She especially appreciates the opportunity to grow with the company, take on new responsibilities, solve problems, and be someone both customers and team members can rely on.',
  'Outside of work, Alicia enjoys baking, antiquing and vintage shopping, spending time with family and friends, and getting outdoors with her dog, Bowie. She also loves cozy movie nights with her cat, Swayze, and supporting local theaters while helping keep the cinema experience alive.',
] as const;
---

<BaseLayout
  title="Alicia Plescia | Test & Inspect Division Manager, Red Rocks Fire Protection Services"
  description="Meet Alicia Plescia, Test & Inspect Division Manager at Red Rocks Fire Protection Services \u2014 scheduling, customer communication, inspection reporting, and HR support across Colorado."
>
  <div class="av-page ap-page">

    <header class="ptbanner">
      <div class="ptbanner__bg" style={`background-image: url('${heroBg}');`} aria-hidden="true"></div>
      <div class="ptbanner__overlay" aria-hidden="true"></div>
      <div class="ptbanner__inner">
        <h1 class="ptbanner__title">Alicia Plescia.</h1>
        <div class="ptbanner__breadcrumbs">
          <a href="/">Home</a>
          <span class="ptbanner__divider">-</span>
          <a href="/meet-the-team">Meet Our Team</a>
          <span class="ptbanner__divider">-</span>
          <span class="ptbanner__current">Alicia Plescia</span>
        </div>
      </div>
    </header>

    <section class="ap-bio" aria-label="Alicia Plescia bio">
      <div class="ap-bio__inner">

        <div class="ap-bio__photo" aria-hidden="true">
          <iconify-icon icon="mdi:account" width="160" height="160"></iconify-icon>
        </div>

        <div class="ap-bio__copy">
          <div class="ap-bio__name">Alicia Plescia</div>
          <div class="ap-bio__role">Test &amp; Inspect Division Manager | Red Rocks Fire Protection Services</div>
          <div class="ap-bio__rule" aria-hidden="true"></div>

          <div class="ap-bio__body">
            {bioParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>

      </div>
    </section>

    <ClosingCTA
      backgroundImage={ctaBg}
      paragraphs={[
        'Choosing the right life safety partner is about more than installing equipment and meeting code. It is about trusting the team you put in front of your residents, your tenants, and your inspectors \u2014 and knowing the people behind the truck have real accountability for the work they do.',
      ]}
    />

  </div>
</BaseLayout>

<style>
  .ptbanner { position: relative; isolation: isolate; background: #0d0d0b; overflow: hidden; }
  .ptbanner__bg { position: absolute; inset: 0; background-size: cover; background-position: center 32%; z-index: -2; }
  .ptbanner__overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(7, 7, 7, 0.46) 0%, rgba(7, 7, 7, 0.58) 100%); z-index: -1; }
  .ptbanner__inner { min-height: 448px; max-width: 1120px; margin-inline: auto; margin-bottom: 60px; padding: 136px 80px 36px; display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; }
  .ptbanner__title { margin: 0; max-width: 920px; color: #ffffff; font-family: "Space Grotesk", sans-serif; font-weight: 700; font-size: clamp(38px, 5.5vw, 75px); line-height: 0.9; letter-spacing: -0.055em; text-transform: uppercase; }
  .ptbanner__breadcrumbs { padding-bottom: 10px; color: #ffffff; font-family: "Space Grotesk", sans-serif; font-size: 15px; font-weight: 600; white-space: nowrap; }
  .ptbanner__breadcrumbs a { color: #ffffff; text-decoration: none; }
  .ptbanner__divider { margin-inline: 10px; }
  .ptbanner__current { text-decoration: underline; text-underline-offset: 4px; }

  .ap-bio { background: #ffffff; padding: 96px 80px 120px; }
  .ap-bio__inner { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); column-gap: 56px; row-gap: 48px; align-items: start; }
  .ap-bio__photo { position: relative; width: 100%; aspect-ratio: 1 / 1.1; overflow: hidden; background: #d6d6d6; color: #ffffff; display: grid; place-items: center; }
  .ap-bio__photo iconify-icon { color: currentColor; }
  .ap-bio__copy { display: flex; flex-direction: column; min-width: 0; }
  .ap-bio__name { color: #0a0a0a; font-family: "Space Grotesk", sans-serif; font-size: clamp(36px, 4vw, 56px); font-weight: 700; line-height: 1; letter-spacing: -0.04em; text-transform: uppercase; }
  .ap-bio__role { margin-top: 18px; color: #d41226; font-family: "Space Grotesk", sans-serif; font-size: clamp(15px, 1.1vw, 18px); font-weight: 600; line-height: 1.4; letter-spacing: 0.02em; }
  .ap-bio__rule { margin-top: 28px; width: 100%; height: 2px; background: #d41226; }
  .ap-bio__body { margin-top: 36px; color: #0a0a0a; font-family: "Space Grotesk", sans-serif; font-size: 17px; font-weight: 400; line-height: 1.6; }
  .ap-bio__body p + p { margin-top: 22px; }

  @media (max-width: 1100px) {
    .ptbanner__inner { min-height: 376px; padding-inline: 60px; }
    .ap-bio { padding: 80px 60px 96px; }
    .ap-bio__inner { column-gap: 40px; }
    .ap-bio__body { font-size: 16px; }
  }
  @media (max-width: 900px) {
    .ap-bio__inner { grid-template-columns: minmax(0, 1fr); row-gap: 36px; }
    .ap-bio__photo { aspect-ratio: 4 / 3; max-width: 520px; }
  }
  @media (max-width: 767px) {
    .ptbanner__inner { min-height: 312px; padding: 108px 28px 28px; flex-direction: column; align-items: flex-start; justify-content: flex-end; }
    .ptbanner__title { font-size: 54px; }
    .ptbanner__breadcrumbs { white-space: normal; }
    .ap-bio { padding: 64px 28px 80px; }
    .ap-bio__rule { margin-top: 24px; }
    .ap-bio__body { margin-top: 28px; font-size: 16px; }
    .ap-bio__body p + p { margin-top: 18px; }
  }
</style>
