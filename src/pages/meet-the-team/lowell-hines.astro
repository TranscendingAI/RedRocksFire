---
/**
 * Lowell Hines — /meet-the-team/lowell-hines/
 *
 * Individual bio page. Mirrors jeff-kakac.astro:
 *   §0. Page-title banner
 *   §1. Bio — 1/3 photo + 2/3 copy
 *   §2. Closing CTA
 *
 * Portrait uses the matching team-member headshot.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';

const heroBg = '/images/rrfps-about-cta-bg.jpg';
const ctaBg = '/images/meet-our-team-rrfps-cta-banner-bg.jpg';
const lowellPhoto = '/images/team-members/lowel-hines-red-rocks-fire-protection-services.png';

const bioParagraphs = [
  'Lowell is the Fire Alarm Lead Technician at RRFPS and is responsible for leading and overseeing the Fire Alarm Division. He has four years of experience in the fire protection industry and has developed a strong technical background and passion for fire alarm systems.',
  'His primary expertise is in fire alarm systems, including diagnosing, troubleshooting, repairing, testing, and inspecting systems to ensure they operate properly and reliably. Coming from an electrical background, Lowell has always enjoyed wiring, programming, and working with electrical systems, making the fire alarm industry a natural fit for his skills and interests.',
  'A major part of Lowell’s role at RRFPS is ensuring the Fire Alarm Division operates efficiently while helping the technicians on his team grow and develop. He believes becoming a great technician takes more than simply learning the technical side of the job. It requires teaching, coaching, hands-on experience, and investing time in each individual. Lowell takes pride in helping his team become more knowledgeable, confident, and capable technicians.',
  'Lowell joined RRFPS four years ago because he was looking for more than just a job—he wanted to build a career while having fun doing what he enjoys. Since joining the company, he has been fortunate to learn a tremendous amount and continues to grow both personally and professionally.',
  'Outside of work, Lowell enjoys spending time with his beautiful wife and kids, who are his biggest priority. When he gets the chance, he enjoys bowling, rollerblading, playing video games, and playing Magic: The Gathering. He believes in working hard, continuing to learn, and enjoying the journey along the way.',
] as const;
---

<BaseLayout
  title="Lowell Hines | Fire Alarm Lead Technician, Red Rocks Fire Protection Services"
  description="Meet Lowell Hines, Fire Alarm Lead Technician at Red Rocks Fire Protection Services, leading the Fire Alarm Division through testing, inspection, repair, and technician development."
>
  <div class="av-page lh-page">

    <header class="ptbanner">
      <div class="ptbanner__bg" style={`background-image: url('${heroBg}');`} aria-hidden="true"></div>
      <div class="ptbanner__overlay" aria-hidden="true"></div>
      <div class="ptbanner__inner">
        <h1 class="ptbanner__title">Lowell Hines.</h1>
        <div class="ptbanner__breadcrumbs">
          <a href="/">Home</a>
          <span class="ptbanner__divider">-</span>
          <a href="/meet-the-team">Meet Our Team</a>
          <span class="ptbanner__divider">-</span>
          <span class="ptbanner__current">Lowell Hines</span>
        </div>
      </div>
    </header>

    <section class="lh-bio" aria-label="Lowell Hines bio">
      <div class="lh-bio__inner">

        <div class="lh-bio__photo">
          <img src={lowellPhoto} alt="Lowell Hines, Fire Alarm Lead Technician of Red Rocks Fire Protection Services" loading="eager" decoding="async" />
        </div>

        <div class="lh-bio__copy">
          <div class="lh-bio__name">Lowell Hines</div>
          <div class="lh-bio__role">Fire Alarm Lead Technician | Red Rocks Fire Protection Services</div>
          <div class="lh-bio__rule" aria-hidden="true"></div>

          <div class="lh-bio__body">
            {bioParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>

      </div>
    </section>

    <ClosingCTA
      backgroundImage={ctaBg}
      paragraphs={[
        'Choosing the right life safety partner is about more than installing equipment and meeting code. It is about trusting the team you put in front of your residents, your tenants, and your inspectors — and knowing the people behind the truck have real accountability for the work they do.',
      ]}
    />

  </div>
</BaseLayout>

<style>
  .ptbanner { position: relative; isolation: isolate; background: #0d0d0b; overflow: hidden; }
  .ptbanner__bg { position: absolute; inset: 0; background-size: cover; background-position: center 32%; z-index: -2; }
  .ptbanner__overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(7, 7, 7, 0.46) 0%, rgba(7, 7, 7, 0.58) 100%); z-index: -1; }
  .ptbanner__inner { min-height: 448px; max-width: 1120px; margin-inline: auto; margin-bottom: 60px; padding: 136px 80px 36px; display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; }
  .ptbanner__title { margin: 0; max-width: 920px; color: #ffffff; font-family: "Space Grotesk", sans-serif; font-weight: 700; font-size: clamp(38px, 5.5vw, 75px); line-height: 0.9; letter-spacing: -0.055em; text-transform: uppercase; }
  .ptbanner__breadcrumbs { padding-bottom: 10px; color: #ffffff; font-family: "Space Grotesk", sans-serif; font-size: 15px; font-weight: 600; white-space: nowrap; }
  .ptbanner__breadcrumbs a { color: #ffffff; text-decoration: none; }
  .ptbanner__divider { margin-inline: 10px; }
  .ptbanner__current { text-decoration: underline; text-underline-offset: 4px; }

  .lh-bio { background: #ffffff; padding: 96px 80px 120px; }
  .lh-bio__inner { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); column-gap: 56px; row-gap: 48px; align-items: start; }
  .lh-bio__photo { position: relative; width: 100%; aspect-ratio: 1 / 1.1; overflow: hidden; background: #d6d6d6; }
  .lh-bio__photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .lh-bio__copy { display: flex; flex-direction: column; min-width: 0; }
  .lh-bio__name { color: #0a0a0a; font-family: "Space Grotesk", sans-serif; font-size: clamp(36px, 4vw, 56px); font-weight: 700; line-height: 1; letter-spacing: -0.04em; text-transform: uppercase; }
  .lh-bio__role { margin-top: 18px; color: #d41226; font-family: "Space Grotesk", sans-serif; font-size: clamp(15px, 1.1vw, 18px); font-weight: 600; line-height: 1.4; letter-spacing: 0.02em; }
  .lh-bio__rule { margin-top: 28px; width: 100%; height: 2px; background: #d41226; }
  .lh-bio__body { margin-top: 36px; color: #0a0a0a; font-family: "Space Grotesk", sans-serif; font-size: 17px; font-weight: 400; line-height: 1.6; }
  .lh-bio__body p + p { margin-top: 22px; }

  @media (max-width: 1100px) {
    .ptbanner__inner { min-height: 376px; padding-inline: 60px; }
    .lh-bio { padding: 80px 60px 96px; }
    .lh-bio__inner { column-gap: 40px; }
    .lh-bio__body { font-size: 16px; }
  }
  @media (max-width: 900px) {
    .lh-bio__inner { grid-template-columns: minmax(0, 1fr); row-gap: 36px; }
    .lh-bio__photo { aspect-ratio: 4 / 3; max-width: 520px; }
  }
  @media (max-width: 767px) {
    .ptbanner__inner { min-height: 312px; padding: 108px 28px 28px; flex-direction: column; align-items: flex-start; justify-content: flex-end; }
    .ptbanner__title { font-size: 54px; }
    .ptbanner__breadcrumbs { white-space: normal; }
    .lh-bio { padding: 64px 28px 80px; }
    .lh-bio__rule { margin-top: 24px; }
    .lh-bio__body { margin-top: 28px; font-size: 16px; }
    .lh-bio__body p + p { margin-top: 18px; }
  }
</style>
