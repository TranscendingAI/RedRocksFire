---
/**
 * Inspections — RRFPS landing page for /services/inspections.
 *
 * Sections, in order (style alternation so no two adjacent sections look alike):
 *   §0. ptbanner                                   — full-bleed dark hero
 *   §1. 2×2 ibox solutions grid                    — Annual / 3-Year / 5-Year / Special Hazard
 *   §2. ins-whyrr (tan bg-image band)              — intro + 3 trust bullets
 *   §3. ins-3yr (dark accordion)                   — 3-Year Inspection & Testing Services
 *   §4. ins-5yr (white SplitPanel)                 — 5-Year Fire Sprinkler Inspection & Testing
 *   §5. ins-purpose (full-bleed bg + red badge)    — One Company to Manage Your Inspection Requirements
 *   §6. ins-tracking (white icon-grid)             — Inspection & Compliance Tracking (10 cards)
 *   §7. ins-whychoose (light SplitPanel)           — Why Choose Red Rocks Fire Protection? (10)
 *   §8. ins-howwework (white SplitPanel)           — How We Work / More Than an Inspection Company.
 *   §9. ins-edge (#DBDADA SplitPanel)              — Our Edge / Advocacy That Helps You Stay Ahead
 *  §10. ins-why (dark bg + 5 value cards)          — Why Clients Stay (brand promise values)
 *  §11. ins-experience (white SplitPanel)          — Experience / Inspection & Compliance Experience You Can Trust
 *  §12. ins-promise (#DBDADA SplitPanel)           — Our Promise / Ready for Today's Inspection
 *  §13. ClosingCTA                                 — phone + "Let's Protect What Matters Most Together."
 *
 * CSS namespace: .ins-* (avoids collisions with industry.astro's `.sol/.ibox`,
 * about.astro's `.purpose/.facts/.capabilities/.difference`, and the
 * kitchen-hood page's `.kh-*`).
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';

const arrowPath = 'M0 6.78247C0 6.52555 0.102065 6.27914 0.283741 6.09746C0.465416 5.91579 0.711822 5.81372 0.96875 5.81372H12.1927L8.03288 1.65585C7.85097 1.47394 7.74878 1.22723 7.74878 0.969974C7.74878 0.712721 7.85097 0.466004 8.03288 0.284099C8.21478 0.102194 8.4615 0 8.71875 0C8.976 0 9.22272 0.102194 9.40463 0.284099L15.2171 6.0966C15.3073 6.18659 15.3789 6.29349 15.4278 6.41118C15.4766 6.52888 15.5017 6.65505 15.5017 6.78247C15.5017 6.9099 15.4766 7.03607 15.4278 7.15376C15.3789 7.27146 15.3073 7.37836 15.2171 7.46835L9.40463 13.2808C9.22272 13.4628 8.976 13.5649 8.71875 13.5649C8.4615 13.5649 8.21478 13.4628 8.03288 13.2808C7.85097 13.0989 7.74878 12.8522 7.74878 12.595C7.74878 12.3377 7.85097 12.091 8.03288 11.9091L12.1927 7.75122H0.96875C0.711822 7.75122 0.465416 7.64916 0.283741 7.46748C0.102065 7.28581 0 7.0394 0 6.78247Z';

const diamondIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="20" viewBox="0 0 15 20"><path d="M0.660472 19.6191L0.47542 6.53585L13.7437 19.8041L0.660472 19.6191Z"></path><path d="M14.3396 0.939992L14.5246 14.0232L1.25635 0.754941L14.3396 0.939992Z"></path></svg>';

const bannerImage = '/images/red-rocks-fire-protection-inspection-hero.jpg';
const introImage = '/images/red-rocks-fire-protection-why-inspections.jpg';

/* §1 — 2×2 ibox grid: cadence-based categories from the new MD */
const categories = [
  {
    title: 'Annual NFPA Inspections.',
    icon: 'mdi:clipboard-text-search-outline',
    body:
      'By code, fire-protection systems must be inspected annually. We evaluate every component against the current NFPA standard for that system, capture findings in a detailed written report, and hand you a correction summary your AHJ will accept.',
  },
  {
    title: '3-Year Inspection Services.',
    icon: 'mdi:calendar-clock-outline',
    body:
      'Certain fire protection system components require testing or maintenance at intervals beyond the standard annual inspection. We review each property to identify applicable 3-year requirements and coordinate the required work.',
  },
  {
    title: '5-Year Sprinkler Testing.',
    icon: 'mdi:wrench-outline',
    body:
      'Internal inspections of sprinkler piping, check valves, alarm valves, and dry pipe valves — plus standpipe testing, hydrostatic testing, obstruction investigation, and gauge replacement — performed to NFPA 25.',
  },
  {
    title: 'Special Hazard & Suppression.',
    icon: 'mdi:fire-extinguisher',
    body:
      'Kitchen hood suppression, clean-agent systems, BDA/DAS radio coverage, area-of-refuge communications, and backflow prevention — each with its own cadence and inspection checklist, all in one report.',
  },
] as const;

/* §3 — 3-Year accordion panel (1 panel: the 3-year overview + services + AHJ note) */
const threeYearPanel = {
  title: '3-Year Inspection & Testing Services.',
  body:
    'Certain fire protection system components require testing or maintenance at intervals beyond the standard annual inspection. Depending on the system, equipment, adopted code edition, and local jurisdiction, 3-year requirements may apply. Red Rocks Fire can review your property’s existing systems and inspection history to identify applicable 3-year requirements and coordinate the required work.',
  bullets: [
    'Dry sprinkler system air/gas leakage testing.',
    'Full-flow testing of pressure-reducing and pressure-regulating devices where applicable.',
    'Additional system-specific testing required by the adopted NFPA standards.',
    'Documentation and deficiency reporting.',
    'Coordination of required repairs.',
  ],
  footer:
    'Because requirements vary by system and jurisdiction, our team reviews each property individually rather than applying a one-size-fits-all testing schedule.',
  open: true,
};

/* §6 — Inspection & Compliance Tracking (11 cards, Iconify icons) */
const trackingItems = [
  { icon: 'mdi:calendar-check-outline',            title: 'Annual inspection scheduling.',       body: 'Coordinate recurring annual inspections across all installed fire and life safety systems.' },
  { icon: 'mdi:calendar-month-outline',            title: 'Quarterly & semi-annual requirements.', body: 'Track and complete quarterly and semi-annual requirements so nothing slips through the calendar.' },
  { icon: 'mdi:calendar-clock-outline',            title: '3-year testing requirements.',         body: 'Identify upcoming 3-year inspections and schedule them before they become overdue.' },
  { icon: 'mdi:calendar-refresh-outline',          title: '5-year testing requirements.',         body: 'Plan and coordinate 5-year sprinkler and standpipe testing well in advance of the due date.' },
  { icon: 'mdi:spray-bottle',                      title: 'Sprinkler head testing requirements.', body: 'Monitor and manage sprinkler head testing requirements over the long-term service life.' },
  { icon: 'mdi:fire-hydrant',                      title: 'Fire pump testing.',                   body: 'Schedule and document annual and periodic fire pump testing to NFPA 25.' },
  { icon: 'mdi:pipe-valve',                        title: 'Backflow certification.',             body: 'Manage backflow preventer testing and certification with proper documentation.' },
  { icon: 'mdi:alert-decagram-outline',            title: 'Deficiency tracking.',                 body: 'Track open deficiencies across properties and inspections to closure.' },
  { icon: 'mdi:wrench-clock',                      title: 'Repair recommendations.',             body: 'Provide clear repair recommendations with priorities and timelines for every deficiency.' },
  { icon: 'mdi:finance',                           title: 'Long-term capital planning.',          body: 'Help plan for replacement and capital needs based on system age and inspection history.' },
  { icon: 'mdi:office-building-cog-outline',       title: 'Multi-property coordination.',         body: 'Coordinate inspections across multiple properties through one life safety provider.' },
] as const;

/* §7 — Why Choose Red Rocks? (10 cards, Iconify icons) */
const whyChooseItems = [
  { icon: 'mdi:shield-check-outline',           title: 'One Vendor Life Safety Solution.',                 body: 'Sprinklers, alarms, monitoring, suppression, backflow, and consulting all under one roof.' },
  { icon: 'mdi:home-heart',                     title: 'Locally Owned & Family Operated Since 2010.',      body: 'A trusted, family-owned life safety company serving Colorado for over a decade.' },
  { icon: 'mdi:medal-outline',                  title: 'NICET-Certified Technicians.',                     body: 'Inspections performed by NICET- or CSA-certified technicians against current adopted standards.' },
  { icon: 'mdi:cog-outline',                    title: 'Multi-System Expertise.',                          body: 'Fire alarm, sprinkler, backflow, extinguisher, BDA, and communication system expertise in one team.' },
  { icon: 'mdi:calendar-check-outline',         title: 'Annual, 3-Year & 5-Year Testing Programs.',        body: 'Coordinated recurring inspection and testing programs aligned to your installed systems.' },
  { icon: 'mdi:file-document-outline',          title: 'Detailed Inspection & Deficiency Reporting.',      body: 'Reports your AHJ, lender, and insurer will accept — with correction summaries, not just checkboxes.' },
  { icon: 'mdi:office-building-outline',        title: 'Multi-Property & Portfolio Management.',           body: 'Coordinated inspection schedules, reporting, deficiencies, and future testing across a portfolio.' },
  { icon: 'mdi:clock-alert-outline',            title: '24-Hour Emergency Service.',                       body: 'Responsive emergency service when something unexpected happens on site.' },
  { icon: 'mdi:map-marker-outline',             title: 'Serving Colorado.',                                body: 'Commercial and multifamily properties throughout the Colorado Front Range.' },
  { icon: 'mdi:account-check-outline',          title: 'One Point of Contact.',                            body: 'One provider. One point of contact. One comprehensive approach to compliance.' },
] as const;

/* §10 — Why Clients Stay (5 brand-promise values with icons) */
const whyClientsIcons = [
  'solar:shield-check-bold-duotone',
  'solar:hand-heart-bold-duotone',
  'solar:rocket-2-bold-duotone',
  'solar:medal-ribbon-star-bold-duotone',
  'solar:users-group-rounded-bold-duotone',
] as const;

const whyClientsValues = [
  { title: 'We lead with safety.',          body: 'Protecting lives and property is both our responsibility and our privilege.' },
  { title: 'We advocate for our clients.',  body: 'We stay ahead of changing codes and help simplify compliance.' },
  { title: 'We go the extra mile.',         body: 'We take ownership of every project until the job is completed correctly.' },
  { title: 'We demonstrate character.',     body: 'Integrity, professionalism, accountability, and respect guide every interaction.' },
  { title: 'And we operate as one family.', body: 'We support one another while building lasting partnerships with every client we serve.' },
] as const;
---

<BaseLayout
  title="Fire Safety Inspections Denver | NFPA Reports | Red Rocks Fire Protection"
  description="Annual, 3-year, and 5-year NFPA fire safety inspections across Colorado — sprinklers, alarms, extinguishers, backflow, suppression. Detailed written reports. Codes, legislations, and jurisdictional navigation handled."
>
  <div class="av-page">

    <!-- ═══════════════════════════════════════════════════════
         §0. PAGE-TITLE BANNER
         ═══════════════════════════════════════════════════════ -->
    <div class="ptbanner">
      <div class="ptbanner__bg" style={`background-image: url('${bannerImage}');`} aria-hidden="true"></div>
      <div class="ptbanner__overlay" aria-hidden="true"></div>
      <div class="ptbanner__inner">
        <h1 class="ptbanner__title rr-reveal">Inspections</h1>
        <div class="ptbanner__breadcrumbs rr-reveal" data-reveal-delay="100">
          <a href="/">Home</a>
          <span class="ptbanner__divider">-</span>
          <span class="ptbanner__current">FIRE PROTECTION INSPECTIONS</span>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         §1. SOLUTIONS GRID — 2×2 ibox (cadence-based)
         ═══════════════════════════════════════════════════════ -->
    <section class="sol">
      <div class="sol__left">
        <div class="sol__sticky">
          <div class="av-dblh__subtitle rr-reveal">
            <span class="divider-icon" set:html={diamondIcon} />
            <span>What an Inspection Covers</span>
          </div>
          <h2 class="sol__title rr-reveal" data-reveal-delay="100">
            <span>Annual,</span>
            <span>3-Year &amp;</span>
            <span>5-Year Testing.</span>
          </h2>
          <div class="sol__spacer" aria-hidden="true"></div>
          <div class="sol__cta rr-reveal" data-reveal-delay="200">
            <a href="/contact" class="av-wgl-btn av-wgl-btn--outline">
              <span class="av-wgl-btn__text">schedule a walk-through</span>
              <span class="av-wgl-btn__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg>
              </span>
            </a>
          </div>
        </div>
      </div>

      <div class="sol__grid">
        {categories.map((c, i) => (
          <a href="/contact" class="ibox rr-reveal" data-icon-slot={i} data-reveal-delay={i * 100}>
            <span class="ibox__bg" aria-hidden="true"></span>
            <span class="ibox__icon" aria-hidden="true">
              <iconify-icon icon={c.icon} width="50" height="50"></iconify-icon>
            </span>
            <span class="ibox__content">
              <h3 class="ibox__title">{c.title}</h3>
              <span class="ibox__text">{c.body}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         §2. WHY INSPECTIONS — tan bg-image band (intro + 3 trust bullets)
         ═══════════════════════════════════════════════════════ -->
    <section class="ins-whyrr rr-band rr-band--reveal-top">
      <div class="ins-whyrr__bg" style={`background-image: url('${introImage}');`} aria-hidden="true"></div>
      <div class="ins-whyrr__overlay" aria-hidden="true"></div>
      <div class="rr-container ins-container">
        <div class="ins-why-grid">
          <div class="ins-why-grid__left">
            <p class="rr-eyebrow ins-whyrr__eyebrow mb-5 rr-reveal">Why Inspections</p>
            <h2
              class="font-display font-black tracking-tight ins-whyrr__title rr-reveal"
              data-reveal-delay="100"
              style="font-size: clamp(36px, 5vw, 56px); line-height: 1; letter-spacing: -0.04em;"
            >
              <span class="ins-whyrr__title-black">Annual, 3-Year</span><br />
              <span class="ins-whyrr__title-black">&amp; 5-Year</span><br />
              <span class="ins-whyrr__title-red">Compliance,</span><br />
              <span class="ins-whyrr__title-red">Handled.</span>
            </h2>
          </div>

          <div class="ins-why-grid__right">
            <p class="ins-whyrr__body rr-reveal" data-reveal-delay="200" style="font-size: var(--rr-text-lead); line-height: var(--rr-text-lead-lh); margin-top: 0;">
              Red Rocks Fire Protection provides comprehensive inspection and testing services to help commercial and multifamily properties maintain compliant, reliable fire and life safety systems. Our team can manage recurring inspection requirements — from annual testing to longer-term 3-year and 5-year requirements — helping property managers and building owners stay ahead of upcoming compliance needs.
            </p>
            <p class="ins-whyrr__body rr-reveal" data-reveal-delay="300" style="font-size: var(--rr-text-lead); line-height: var(--rr-text-lead-lh); margin-top: 1.25rem;">
              Since 2010, our family-owned company has served customers throughout Colorado. For inspections, that means helping property owners and managers understand not only what needs to be inspected today, but what requirements are coming next.
            </p>

            <ul class="ins-whyrr__bullets rr-reveal" data-reveal-delay="400">
              <li class="ins-whyrr__bullet">
                <span class="ins-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon="solar:shield-check-bold-duotone" width="20" height="20"></iconify-icon>
                </span>
                <span>Comprehensive inspection and testing capabilities across multiple fire and life safety systems.</span>
              </li>
              <li class="ins-whyrr__bullet">
                <span class="ins-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon="solar:calendar-mark-bold-duotone" width="20" height="20"></iconify-icon>
                </span>
                <span>Annual, quarterly, semi-annual, 3-year, and 5-year inspection and testing coordination based on the systems installed.</span>
              </li>
              <li class="ins-whyrr__bullet">
                <span class="ins-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon="solar:document-text-bold-duotone" width="20" height="20"></iconify-icon>
                </span>
                <span>Detailed inspection documentation, deficiency reporting, repair recommendations, and compliance tracking.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         §3. ANNUAL + 3-YEAR ACCORDION — dark bg-image accordion
         ═══════════════════════════════════════════════════════ -->
    <section class="ins-acc">
      <div class="ins-acc__bg" aria-hidden="true"></div>
      <div class="ins-acc__overlay" aria-hidden="true"></div>
      <div class="ins-acc__inner ins-container">
        <div class="ins-acc__head">
          <p class="av-dblh__subtitle ins-acc__eyebrow rr-reveal">
            <span class="ins-acc__rule" aria-hidden="true"></span>
            <span>How We Inspect</span>
            <span class="ins-acc__rule" aria-hidden="true"></span>
          </p>
          <h3 class="ins-acc__title rr-reveal" data-reveal-delay="100">Our Inspection Programs.</h3>
          <p class="ins-acc__intro rr-reveal" data-reveal-delay="200">
            Inspection and testing frequencies can vary based on the installed system, adopted code edition, manufacturer requirements, and the Authority Having Jurisdiction (AHJ). Red Rocks Fire Protection reviews each property to determine applicable requirements.
          </p>
        </div>

        <div class="acc ins-acc__list">
          <div class:list={['acc__panel', 'acc__panel--card', 'rr-reveal', threeYearPanel.open && 'is-active']} data-acc-panel>
            <button type="button" class="acc__header" aria-expanded={threeYearPanel.open ? 'true' : 'false'}>
              <span class="acc__panel-icon" aria-hidden="true">
                <iconify-icon icon="mdi:calendar-clock-outline" width="22" height="22"></iconify-icon>
              </span>
              <span class="acc__title">{threeYearPanel.title}</span>
              <span class="acc__caret" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor"><path d={arrowPath}></path></svg>
              </span>
            </button>
            <div class="acc__content" hidden={!threeYearPanel.open}>
              <p>{threeYearPanel.body}</p>
              <ul class="acc__bullets">
                {threeYearPanel.bullets.map((b) => (
                  <li class="acc__bullet">
                    <span class="acc__bullet-mark" aria-hidden="true">▸</span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
              <p class="acc__footer">{threeYearPanel.footer}</p>
            </div>
          </div>

          <!-- Annual cadence panel (companion to the 3-year one above) -->
          <div class:list={['acc__panel', 'acc__panel--card', 'rr-reveal']} data-acc-panel>
            <button type="button" class="acc__header" aria-expanded="false">
              <span class="acc__panel-icon" aria-hidden="true">
                <iconify-icon icon="mdi:clipboard-text-search-outline" width="22" height="22"></iconify-icon>
              </span>
              <span class="acc__title">Annual Fire &amp; Life Safety Inspections.</span>
              <span class="acc__caret" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor"><path d={arrowPath}></path></svg>
              </span>
            </button>
            <div class="acc__content" hidden>
              <p>We provide annual inspection and testing services for every major fire and life safety system in your building. Following inspections, Red Rocks Fire provides detailed documentation identifying deficiencies, recommended corrective actions, and upcoming testing or maintenance requirements.</p>
              <ul class="acc__bullets">
                <li class="acc__bullet"><span class="acc__bullet-mark" aria-hidden="true">▸</span><span>Fire sprinkler systems</span></li>
                <li class="acc__bullet"><span class="acc__bullet-mark" aria-hidden="true">▸</span><span>Fire alarm systems</span></li>
                <li class="acc__bullet"><span class="acc__bullet-mark" aria-hidden="true">▸</span><span>Fire extinguishers</span></li>
                <li class="acc__bullet"><span class="acc__bullet-mark" aria-hidden="true">▸</span><span>Fire pumps</span></li>
                <li class="acc__bullet"><span class="acc__bullet-mark" aria-hidden="true">▸</span><span>Backflow prevention assemblies</span></li>
                <li class="acc__bullet"><span class="acc__bullet-mark" aria-hidden="true">▸</span><span>ERRCS / BDA systems</span></li>
                <li class="acc__bullet"><span class="acc__bullet-mark" aria-hidden="true">▸</span><span>Area of Refuge communication systems</span></li>
                <li class="acc__bullet"><span class="acc__bullet-mark" aria-hidden="true">▸</span><span>Elevator emergency communication systems</span></li>
                <li class="acc__bullet"><span class="acc__bullet-mark" aria-hidden="true">▸</span><span>Kitchen hood suppression systems</span></li>
                <li class="acc__bullet"><span class="acc__bullet-mark" aria-hidden="true">▸</span><span>Other applicable fire and life safety equipment</span></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         §4. 5-YEAR SPRINKLER TESTING — white SplitPanel, image right
         ═══════════════════════════════════════════════════════ -->
    <section class="ins-splitpanel bg-rr-white rr-band rr-band--reveal-top">
      <div class="rr-container ins-container">
        <div class="grid gap-10 md:gap-12 lg:gap-16 items-center md:grid-cols-2">
          <div class="order-2 md:order-1">
            <p class="rr-eyebrow mb-5 text-rr-grey rr-reveal">5-Year Testing</p>
            <h2 class="font-display font-black uppercase tracking-tight rr-reveal" data-reveal-delay="100" style="font-size: var(--rr-text-section); line-height: 0.95;">
              5-Year Fire Sprinkler Inspection &amp; Testing.
            </h2>
            <div class="mt-6 rr-reveal ins-split-body" data-reveal-delay="200">
              <p>Five-year testing is an important part of maintaining fire sprinkler and standpipe systems. These inspections go beyond the standard annual inspection and help identify internal deterioration, obstructions, valve issues, and other conditions that may not be visible during routine testing.</p>
              <p>Our 5-year services include internal inspection of sprinkler piping, check valves, alarm valves, and dry pipe valves; obstruction investigation where required; standpipe, FDC, and hydrostatic testing; pressure-reducing valve testing; gauge replacement or calibration; and detailed deficiency documentation with corrective-action recommendations.</p>
            </div>
          </div>
          <div class="order-1 md:order-2 rr-reveal" data-reveal-delay="300">
            <div class="overflow-hidden rounded-rr-card aspect-[4/3] bg-rr-bg-panel">
              <img
                src="/images/red-rocks-fire-protections-fire-sprinkler-multi-family-units.jpg"
                alt="Red Rocks Fire Protection performing 5-year fire sprinkler internal inspection"
                loading="lazy" decoding="async"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         §5. ONE COMPANY TO MANAGE — full-bleed bg image + red badge
         ═══════════════════════════════════════════════════════ -->
    <section class="ins-purpose">
      <div class="ins-purpose__wrap">
        <div class="ins-purpose__stage">
          <div
            class="ins-purpose__stage-bg"
            style="background-image: url('/images/red-rocks-fire-protection-one-calendar.jpg');"
            aria-hidden="true"
          ></div>
          <div class="ins-purpose__stage-overlay" aria-hidden="true"></div>

          <div class="ins-purpose__badge">
            <strong>One Vendor.</strong>
            <strong>Total Life</strong>
            <strong>Safety.</strong>
          </div>
        </div>

        <div class="ins-purpose__content-row">
          <h2 class="ins-purpose__title rr-reveal">One Vendor for Complete<br />Fire &amp; Life Safety</h2>
          <div class="ins-purpose__copy rr-reveal" data-reveal-delay="100">
            <p>Managing multiple fire and life safety systems can become complicated, especially when annual, semi-annual, quarterly, 3-year, and 5-year requirements fall on different schedules.</p>
            <p>Red Rocks Fire Protection helps simplify the process by providing a One Vendor Life Safety Solution — identifying what systems are installed at each property, determining upcoming inspection and testing requirements, and coordinating the work through a single fire protection provider.</p>
            <p><strong>One provider. One point of contact. One comprehensive approach to your property’s fire and life safety compliance.</strong></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         §6. INSPECTION & COMPLIANCE TRACKING — gray icon-grid (10 cards)
         ═══════════════════════════════════════════════════════ -->
    <section class="ins-tracking">
      <div class="section-inner">
        <div class="ins-tracking__head">
          <div class="av-dblh__subtitle section-eyebrow rr-reveal">
            <span class="divider-icon" set:html={diamondIcon} />
            <span>Compliance Tracking</span>
          </div>
          <h2 class="section-title rr-reveal" data-reveal-delay="100" style="color: #0a0a0a;">
            Inspection &amp; Compliance Tracking.
          </h2>
          <p class="ins-tracking__intro rr-reveal" data-reveal-delay="200">
