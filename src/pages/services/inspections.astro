  .ibox:hover .ibox__icon :global(svg) { fill: #0a0a0a; }
  .ibox__content { display: flex; flex-direction: column; min-height: 306px; padding: 51px 40px 30px 40px; }
  .ibox__title { margin: 0; font-family: "Space Grotesk", sans-serif; font-size: clamp(26px, 1.9vw, 30px); font-weight: 700; text-transform: uppercase; line-height: 1.4em; color: #0a0a0a; transition: 0.4s; }
