  .ins-acc__intro { margin: 0 auto; max-width: 700px; font-size: var(--rr-text-lead); line-height: var(--rr-text-lead-lh); color: #ffffff; }
  .ins-acc__list { max-width: 800px; margin-inline: auto; }

  /* Accordion panel — shared across the page */
