  .sol__grid { width: 50%; margin-top: 8px; display: flex; flex-wrap: wrap; row-gap: 30px; }
  .sol__grid .ibox { width: 50%; }

  .ibox { position: relative; display: block; text-decoration: none; transition: 0.4s; }
  .ibox__bg { position: absolute; inset: 0; border: 1px solid #0a0a0a26; transition: 0.4s; pointer-events: none; }
  .ibox:hover { background-color: #D51126; }
