   * ============================================================ */
  .ins-whyrr { position: relative; isolation: isolate; overflow: hidden; background-color: #E0D9D3; }
  .ins-whyrr__bg { position: absolute; inset: 0; background-size: cover; background-position: center; z-index: -2; }
  .ins-whyrr__overlay { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(224, 217, 211, 0.30) 0%, rgba(224, 217, 211, 0.55) 25%, rgba(224, 217, 211, 0.85) 50%, #E0D9D3 75%, #E0D9D3 100%); z-index: -1; }
  .ins-whyrr__eyebrow { color: var(--rr-red, #d41226); }
