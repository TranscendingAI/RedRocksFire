   * ============================================================ */
  .ptbanner { position: relative; isolation: isolate; background-color: #0d0d0b; }
  .ptbanner__bg { position: absolute; inset: 0; background-size: cover; background-repeat: no-repeat; background-position: center bottom; z-index: -2; }
  .ptbanner__overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(13, 13, 11, 0.35) 0%, rgba(13, 13, 11, 0.45) 60%, rgba(13, 13, 11, 0.55) 100%); z-index: -1; }
  .ptbanner__inner { width: 100%; max-width: 1200px; margin-inline: auto; padding-inline: 15px; min-height: 450px; margin-bottom: 60px; padding-top: 154px; padding-bottom: 20px; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; column-gap: 32px; }
  .ptbanner__title { margin: 0; color: #ffffff; font-family: "Space Grotesk", sans-serif; font-weight: 700; font-size: clamp(38px, 5.5vw, 75px); line-height: 104px; letter-spacing: -0.05em; text-transform: uppercase; }
  .ptbanner__breadcrumbs { color: #ffffff; font-family: "Space Grotesk", sans-serif; font-weight: 500; font-size: 16px; line-height: 30px; letter-spacing: -0.04em; padding-bottom: 14px; }
  .ptbanner__breadcrumbs a { color: #ffffff; text-decoration: none; transition: 0.4s; }
  .ptbanner__breadcrumbs a:hover { color: #ffffff99; }
  .ptbanner__divider { margin: 0 10px; }
  .ptbanner__current { text-decoration: underline; text-underline-offset: 4px; }

  /* ============================================================
   * §1. sol (2×2 ibox grid) — copy of industry.astro/.sol + .ibox
   * ============================================================ */
  .sol { display: flex; max-width: 1600px; margin: 0 auto 80px; }
  .sol__left { width: 50%; }
  .sol__sticky { position: sticky; top: 120px; display: flex; flex-direction: column; align-items: flex-end; padding-right: 0; }
  .sol__sticky > * { width: 100%; max-width: 585px; }
