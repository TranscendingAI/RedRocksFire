---
/**
 * Security System Installation & Monitoring — RRFPS landing page
 * for /services/security-system-installation-and-monitoring/.
 *
 * Layout cloned 1:1 from fire-sprinkler-service-and-systems.astro
 * (per Zack's direction) with the copy swapped verbatim from
 * reference/content/rrfps-9-service-pages-with-why-red-rocks-sections.md
 * (Page 5 — Security System Installation & Monitoring).
 *
 * Sections, in order:
 *   0. ptbanner
 *   1. 2×2 ibox grid (4 security service categories)
 *   2. `ss-whyrr` tan bg-image intro band
 *   3. 3-panel accordion (Installation / Service & Repair /
 *      Monitoring — the .md H2s)
 *   4. SplitPanel — More Than a Service Contractor
 *   5. SplitPanel — Advocacy (#DBDADA bg)
 *   6. Why Clients Stay — dark bg + 5 value cards
 *   7. SplitPanel — Experience (white bg)
 *   8. SplitPanel — Ready When You Are. (#DBDADA bg)
 *   9. IndustriesGrid (shared)
 *  10. ClosingCTA (shared, security-themed paragraph)
 *
 * Image assets — all placeholders, to be swapped for page-specific
 * Nano Banana imagery after the batch build:
 *   • Hero           — /images/rrfps-fire-sprinkler-systems-hero.jpg
 *   • §2 tan band bg — /images/red-rocks-fire-alarm-why-bg.jpg
 *   • §3 accordion bg — /images/red-rocks-fire-alarm-accordion-bg.jpg
 *   • §4 more than    — /images/rrfps-fa-more-than-contractor.jpg
 *   • §5 advocacy     — /images/rrfps-fa-advocacy.jpg
 *   • §6 values bg    — /images/rrfps-fa-why-clients-stay-bg.jpg
 *   • §7 experience   — /images/rrfps-fa-experience.jpg
 *   • §8 promise      — /images/rrfps-fa-promise.jpg
 *   • ClosingCTA bg   — /images/rrfps-services-cta-bg.png
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import IndustriesGrid from '../../components/IndustriesGrid.astro';

const arrowPath = 'M0 6.78247C0 6.52555 0.102065 6.27914 0.283741 6.09746C0.465416 5.91579 0.711822 5.81372 0.96875 5.81372H12.1927L8.03288 1.65585C7.85097 1.47394 7.74878 1.22723 7.74878 0.969974C7.74878 0.712721 7.85097 0.466004 8.03288 0.284099C8.21478 0.102194 8.4615 0 8.71875 0C8.976 0 9.22272 0.102194 9.40463 0.284099L15.2171 6.0966C15.3073 6.18659 15.3789 6.29349 15.4278 6.41118C15.4766 6.52888 15.5017 6.65505 15.5017 6.78247C15.5017 6.9099 15.4766 7.03607 15.4278 7.15376C15.3789 7.27146 15.3073 7.37836 15.2171 7.46835L9.40463 13.2808C9.22272 13.4628 8.976 13.5649 8.71875 13.5649C8.4615 13.5649 8.21478 13.4628 8.03288 13.2808C7.85097 13.0989 7.74878 12.8522 7.74878 12.595C7.74878 12.3377 7.85097 12.091 8.03288 11.9091L12.1927 7.75122H0.96875C0.711822 7.75122 0.465416 7.64916 0.283741 7.46748C0.102065 7.28581 0 7.0394 0 6.78247Z';

const diamondIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="20" viewBox="0 0 15 20"><path d="M0.660472 19.6191L0.47542 6.53585L13.7437 19.8041L0.660472 19.6191Z"></path><path d="M14.3396 0.939992L14.5246 14.0232L1.25635 0.754941L14.3396 0.939992Z"></path></svg>';

const bannerImage = '/images/rrfps-fire-sprinkler-systems-hero.jpg';

const categories = [
  {
    title: 'Installation.',
    icon: 'mdi:shield-lock-outline',
    body: 'Professional security system installation services for commercial buildings, multifamily communities, offices, warehouses, retail spaces, and maintenance facilities throughout Colorado.',
  },
  {
    title: 'Service & Repair.',
    icon: 'mdi:wrench',
    body: 'Ongoing service, troubleshooting, and repair solutions to keep your security system operating at peak performance — sensor replacement, battery replacement, control panel service, and false alarm troubleshooting.',
  },
  {
    title: '24/7 Monitoring.',
    icon: 'mdi:monitor-dashboard',
    body: 'Professional 24/7 central station monitoring services for security systems of all sizes — intrusion alarms, door and window protection, motion detection, and remote user access.',
  },
  {
    title: 'Takeovers & Conversions.',
    icon: 'mdi:swap-horizontal',
    body: 'Security system takeovers, cellular communicator upgrades, mobile app integration, and conversion of existing systems — designed to fit how your facility actually operates.',
  },
] as const;

const bulletIcons = [
  'mdi:shield-check-outline',          // One Vendor Life Safety Solution
  'mdi:account-group-outline',         // Locally Owned & Family Operated
  'mdi:cellphone-link',                // 24/7 Central Station Monitoring
  'mdi:domain',                        // Commercial / Multifamily / Retail
] as const;

const accordionIcons = [
  'mdi:shield-lock-outline',          // Installation
  'mdi:wrench',                       // Service & Repair
  'mdi:monitor-dashboard',            // Monitoring
] as const;

const accordionPanels = [
  {
    title: 'Security System Installation',
    body: 'Protecting your property, employees, residents, and assets requires a reliable security system designed specifically for your facility. Red Rocks Fire Protection provides professional security system installation services for commercial buildings, multifamily communities, offices, warehouses, retail spaces, and maintenance facilities throughout Colorado. Our experienced technicians design and install security systems tailored to your property\'s unique needs and risk profile.',
    bullets: [
      'Intrusion alarm systems',
      'Door and window protection',
      'Motion detection systems',
      'Cellular communicators',
      'Remote access solutions',
      'Mobile app integration',
      'Leasing office security systems',
      'Maintenance facility security systems',
      'Tenant space security systems',
      'System expansions and upgrades',
    ],
    footer: 'We provide complete system design, installation, programming, testing, and customer training to ensure your system performs reliably from day one.',
    open: false,
  },
  {
    title: 'Security System Service & Repair',
    body: 'A security system is only effective when it is functioning properly. Red Rocks Fire Protection provides ongoing service, troubleshooting, and repair solutions to keep your security system operating at peak performance. Our technicians work quickly to identify issues and restore reliable protection to your facility.',
    bullets: [
      'System diagnostics and troubleshooting',
      'Sensor replacement',
      'Motion detector replacement',
      'Door contact replacement',
      'Cellular communicator upgrades',
      'Battery replacement',
      'Control panel service',
      'False alarm troubleshooting',
      'System expansion and modifications',
      'Emergency service calls',
    ],
    open: false,
  },
  {
    title: 'Security System Monitoring',
    body: 'Professional monitoring ensures alarm events are responded to quickly and appropriately, providing peace of mind when your property is occupied or unattended. Red Rocks Fire Protection provides 24/7 central station monitoring services for security systems of all sizes. Our monitoring solutions provide reliable protection and immediate response to alarm conditions, helping protect people, property, and assets around the clock.',
    bullets: [
      'Intrusion alarm monitoring',
      'Door and window monitoring',
      'Motion detection monitoring',
      'Cellular communication monitoring',
      'Mobile app integration',
      'Remote user access',
      'Monitoring account management',
      'Alarm verification and dispatch',
      'New monitoring account setup',
      'Security system takeovers',
    ],
    open: false,
  },
] as const;

const whyClientsIcons = [
  'solar:shield-check-bold-duotone',
  'solar:hand-heart-bold-duotone',
  'solar:rocket-2-bold-duotone',
  'solar:medal-ribbon-star-bold-duotone',
  'solar:users-group-rounded-bold-duotone',
] as const;

const whyClientsValues = [
  { title: 'We lead with safety.', body: 'Protecting lives and property is both our responsibility and our privilege.' },
  { title: 'We advocate for our clients.', body: 'We stay ahead of changing requirements and help simplify compliance.' },
  { title: 'We go the extra mile.', body: 'We take ownership of every project until the job is completed correctly.' },
  { title: 'We demonstrate character.', body: 'Integrity, professionalism, accountability, and respect guide every interaction.' },
  { title: 'And we operate as one family.', body: 'We support one another while building lasting partnerships with every client we serve.' },
] as const;

const moreThanImage = '/images/rrfps-fa-more-than-contractor.jpg';
const advocacyImage = '/images/rrfps-fa-advocacy.jpg';
const experienceImage = '/images/rrfps-fa-experience.jpg';
const promiseImage = '/images/rrfps-fa-promise.jpg';
---

<BaseLayout
  title="Security System Installation & Monitoring | Red Rocks Fire Protection | Colorado"
  description="Professional security system design, installation, service, and 24/7 central station monitoring for commercial buildings, multifamily communities, offices, warehouses, retail spaces, and maintenance facilities throughout Colorado. Intrusion alarms, door and window protection, motion detection, cellular communicators, mobile app integration."
>
  <div class="av-page">

    <!-- §0. PAGE-TITLE BANNER -->
    <div class="ptbanner">
      <div class="ptbanner__bg" style={`background-image: url('${bannerImage}');`} aria-hidden="true"></div>
      <div class="ptbanner__overlay" aria-hidden="true"></div>
      <div class="ptbanner__inner">
        <h1 class="ptbanner__title rr-reveal">Security System Installation &amp; Monitoring</h1>
        <div class="ptbanner__breadcrumbs rr-reveal" data-reveal-delay="100">
          <a href="/">Home</a>
          <span class="ptbanner__divider">-</span>
          <a href="/services">Services</a>
          <span class="ptbanner__divider">-</span>
          <span class="ptbanner__current">Security System Installation &amp; Monitoring</span>
        </div>
      </div>
    </div>

    <!-- §1. SOLUTIONS GRID — 2×2 ibox -->
    <section class="sol">
      <div class="sol__left">
        <div class="sol__sticky">
          <div class="av-dblh__subtitle rr-reveal">
            <span class="divider-icon" set:html={diamondIcon} />
            <span>What Security Service Covers</span>
          </div>
          <h2 class="sol__title rr-reveal" data-reveal-delay="100">
            <span>Installation –</span>
            <span>Service, Repair &amp;</span>
            <span>24/7 Central Station.</span>
          </h2>
          <div class="sol__spacer" aria-hidden="true"></div>
          <div class="sol__cta rr-reveal" data-reveal-delay="200">
            <a href="/contact" class="av-wgl-btn av-wgl-btn--outline">
              <span class="av-wgl-btn__text">Schedule Site Visit to Receive Complimentary Quote</span>
              <span class="av-wgl-btn__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg>
              </span>
            </a>
          </div>
        </div>
      </div>

      <div class="sol__grid">
        {categories.map((c, i) => (
          <a href="/contact" class="ibox rr-reveal" data-icon-slot={i} data-reveal-delay={i * 100}>
            <span class="ibox__bg" aria-hidden="true"></span>
            <span class="ibox__icon" aria-hidden="true">
              <iconify-icon icon={c.icon} width="50" height="50"></iconify-icon>
            </span>
            <span class="ibox__content">
              <h3 class="ibox__title">{c.title}</h3>
              <span class="ibox__text">{c.body}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- §2. WHY RED ROCKS — tan bg image + gradient overlay -->
    <section class="ss-whyrr rr-band rr-band--reveal-top">
      <div class="ss-whyrr__bg" aria-hidden="true"></div>
      <div class="ss-whyrr__overlay" aria-hidden="true"></div>
      <div class="rr-container ss-container">
        <div class="ss-why-grid">
          <div class="ss-why-grid__left">
            <p class="rr-eyebrow ss-whyrr__eyebrow mb-5 rr-reveal">Why Red Rocks Security</p>
            <h2
              class="font-display font-black tracking-tight ss-whyrr__title rr-reveal"
              data-reveal-delay="100"
              style="font-size: clamp(36px, 5vw, 56px); line-height: 1; letter-spacing: -0.04em;"
            >
              <span class="ss-whyrr__title-black">Reliable Security</span>
              <br />
              <span class="ss-whyrr__title-black">Designed Around</span>
              <br />
              <span class="ss-whyrr__title-red">Your Property</span>
              <br />
              <span class="ss-whyrr__title-red">&amp; Operations.</span>
            </h2>
          </div>

          <div class="ss-why-grid__right">
            <p class="ss-whyrr__body rr-reveal" data-reveal-delay="200" style="font-size: var(--rr-text-lead); line-height: var(--rr-text-lead-lh); margin-top: 0;">
              Protecting people, property, and assets requires a security system that fits the way your facility actually operates. At Red Rocks Fire Protection Services, we provide security system installation, service, and monitoring solutions tailored to commercial buildings, multifamily communities, offices, warehouses, retail spaces, maintenance facilities, and tenant environments.
            </p>
            <p class="ss-whyrr__body rr-reveal" data-reveal-delay="300" style="font-size: var(--rr-text-lead); line-height: var(--rr-text-lead-lh); margin-top: 1.25rem;">
              Since 2010, our family-owned company has built long-term relationships by combining technical capability with responsive service and clear communication. Our security solutions are supported by the same commitment to accountability that guides our fire and life safety work.
            </p>

            <ul class="ss-whyrr__bullets rr-reveal" data-reveal-delay="400">
              <li class="ss-whyrr__bullet">
                <span class="ss-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[0]} width="20" height="20"></iconify-icon>
                </span>
                <span>Security system design and installation tailored to the property's needs and risk profile.</span>
              </li>
              <li class="ss-whyrr__bullet">
                <span class="ss-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[1]} width="20" height="20"></iconify-icon>
                </span>
                <span>Intrusion alarms, door and window protection, motion detection, cellular communications, remote access, and mobile app integration.</span>
              </li>
              <li class="ss-whyrr__bullet">
                <span class="ss-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[2]} width="20" height="20"></iconify-icon>
                </span>
                <span>Ongoing diagnostics, troubleshooting, repairs, component replacement, expansions, and upgrades.</span>
              </li>
              <li class="ss-whyrr__bullet">
                <span class="ss-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[3]} width="20" height="20"></iconify-icon>
                </span>
                <span>24/7 central station monitoring, alarm verification and dispatch, account management, and system takeovers.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- §3. ACCORDION — 3 panels (the .md H2s) -->
    <section class="ss-accordion">
      <div class="ss-accordion__bg" aria-hidden="true"></div>
      <div class="ss-accordion__overlay" aria-hidden="true"></div>
      <div class="ss-accordion__inner ss-container">
        <div class="ss-accordion__head">
          <p class="av-dblh__subtitle ss-accordion__eyebrow rr-reveal">
            <span class="ss-accordion__rule" aria-hidden="true"></span>
            <span>How We Serve</span>
            <span class="ss-accordion__rule" aria-hidden="true"></span>
          </p>
          <h3 class="ss-accordion__title rr-reveal" data-reveal-delay="100">Our Security Services.</h3>
          <p class="ss-accordion__intro rr-reveal" data-reveal-delay="200">
            Click each panel for the full scope of our installation, service, and monitoring services.
          </p>
        </div>

        <div class="acc ss-accordion__list">
          {accordionPanels.map((p, i) => (
            <div class:list={['acc__panel', 'acc__panel--card', 'rr-reveal', p.open && 'is-active']} data-acc-panel data-reveal-delay={i * 100}>
              <button type="button" class="acc__header" aria-expanded={p.open ? 'true' : 'false'}>
                <span class="acc__panel-icon" aria-hidden="true">
                  <iconify-icon icon={accordionIcons[i]} width="22" height="22"></iconify-icon>
                </span>
                <span class="acc__title">{p.title}</span>
                <span class="acc__caret" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor"><path d={arrowPath}></path></svg>
                </span>
              </button>
              <div class="acc__content" hidden={!p.open}>
                <p>{p.body}</p>
                {p.bullets && p.bullets.length > 0 && (
                  <ul class="acc__bullets">
                    {p.bullets.map((b) => (
                      <li class="acc__bullet">
                        <span class="acc__bullet-mark" aria-hidden="true">▸</span>
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {p.footer && (
                  <p class="acc__footer">{p.footer}</p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- §4. MORE THAN A SERVICE CONTRACTOR -->
    <section class="ss-splitpanel bg-rr-white rr-band rr-band--reveal-top">
      <div class="rr-container ss-container">
        <div class="grid gap-10 md:gap-12 lg:gap-16 items-center md:grid-cols-2">
          <div class="order-2 md:order-1">
            <p class="rr-eyebrow mb-5 text-rr-grey rr-reveal">How We Work</p>
            <h2 class="font-display font-black uppercase tracking-tight rr-reveal" data-reveal-delay="100" style="font-size: var(--rr-text-section); line-height: 0.95;">
              More Than a Service Contractor.
            </h2>
            <div class="mt-6 rr-reveal ss-split-body" data-reveal-delay="200">
              <p>A security system should support your operations, not complicate them. Our team works with clients to understand how spaces are used, where protection is needed, who needs access, and how the system should be monitored and managed. From initial design and installation through training, service, expansion, and monitoring, we provide one team to support the system over time.</p>
            </div>
            <div class="mt-8 rr-reveal" data-reveal-delay="240">
              <a href="/services" class="av-wgl-btn av-wgl-btn--outline">
                <span class="av-wgl-btn__text">See All Services</span>
                <span class="av-wgl-btn__icon">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg>
                </span>
              </a>
            </div>
          </div>
          <div class="order-1 md:order-2 rr-reveal" data-reveal-delay="300">
            <div class="overflow-hidden rounded-rr-card aspect-[4/3] bg-rr-bg-panel">
              <img src={moreThanImage} alt="Red Rocks Fire Protection security team member working with a property manager on system design" loading="lazy" decoding="async" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- §5. ADVOCACY — #DBDADA bg panel -->
    <section class="ss-edge rr-band rr-band--reveal-top">
      <div class="rr-container ss-container">
        <div class="grid gap-10 md:gap-12 lg:gap-16 items-center md:grid-cols-2">
          <div class="order-2 md:order-1">
            <p class="rr-eyebrow mb-5 ss-edge__eyebrow rr-reveal">Our Edge</p>
            <h2
              class="font-display font-black uppercase tracking-tight rr-reveal ss-edge__title"
              data-reveal-delay="100"
              style="font-size: var(--rr-text-section); line-height: 0.95;"
            >
              Advocacy That Protects Your People, Property &amp; Investment.
            </h2>
            <div class="mt-6 rr-reveal ss-edge__body" data-reveal-delay="200">
              <p>Security needs can change as tenants move, buildings expand, offices are remodeled, staffing changes, or communication technology evolves. Our advocacy means helping clients adapt their systems thoughtfully. We explain options, troubleshoot recurring issues, recommend practical upgrades, and help avoid unnecessary complexity while maintaining dependable protection.</p>
            </div>
          </div>
          <div class="order-1 md:order-2 ss-edge-img rr-reveal" data-reveal-delay="300">
            <div class="overflow-hidden rounded-rr-card bg-rr-black ss-edge-img__wrap">
              <img
                src={advocacyImage}
                alt="Red Rocks Fire Protection advocating for the right security path for a client's property"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover ss-edge-img__img"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- §6. WHY CLIENTS STAY — dark bg + 5 value cards -->
    <section class="ss-why">
      <div class="ss-why__bg" aria-hidden="true"></div>
      <div class="ss-why__inner">
        <div class="rr-reveal max-w-3xl mb-12 md:mb-16">
          <p class="rr-eyebrow mb-5" style="color: rgba(255,255,255,0.7);">Why Clients Stay</p>
          <h2
            class="font-display font-black uppercase tracking-tight"
            style="font-size: var(--rr-text-section); line-height: 0.95; color: #fff;"
          >
            Why Clients Continue to Choose RRFPS.
          </h2>
          <p class="mt-6" style="font-size: var(--rr-text-lead); color: rgba(255,255,255,0.9);">
            Everything we do is built upon the values that have guided our company since its founding. These principles are reflected in our Brand Promise: we communicate clearly, we honor our commitments, we arrive prepared, we respond when it matters most, we price fairly, we stand behind our work, and we remain committed until every issue has been fully resolved.
          </p>
        </div>

        <div class="grid gap-4 md:gap-6 sm:grid-cols-2 lg:grid-cols-5">
          {whyClientsValues.map((v, i) => (
            <article class="rr-reveal ss-flowcard rounded-rr-card p-6 flex flex-col" data-reveal-delay={i * 100}>
              <span class="ss-flowcard__icon" aria-hidden="true">
                <iconify-icon icon={whyClientsIcons[i]} width="40" height="40"></iconify-icon>
              </span>
              <h3 class="font-display font-bold tracking-tight" style="font-size: var(--rr-text-card); line-height: 1.05; color: #fff;">
                {v.title}
              </h3>
              <p class="mt-3 leading-relaxed flex-1" style="font-size: var(--rr-text-lead); color: rgba(255,255,255,0.85);">
                {v.body}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- §7. EXPERIENCE — white-bg SplitPanel -->
    <section class="ss-splitpanel bg-rr-white rr-band rr-band--reveal-top">
      <div class="rr-container ss-container">
        <div class="grid gap-10 md:gap-12 lg:gap-16 items-center md:grid-cols-2">
          <div class="order-2 md:order-1">
            <p class="rr-eyebrow mb-5 text-rr-grey rr-reveal">Experience</p>
            <h2 class="font-display font-black uppercase tracking-tight rr-reveal" data-reveal-delay="100" style="font-size: var(--rr-text-section); line-height: 0.95;">
              Security System Experience You Can Trust.
            </h2>
            <div class="mt-6 rr-reveal ss-split-body" data-reveal-delay="200">
              <p>Our technicians work with intrusion alarm systems, sensors, motion detectors, door contacts, cellular communicators, control panels, remote access solutions, and monitoring connections. Because security is part of a broader portfolio of services at Red Rocks Fire Protection Services, clients can also benefit from a single life safety partner supporting multiple systems across their property.</p>
            </div>
          </div>
          <div class="order-1 md:order-2 rr-reveal" data-reveal-delay="300">
            <div class="overflow-hidden rounded-rr-card aspect-[4/3] bg-rr-bg-panel">
              <img src={experienceImage} alt="Red Rocks Fire Protection experienced security technician servicing a control panel" loading="lazy" decoding="async" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- §8. READY WHEN YOU ARE — #DBDADA bg panel -->
    <section class="ss-splitpanel ss-promise rr-band rr-band--reveal-top">
      <div class="rr-container ss-container">
        <div class="grid gap-10 md:gap-12 lg:gap-16 items-center md:grid-cols-2">
          <div class="order-2 md:order-1">
            <p class="rr-eyebrow mb-5 ss-promise__eyebrow rr-reveal">Our Promise</p>
            <h2 class="font-display font-black uppercase tracking-tight rr-reveal" data-reveal-delay="100" style="font-size: var(--rr-text-section); line-height: 0.95;">
              Ready When You Are.
            </h2>
            <div class="mt-6 rr-reveal ss-promise__body" data-reveal-delay="200">
              <p>Whether you need a new security system, a takeover of an existing system, repairs, cellular upgrades, additional protection for a new space, mobile access, or 24/7 monitoring, our team is ready to provide dependable security support and long-term service.</p>
            </div>
          </div>
          <div class="order-1 md:order-2 rr-reveal" data-reveal-delay="300">
