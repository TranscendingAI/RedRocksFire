<script>
  function initARAccordion() {
    var panels = Array.prototype.slice.call(document.querySelectorAll('[data-acc-panel]'));
    if (!panels.length) return false;
    panels.forEach(function (panel) {
      var header = panel.querySelector('.acc__header');
      var content = panel.querySelector('.acc__content');
      if (!header || !content) return;
      if (header.__arAccordionWired) return;
      header.__arAccordionWired = true;
      header.addEventListener('click', function () {
        var wasOpen = panel.classList.contains('is-active');
        panels.forEach(function (p) {
          p.classList.remove('is-active');
          var h = p.querySelector('.acc__header');
          if (h) h.setAttribute('aria-expanded', 'false');
          var c = p.querySelector('.acc__content');
          if (c) c.hidden = true;
        });
        if (!wasOpen) {
          panel.classList.add('is-active');
          header.setAttribute('aria-expanded', 'true');
          content.hidden = false;
        }
      });
    });
    return true;
  }
  function bindARAccordion() { if (!initARAccordion()) setTimeout(initARAccordion, 100); }
  document.addEventListener('astro:page-load', bindARAccordion);
  document.addEventListener('astro:after-swap', bindARAccordion);
  document.addEventListener('DOMContentLoaded', bindARAccordion);
  if (document.readyState !== 'loading') bindARAccordion();

  function initARRevealStagger() {
    document.querySelectorAll('.rr-reveal[data-reveal-delay]').forEach(function (el) {
      el.style.setProperty('--reveal-delay', el.getAttribute('data-reveal-delay') + 'ms');
    });
    var industries = document.querySelector('section.industries');
    if (industries && !industries.classList.contains('rr-reveal')) {
      var indHead = industries.querySelector('.industries__head');
      if (indHead) indHead.classList.add('rr-reveal');
      industries.querySelectorAll('.industry-card').forEach(function (card, i) {
        card.classList.add('rr-reveal');
        var d = Math.min(i, 8) * 80;
        card.setAttribute('data-reveal-delay', String(d));
        card.style.setProperty('--reveal-delay', d + 'ms');
      });
    }
    var ctaBody = document.querySelector('.cta__body');
    if (ctaBody && !ctaBody.classList.contains('rr-reveal')) ctaBody.classList.add('rr-reveal');
    var pending = document.querySelectorAll('.rr-reveal:not(.is-visible)');
    if (pending.length) {
      var pageObserver = new IntersectionObserver(function (entries) {
        for (var i = 0; i < entries.length; i++) {
          if (entries[i].isIntersecting) {
            entries[i].target.classList.add('is-visible');
            pageObserver.unobserve(entries[i].target);
          }
        }
      }, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });
      pending.forEach(function (el) { pageObserver.observe(el); });
    }
    document.querySelectorAll('.rr-reveal').forEach(function (el) {
      if (el.classList.contains('is-visible')) { el.style.removeProperty('--reveal-delay'); return; }
      var cleanup = new MutationObserver(function () {
        if (el.classList.contains('is-visible')) { el.style.removeProperty('--reveal-delay'); cleanup.disconnect(); }
      });
      cleanup.observe(el, { attributes: true, attributeFilter: ['class'] });
    });
  }
  function bindARReveal() { initARRevealStagger(); }
  document.addEventListener('astro:page-load', bindARReveal);
  document.addEventListener('DOMContentLoaded', bindARReveal);
  if (document.readyState !== 'loading') bindARReveal();
</script>
