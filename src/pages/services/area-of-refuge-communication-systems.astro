---
/**
 * Area of Refuge Communication Systems — RRFPS landing page for
 * /services/area-of-refuge-communication-systems/.
 *
 * Layout cloned 1:1 from fire-sprinkler-service-and-systems.astro
 * (per Zack's direction) with the copy swapped verbatim from
 * reference/content/rrfps-9-service-pages-with-why-red-rocks-sections.md
 * (Page 7 — Area of Refuge Communication Systems).
 *
 * Sections, in order:
 *   0. ptbanner
 *   1. 2×2 ibox grid (4 area-of-refuge service categories)
 *   2. `ar-whyrr` tan bg-image intro band
 *   3. 3-panel accordion (Inspection & Testing / Service & Repair /
 *      Installations & Upgrades — the .md H2s)
 *   4. SplitPanel — More Than a Service Contractor
 *   5. SplitPanel — Advocacy (#DBDADA bg)
 *   6. Why Clients Stay — dark bg + 5 value cards
 *   7. SplitPanel — Experience (white bg)
 *   8. SplitPanel — Ready When You Are. (#DBDADA bg)
 *   9. IndustriesGrid (shared)
 *  10. ClosingCTA (shared, area-of-refuge-themed paragraph)
 *
 * Image assets — all placeholders, to be swapped for page-specific
 * Nano Banana imagery after the batch build:
 *   • Hero           — /images/rrfps-area-of-refuge-communication-systems-page-hero.png
 *   • §2 tan band bg — /images/rrfps-backflow-prevention-why-red-rocks-bg.jpg
 *   • §3 accordion bg — /images/rrfps-area-of-refuge-communication-systems-services-accordion-bg.jpg
 *   • §4 more than    — /images/rrfps-area-of-refuge-communication-systems-more-than-a-service-contractor.jpg
 *   • §5 advocacy     — /images/rrfps-area-of-refuge-communication-systems-advocacy.jpg
 *   • §6 values bg    — /images/rrfps-area-of-refuge-communication-systems-why-clients-stay-bg.jpg
 *   • §7 experience   — /images/rrfps-area-of-refuge-communication-systems-experience.jpg
 *   • §8 promise      — /images/rrfps-area-of-refuge-communication-systems-ready-when-you-are.jpg
 *   • ClosingCTA bg   — /images/rrfps-services-cta-bg.png
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import IndustriesGrid from '../../components/IndustriesGrid.astro';

const arrowPath = 'M0 6.78247C0 6.52555 0.102065 6.27914 0.283741 6.09746C0.465416 5.91579 0.711822 5.81372 0.96875 5.81372H12.1927L8.03288 1.65585C7.85097 1.47394 7.74878 1.22723 7.74878 0.969974C7.74878 0.712721 7.85097 0.466004 8.03288 0.284099C8.21478 0.102194 8.4615 0 8.71875 0C8.976 0 9.22272 0.102194 9.40463 0.284099L15.2171 6.0966C15.3073 6.18659 15.3789 6.29349 15.4278 6.41118C15.4766 6.52888 15.5017 6.65505 15.5017 6.78247C15.5017 6.9099 15.4766 7.03607 15.4278 7.15376C15.3789 7.27146 15.3073 7.37836 15.2171 7.46835L9.40463 13.2808C9.22272 13.4628 8.976 13.5649 8.71875 13.5649C8.4615 13.5649 8.21478 13.4628 8.03288 13.2808C7.85097 13.0989 7.74878 12.8522 7.74878 12.595C7.74878 12.3377 7.85097 12.091 8.03288 11.9091L12.1927 7.75122H0.96875C0.711822 7.75122 0.465416 7.64916 0.283741 7.46748C0.102065 7.28581 0 7.0394 0 6.78247Z';

const diamondIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="20" viewBox="0 0 15 20"><path d="M0.660472 19.6191L0.47542 6.53585L13.7437 19.8041L0.660472 19.6191Z"></path><path d="M14.3396 0.939992L14.5246 14.0232L1.25635 0.754941L14.3396 0.939992Z"></path></svg>';

const bannerImage = '/images/rrfps-area-of-refuge-communication-systems-page-hero.png';

const categories = [
  {
    title: 'Annual Inspection & Testing.',
    icon: 'mdi:shield-account-outline',
    body: 'Annual inspection and testing services to verify reliable two-way communication, clear signaling, power supply performance, and code compliance for area of refuge systems.',
  },
  {
    title: 'Service & Repair.',
    icon: 'mdi:wrench',
    body: 'Complete service and repair solutions for area of refuge communication systems, including station diagnostics, call box repair, hands-free operation service, and signaling support.',
  },
  {
    title: 'Installations & Upgrades.',
    icon: 'mdi:rocket-launch-outline',
    body: 'New installations and complete upgrade solutions for area of refuge communication systems — including ADA-compliant call stations, power supplies, off-premises signaling, and replacements of older systems.',
  },
  {
    title: 'Multi-Story & Multi-Site Programs.',
    icon: 'mdi:office-building-outline',
    body: 'Comprehensive area of refuge programs for high-rise buildings, multi-story properties, and multi-site portfolios — coordinated installations, shared standards, and consistent inspection support.',
  },
] as const;

const bulletIcons = [
  'mdi:shield-check-outline',          // One Vendor Life Safety Solution
  'mdi:account-group-outline',         // Locally Owned & Family Operated
  'mdi:cellphone-link',                // 24/7 Central Station Monitoring
  'mdi:domain',                        // Commercial / Multifamily / Retail
] as const;

const accordionIcons = [
  'mdi:shield-account-outline',       // Inspection & Testing
  'mdi:wrench',                       // Service & Repair
  'mdi:rocket-launch-outline',        // Installations & Upgrades
] as const;

const accordionPanels = [
  {
    title: 'Area of Refuge Inspection & Testing',
    body: 'Area of refuge communication systems provide two-way communication between a refuge area and a central control point or the building\'s emergency communication center. These systems are required by building and fire codes for many high-rise and multi-story buildings and must be regularly inspected and tested to ensure proper operation. Red Rocks Fire Protection provides annual inspection and testing services to verify that area of refuge systems remain reliable, code-compliant, and ready for use when needed.',
    bullets: [
      'Annual area of refuge system inspections',
      'Two-way communication verification',
      'Call station operation testing',
      'Power supply verification',
      'Battery backup testing',
      'Signal verification',
      'Hands-free operation testing',
      'Deficiency identification and reporting',
      'Documentation and tagging',
    ],
    open: false,
  },
  {
    title: 'Area of Refuge Service & Repair',
    body: 'Like any life safety system, area of refuge communication systems must be properly maintained to ensure they operate reliably when needed. Red Rocks Fire Protection provides complete service and repair solutions for area of refuge communication systems, including diagnostic, repair, component replacement, and ongoing maintenance support. Our technicians work efficiently to identify issues and restore reliable two-way communication throughout the property.',
    bullets: [
      'System diagnostics and troubleshooting',
      'Call station repair',
      'Call box repair and replacement',
      'Hands-free operation service',
      'Power supply repair and replacement',
      'Battery replacement',
      'Wiring repairs',
      'Signal and communication verification',
      'System expansion',
      'Emergency service response',
    ],
    open: false,
  },
  {
    title: 'Area of Refuge Installations & Upgrades',
    body: 'Red Rocks Fire Protection provides new area of refuge communication system installations and complete upgrade solutions for existing systems. We work with property owners, managers, and design teams to install reliable, code-compliant systems that meet the operational needs of the building. We also upgrade older, unsupported, or non-compliant systems to modern, ADA-compliant area of refuge communication solutions.',
    bullets: [
      'New area of refuge communication system installations',
      'ADA-compliant call stations',
      'Two-way communication systems',
      'Power supply installations',
      'Off-premises signaling',
      'Replacement of older systems',
      'System expansions and upgrades',
      'Remodels and tenant improvements',
      'New construction installations',
    ],
    footer: 'Common Signs a System May Need Upgrade: failed annual testing, unsupported equipment, ADA-compliance concerns, communication failures, power supply issues, or jurisdictions that have updated code requirements.',
    open: false,
  },
] as const;

const whyClientsIcons = [
  'solar:shield-check-bold-duotone',
  'solar:hand-heart-bold-duotone',
  'solar:rocket-2-bold-duotone',
  'solar:medal-ribbon-star-bold-duotone',
  'solar:users-group-rounded-bold-duotone',
] as const;

const whyClientsValues = [
  { title: 'We lead with safety.', body: 'Protecting lives and property is both our responsibility and our privilege.' },
  { title: 'We advocate for our clients.', body: 'We stay ahead of changing requirements and help simplify compliance.' },
  { title: 'We go the extra mile.', body: 'We take ownership of every project until the job is completed correctly.' },
  { title: 'We demonstrate character.', body: 'Integrity, professionalism, accountability, and respect guide every interaction.' },
  { title: 'And we operate as one family.', body: 'We support one another while building lasting partnerships with every client we serve.' },
] as const;

const moreThanImage = '/images/rrfps-area-of-refuge-communication-systems-more-than-a-service-contractor.jpg';
const advocacyImage = '/images/rrfps-area-of-refuge-communication-systems-advocacy.jpg';
const experienceImage = '/images/rrfps-area-of-refuge-communication-systems-experience.jpg';
const promiseImage = '/images/rrfps-area-of-refuge-communication-systems-ready-when-you-are.jpg';
---

<BaseLayout
  title="Area of Refuge Communication Systems | Red Rocks Fire Protection | Colorado"
  description="Inspection, service, repair, and new installation of two-way area of refuge communication systems for high-rise, multi-story, and ADA-regulated buildings throughout Colorado. ADA-compliant call stations, battery backup testing, off-premises signaling, and full system upgrades."
>
  <div class="av-page">

    <!-- §0. PAGE-TITLE BANNER -->
    <div class="ptbanner">
      <div class="ptbanner__bg" style={`background-image: url('${bannerImage}');`} aria-hidden="true"></div>
      <div class="ptbanner__overlay" aria-hidden="true"></div>
      <div class="ptbanner__inner">
        <h1 class="ptbanner__title rr-reveal">Area of Refuge Communication Systems</h1>
        <div class="ptbanner__breadcrumbs rr-reveal" data-reveal-delay="100">
          <a href="/">Home</a>
          <span class="ptbanner__divider">-</span>
          <a href="/services">Services</a>
          <span class="ptbanner__divider">-</span>
          <span class="ptbanner__current">Area of Refuge Communication Systems</span>
        </div>
      </div>
    </div>

    <!-- §1. SOLUTIONS GRID — 2×2 ibox -->
    <section class="sol">
      <div class="sol__left">
        <div class="sol__sticky">
          <div class="av-dblh__subtitle rr-reveal">
            <span class="divider-icon" set:html={diamondIcon} />
            <span>What Area of Refuge Service Covers</span>
          </div>
          <h2 class="sol__title rr-reveal" data-reveal-delay="100">
            <span>Inspection –</span>
            <span>Service, Repair &amp;</span>
            <span>Installations &amp; Upgrades.</span>
          </h2>
          <div class="sol__spacer" aria-hidden="true"></div>
          <div class="sol__cta rr-reveal" data-reveal-delay="200">
            <a href="/contact" class="av-wgl-btn av-wgl-btn--outline">
              <span class="av-wgl-btn__text">Schedule Site Visit to Receive Complimentary Quote</span>
              <span class="av-wgl-btn__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg>
              </span>
            </a>
          </div>
        </div>
      </div>

      <div class="sol__grid">
        {categories.map((c, i) => (
          <a href="/contact" class="ibox rr-reveal" data-icon-slot={i} data-reveal-delay={i * 100}>
            <span class="ibox__bg" aria-hidden="true"></span>
            <span class="ibox__icon" aria-hidden="true">
              <iconify-icon icon={c.icon} width="50" height="50"></iconify-icon>
            </span>
            <span class="ibox__content">
              <h3 class="ibox__title">{c.title}</h3>
              <span class="ibox__text">{c.body}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- §2. WHY RED ROCKS — tan bg image + gradient overlay -->
    <section class="ar-whyrr rr-band rr-band--reveal-top">
      <div class="ar-whyrr__bg" aria-hidden="true"></div>
      <div class="ar-whyrr__overlay" aria-hidden="true"></div>
      <div class="rr-container ar-container">
        <div class="ar-why-grid">
          <div class="ar-why-grid__left">
            <p class="rr-eyebrow ar-whyrr__eyebrow mb-5 rr-reveal">Why Red Rocks Area of Refuge</p>
            <h2
              class="font-display font-black tracking-tight ar-whyrr__title rr-reveal"
              data-reveal-delay="100"
              style="font-size: clamp(36px, 5vw, 56px); line-height: 1; letter-spacing: -0.04em;"
            >
              <span class="ar-whyrr__title-black">Reliable Two-Way</span>
              <br />
              <span class="ar-whyrr__title-black">Communication When</span>
              <br />
              <span class="ar-whyrr__title-red">Occupants Need</span>
              <br />
              <span class="ar-whyrr__title-red">It Most.</span>
            </h2>
          </div>

          <div class="ar-why-grid__right">
            <p class="ar-whyrr__body rr-reveal" data-reveal-delay="200" style="font-size: var(--rr-text-lead); line-height: var(--rr-text-lead-lh); margin-top: 0;">
              An area of refuge is a designated location in a building where occupants can wait for assistance during an emergency. For these spaces to function as intended, two-way communication between the refuge area and a central control point or emergency response location must be reliable. At Red Rocks Fire Protection Services, we understand what it takes to keep those systems ready, compliant, and operational.
            </p>
            <p class="ar-whyrr__body rr-reveal" data-reveal-delay="300" style="font-size: var(--rr-text-lead); line-height: var(--rr-text-lead-lh); margin-top: 1.25rem;">
              Since 2010, our family-owned company has supported property owners and managers with dependable life safety services throughout Colorado. Our area of refuge services are designed to support reliable two-way communication through regular inspection, prompt service, thoughtful system upgrades, and code-aligned installations.
            </p>

            <ul class="ar-whyrr__bullets rr-reveal" data-reveal-delay="400">
              <li class="ar-whyrr__bullet">
                <span class="ar-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[0]} width="20" height="20"></iconify-icon>
                </span>
                <span>Annual inspection and testing, two-way communication verification, call station testing, power supply verification, and battery backup testing.</span>
              </li>
              <li class="ar-whyrr__bullet">
                <span class="ar-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[1]} width="20" height="20"></iconify-icon>
                </span>
                <span>Diagnostics, call station repair, call box repair, hands-free operation service, wiring repairs, and emergency service response.</span>
              </li>
              <li class="ar-whyrr__bullet">
                <span class="ar-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[2]} width="20" height="20"></iconify-icon>
                </span>
                <span>New ADA-compliant installations, off-premises signaling, complete system upgrades, and remodels.</span>
              </li>
              <li class="ar-whyrr__bullet">
                <span class="ar-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[3]} width="20" height="20"></iconify-icon>
                </span>
                <span>Coordinated area of refuge programs for high-rise, multi-story, and multi-site portfolios.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- §3. ACCORDION — 3 panels (the .md H2s) -->
    <section class="ar-accordion">
      <div class="ar-accordion__bg" aria-hidden="true"></div>
      <div class="ar-accordion__overlay" aria-hidden="true"></div>
      <div class="ar-accordion__inner ar-container">
        <div class="ar-accordion__head">
          <p class="av-dblh__subtitle ar-accordion__eyebrow rr-reveal">
            <span class="ar-accordion__rule" aria-hidden="true"></span>
            <span>How We Serve</span>
            <span class="ar-accordion__rule" aria-hidden="true"></span>
          </p>
          <h3 class="ar-accordion__title rr-reveal" data-reveal-delay="100">Our Area of Refuge Services.</h3>
          <p class="ar-accordion__intro rr-reveal" data-reveal-delay="200">
            Click each panel for the full scope of our inspection, service, and installation services.
          </p>
        </div>

        <div class="acc ar-accordion__list">
          {accordionPanels.map((p, i) => (
            <div class:list={['acc__panel', 'acc__panel--card', 'rr-reveal', p.open && 'is-active']} data-acc-panel data-reveal-delay={i * 100}>
              <button type="button" class="acc__header" aria-expanded={p.open ? 'true' : 'false'}>
                <span class="acc__panel-icon" aria-hidden="true">
                  <iconify-icon icon={accordionIcons[i]} width="22" height="22"></iconify-icon>
                </span>
                <span class="acc__title">{p.title}</span>
                <span class="acc__caret" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor"><path d={arrowPath}></path></svg>
                </span>
              </button>
              <div class="acc__content" hidden={!p.open}>
                <p>{p.body}</p>
                {p.bullets && p.bullets.length > 0 && (
                  <ul class="acc__bullets">
                    {p.bullets.map((b) => (
                      <li class="acc__bullet">
                        <span class="acc__bullet-mark" aria-hidden="true">▸</span>
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {p.footer && (
                  <p class="acc__footer">{p.footer}</p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- §4. MORE THAN A SERVICE CONTRACTOR -->
    <section class="ar-splitpanel bg-rr-white rr-band rr-band--reveal-top">
      <div class="rr-container ar-container">
        <div class="grid gap-10 md:gap-12 lg:gap-16 items-center md:grid-cols-2">
          <div class="order-2 md:order-1">
            <p class="rr-eyebrow mb-5 text-rr-grey rr-reveal">How We Work</p>
            <h2 class="font-display font-black uppercase tracking-tight rr-reveal" data-reveal-delay="100" style="font-size: var(--rr-text-section); line-height: 0.95;">
              More Than a Service Contractor.
            </h2>
            <div class="mt-6 rr-reveal ar-split-body" data-reveal-delay="200">
              <p>Area of refuge systems combine call stations, power supplies, battery backup, signaling, and a central communication point. We look at the system as a whole so the right components are in place, working together, and ready to support occupants during an emergency. From initial design and installation through annual testing and ongoing service, our team supports area of refuge systems as a long-term partner.</p>
            </div>
            <div class="mt-8 rr-reveal" data-reveal-delay="240">
              <a href="/services" class="av-wgl-btn av-wgl-btn--outline">
                <span class="av-wgl-btn__text">See All Services</span>
                <span class="av-wgl-btn__icon">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg>
                </span>
              </a>
            </div>
          </div>
          <div class="order-1 md:order-2 rr-reveal" data-reveal-delay="300">
            <div class="overflow-hidden rounded-rr-card aspect-[4/3] bg-rr-bg-panel">
              <img src={moreThanImage} alt="Red Rocks Fire Protection technician inspecting an area of refuge call station with a building manager" loading="lazy" decoding="async" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- §5. ADVOCACY — #DBDADA bg panel -->
    <section class="ar-edge rr-band rr-band--reveal-top">
      <div class="rr-container ar-container">
        <div class="grid gap-10 md:gap-12 lg:gap-16 items-center md:grid-cols-2">
          <div class="order-2 md:order-1">
            <p class="rr-eyebrow mb-5 ar-edge__eyebrow rr-reveal">Our Edge</p>
            <h2
              class="font-display font-black uppercase tracking-tight rr-reveal ar-edge__title"
              data-reveal-delay="100"
              style="font-size: var(--rr-text-section); line-height: 0.95;"
            >
              Advocacy That Protects Your People, Property &amp; Investment.
            </h2>
            <div class="mt-6 rr-reveal ar-edge__body" data-reveal-delay="200">
              <p>Older systems, equipment changes, ADA-related updates, and evolving jurisdictional expectations can all affect what an area of refuge system needs to be. Our advocacy helps clients understand what their current system delivers, where it stands relative to current expectations, and what practical next steps make sense. We help you avoid surprises at inspection and plan upgrades on your schedule rather than under pressure.</p>
            </div>
          </div>
          <div class="order-1 md:order-2 ar-edge-img rr-reveal" data-reveal-delay="300">
            <div class="overflow-hidden rounded-rr-card bg-rr-black ar-edge-img__wrap">
              <img
                src={advocacyImage}
                alt="Red Rocks Fire Protection advocating for the right area of refuge path for a client's property"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover ar-edge-img__img"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- §6. WHY CLIENTS STAY — dark bg + 5 value cards -->
    <section class="ar-why">
      <div class="ar-why__bg" aria-hidden="true"></div>
      <div class="ar-why__inner">
        <div class="rr-reveal max-w-3xl mb-12 md:mb-16">
          <p class="rr-eyebrow mb-5" style="color: rgba(255,255,255,0.7);">Why Clients Stay</p>
          <h2
            class="font-display font-black uppercase tracking-tight"
            style="font-size: var(--rr-text-section); line-height: 0.95; color: #fff;"
          >
            Why Clients Continue to Choose RRFPS.
          </h2>
          <p class="mt-6" style="font-size: var(--rr-text-lead); color: rgba(255,255,255,0.9);">
            Everything we do is built upon the values that have guided our company since its founding. These principles are reflected in our Brand Promise: we communicate clearly, we honor our commitments, we arrive prepared, we respond when it matters most, we price fairly, we stand behind our work, and we remain committed until every issue has been fully resolved.
          </p>
        </div>

        <div class="grid gap-4 md:gap-6 sm:grid-cols-2 lg:grid-cols-5">
          {whyClientsValues.map((v, i) => (
            <article class="rr-reveal ar-flowcard rounded-rr-card p-6 flex flex-col" data-reveal-delay={i * 100}>
              <span class="ar-flowcard__icon" aria-hidden="true">
                <iconify-icon icon={whyClientsIcons[i]} width="40" height="40"></iconify-icon>
              </span>
              <h3 class="font-display font-bold tracking-tight" style="font-size: var(--rr-text-card); line-height: 1.05; color: #fff;">
                {v.title}
              </h3>
              <p class="mt-3 leading-relaxed flex-1" style="font-size: var(--rr-text-lead); color: rgba(255,255,255,0.85);">
                {v.body}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- §7. EXPERIENCE — white-bg SplitPanel -->
    <section class="ar-splitpanel bg-rr-white rr-band rr-band--reveal-top">
      <div class="rr-container ar-container">
        <div class="grid gap-10 md:gap-12 lg:gap-16 items-center md:grid-cols-2">
          <div class="order-2 md:order-1">
            <p class="rr-eyebrow mb-5 text-rr-grey rr-reveal">Experience</p>
            <h2 class="font-display font-black uppercase tracking-tight rr-reveal" data-reveal-delay="100" style="font-size: var(--rr-text-section); line-height: 0.95;">
              Area of Refuge Experience You Can Trust.
            </h2>
            <div class="mt-6 rr-reveal ar-split-body" data-reveal-delay="200">
              <p>Our technicians understand how area of refuge systems connect to call stations, central control points, power supplies, battery backup, and off-premises signaling. We work with both new and existing systems, providing inspection, service, repair, installation, and upgrade support that helps clients maintain reliable two-way communication throughout their properties.</p>
            </div>
          </div>
          <div class="order-1 md:order-2 rr-reveal" data-reveal-delay="300">
            <div class="overflow-hidden rounded-rr-card aspect-[4/3] bg-rr-bg-panel">
              <img src={experienceImage} alt="Red Rocks Fire Protection experienced area of refuge technician servicing a call station" loading="lazy" decoding="async" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- §8. READY WHEN YOU ARE — #DBDADA bg panel -->
    <section class="ar-splitpanel ar-promise rr-band rr-band--reveal-top">
      <div class="rr-container ar-container">
