---
/**
 * Fire Alarm Service & Systems — RRFPS landing page for
 * /services/fire-alarm-service-and-systems/.
 *
 * Layout cloned 1:1 from fire-sprinkler-service-and-systems.astro
 * (per Zack's direction) with the copy swapped verbatim from
 * reference/content/rrfps-complete-fire-alarms-website-content.md.
 *
 * Sections, in order:
 *   0. ptbanner                          — same hero pattern as the
 *                                          sprinkler page (dark image
 *                                          bg + light overlay). Every
 *                                          section on this page uses
 *                                          the site-wide .rr-reveal
 *                                          fade-up entrance with a
 *                                          data-reveal-delay stagger
 *                                          (consumed by the scoped
 *                                          --reveal-delay rule + the
 *                                          page script; see the
 *                                          <script> block).
 *   1. 2×2 ibox grid                     — sticky headline left + 4
 *                                          iboxes right (Service /
 *                                          Modifications / Replacement /
 *                                          24/7 Emergency Response)
 *   2. `fa-whyrr` tan bg-image intro     — "Your Trusted Partner for
 *                                          Fire Alarm Service & Systems."
 *   3. 4-panel accordion                 — service scope with bullet
 *                                          lists (Service / Modifications /
 *                                          Replacement / Signs You Need
 *                                          Replacement)
 *   4. GAMEWELL AUTHORIZED DEALER        — NEW 3-column section (client
 *                                          priority): description text |
 *                                          benefits bullets | Gamewell-FCI
 *                                          logo card, separated by vertical
 *                                          dividers. White bg + red accent
 *                                          border + red H2 eyebrow so it
 *                                          stands out.
 *   5. More Than a Fire Alarm Contractor — white-bg SplitPanel rhythm
 *                                          (3 paragraphs, image right)
 *   6. Advocacy                           — #DBDADA bg panel (image right)
 *   7. Why Clients Stay                   — dark bg-image + 5 value cards
 *   8. Experience                         — white-bg SplitPanel (image right)
 *   9. Our Promise — Ready When You Are.  — #DBDADA bg panel (image right)
 *  10. IndustriesGrid                     — shared component
 *  11. ClosingCTA                        — shared component with the
 *                                          fire-alarm closing copy
 *
 * Theme rhythm (no two same-theme back-to-back where avoidable):
 *   §0 dark → §1 white → §2 tan-image → §3 dark-image → §4 black-solid
 *   (red-accented) → §5 white → §6 #DBDADA → §7 dark-image → §8 white
 *   → §9 #DBDADA → §10 white → §11 CTA
 *
 * Image assets (all generated via Higgsfield Nano Banana — inspectors
 * in plain black collared shirts with no logos, per client direction):
 *   • Hero            — red-rocks-fire-alarm-hero-bg.png
 *   • §2 tan band bg  — red-rocks-fire-alarm-why-bg.jpg
 *   • Accordion bg    — red-rocks-fire-alarm-accordion-bg.jpg
 *   • §5 More Than    — rrfps-fa-more-than-contractor.jpg
 *   • §6 Advocacy     — rrfps-fa-advocacy.jpg
 *   • §7 values bg    — rrfps-fa-why-clients-stay-bg.jpg
 *   • §8 Experience   — rrfps-fa-experience.jpg
 *   • §9 Promise      — rrfps-fa-promise.jpg
 *   • ClosingCTA bg   — rrfps-services-cta-bg.png (shared asset)
 *   • Gamewell logo   — rrfps-fci-gamewell-logo.webp (client asset)
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import IndustriesGrid from '../../components/IndustriesGrid.astro';

const arrowPath = 'M0 6.78247C0 6.52555 0.102065 6.27914 0.283741 6.09746C0.465416 5.91579 0.711822 5.81372 0.96875 5.81372H12.1927L8.03288 1.65585C7.85097 1.47394 7.74878 1.22723 7.74878 0.969974C7.74878 0.712721 7.85097 0.466004 8.03288 0.284099C8.21478 0.102194 8.4615 0 8.71875 0C8.976 0 9.22272 0.102194 9.40463 0.284099L15.2171 6.0966C15.3073 6.18659 15.3789 6.29349 15.4278 6.41118C15.4766 6.52888 15.5017 6.65505 15.5017 6.78247C15.5017 6.9099 15.4766 7.03607 15.4278 7.15376C15.3789 7.27146 15.3073 7.37836 15.2171 7.46835L9.40463 13.2808C9.22272 13.4628 8.976 13.5649 8.71875 13.5649C8.4615 13.5649 8.21478 13.4628 8.03288 13.2808C7.85097 13.0989 7.74878 12.8522 7.74878 12.595C7.74878 12.3377 7.85097 12.091 8.03288 11.9091L12.1927 7.75122H0.96875C0.711822 7.75122 0.465416 7.64916 0.283741 7.46748C0.102065 7.28581 0 7.0394 0 6.78247Z';

const diamondIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="20" viewBox="0 0 15 20"><path d="M0.660472 19.6191L0.47542 6.53585L13.7437 19.8041L0.660472 19.6191Z"></path><path d="M14.3396 0.939992L14.5246 14.0232L1.25635 0.754941L14.3396 0.939992Z"></path></svg>';

/* ── Image assets (all generated via Higgsfield Nano Banana) ────── */
const bannerImage = '/images/red-rocks-fire-alarm-hero-bg.png';

/* §1 ibox — 4 fire-alarm service lines. */
const categories = [
  {
    title: 'Fire Alarm System Service.',
    icon: 'mdi:bell-ring-outline',
    body: 'A properly functioning fire alarm system is critical to protecting lives, property, and business operations — providing early warning and notification during an emergency so occupants can evacuate safely and responders can react quickly.',
  },
  {
    title: 'System Modifications.',
    icon: 'mdi:cog-outline',
    body: 'Building renovations, tenant improvements, occupancy changes, and code upgrades often require modifications to existing fire alarm systems. We design and install code-compliant modifications that maintain proper system functionality.',
  },
  {
    title: 'System Replacement.',
    icon: 'mdi:sync',
    body: 'As fire alarm systems age, components become obsolete and reliability can decrease. From small control panel upgrades to complete building-wide replacements, replacing an aging system is often the more cost-effective long-term solution.',
  },
  {
    title: '24/7 Emergency Response.',
    icon: 'mdi:clock',
    body: 'Trouble signals, ground faults, failed devices, and communication issues cannot wait. Our certified technicians provide emergency service calls and 24/7 emergency response for fire alarm systems across Colorado.',
  },
] as const;

/* §2 Why Red Rocks — one icon per bullet, index-aligned. */
const bulletIcons = [
  'mdi:fire-circle',           // Comprehensive fire alarm expertise
  'mdi:certificate-outline',   // Code-focused NFPA 72 service
  'mdi:shield-check-outline',  // Authorized Gamewell-FCI Dealer
  'mdi:clock',                 // 24/7 emergency response
] as const;

/* §3 accordion — one MDI icon per panel, index-aligned. */
const accordionIcons = [
  'mdi:bell-ring-outline',   // Fire Alarm System Service
  'mdi:cog-outline',         // Fire Alarm System Modifications
  'mdi:sync',                // Fire Alarm System Replacement
  'mdi:alert-circle-outline', // Signs Your System May Need Replacement
] as const;

/* §3 accordion panels — copy verbatim from the source .md. */
const accordionPanels = [
  {
    title: 'Fire Alarm System Service',
    body: 'Red Rocks Fire Protection provides comprehensive fire alarm service for commercial, multifamily, healthcare, retail, industrial, and assisted living facilities throughout Colorado. Our certified technicians diagnose system troubles, perform repairs, replace failed devices, troubleshoot communication issues, and maintain system reliability to ensure compliance with NFPA 72 and local fire code requirements.',
    bullets: [
      'Troubleshooting and diagnostics',
      'Smoke detector replacement',
      'Heat detector replacement',
      'Pull station replacement',
      'Horn and strobe replacement',
      'Control panel service and repair',
      'Power supply replacement',
      'Battery testing and replacement',
      'Monitoring communication repairs',
      'Ground fault troubleshooting',
      'Emergency service calls',
      '24/7 emergency response',
    ],
    open: false,
  },
  {
    title: 'Fire Alarm System Modifications',
    body: 'Red Rocks Fire Protection specializes in designing and installing fire alarm system modifications that maintain proper system functionality and code compliance. Our team works with property owners, management companies, contractors, and local Authorities Having Jurisdiction (AHJs) to ensure all modifications meet applicable codes and project requirements.',
    bullets: [
      'Tenant finish projects',
      'Office remodels',
      'Device relocations',
      'Additional smoke detectors',
      'Additional notification appliances',
      'New pull stations',
      'Elevator recall modifications',
      'Duct detector additions',
      'New monitoring points',
      'Building expansions',
      'Code compliance upgrades',
    ],
    footer: 'Our team handles the entire process, including design, permitting, installation, programming, testing, and final acceptance.',
    open: false,
  },
  {
    title: 'Fire Alarm System Replacement',
    body: 'Red Rocks Fire Protection provides complete fire alarm system replacement services, from small control panel upgrades to complete building-wide system replacements.',
    bullets: [
      'Fire alarm control panels',
      'Remote annunciators',
      'Power supplies',
      'Smoke detectors',
      'Heat detectors',
      'Pull stations',
      'Horns and strobes',
      'Communication equipment',
      'Monitoring equipment',
      'Voice evacuation systems',
      'Emergency responder communication systems (BDA/ERRCS)',
    ],
    open: false,
  },
  {
    title: 'Signs Your System May Need Replacement',
    body: 'As fire alarm systems age, components become obsolete, replacement parts become difficult to obtain, and reliability can decrease. In many cases, replacing an aging system provides a more cost-effective and dependable long-term solution than continued repairs. Here are the indicators that replacement is typically the right call:',
    bullets: [
      'Obsolete equipment',
      'Discontinued replacement parts',
      'Frequent trouble conditions',
      'Recurring service calls',
      'Failed communication equipment',
      'Expansion limitations',
      'Repeated false alarms',
      'Code compliance concerns',
      'Aging infrastructure',
    ],
    footer: 'Our replacement projects are designed to improve reliability, simplify maintenance, and provide long-term life safety protection.',
    open: false,
  },
] as const;

/* §7 Why Clients Stay — one icon per value card, index-aligned. */
const whyClientsIcons = [
  'solar:shield-check-bold-duotone',        // We lead with safety
  'solar:hand-heart-bold-duotone',          // We advocate for our clients
  'solar:rocket-2-bold-duotone',            // We go the extra mile
  'solar:medal-ribbon-star-bold-duotone',   // We demonstrate character
  'solar:users-group-rounded-bold-duotone', // We operate as one family
] as const;

const whyClientsValues = [
  { title: 'We lead with safety.', body: 'Protecting lives and property is both our responsibility and our privilege.' },
  { title: 'We advocate for our clients.', body: 'We stay ahead of changing codes and help simplify compliance.' },
  { title: 'We go the extra mile.', body: 'We take ownership of every project until the job is completed correctly.' },
  { title: 'We demonstrate character.', body: 'Integrity, professionalism, accountability, and respect guide every interaction.' },
  { title: 'And we operate as one family.', body: 'We support one another while building lasting partnerships with every client we serve.' },
] as const;

/* SplitPanel / panel images — generated via Nano Banana (technicians
 * in plain black collared shirts, no logos, per client wardrobe spec). */
const moreThanImage = '/images/rrfps-fa-more-than-contractor.jpg';
const advocacyImage = '/images/rrfps-fa-advocacy.jpg';
const experienceImage = '/images/rrfps-fa-experience.jpg';
const promiseImage = '/images/rrfps-fa-promise.jpg';
---

<BaseLayout
  title="Fire Alarm Service & Systems | Red Rocks Fire Protection | Colorado"
  description="Comprehensive fire alarm service, modifications, and replacement for commercial, multifamily, healthcare, retail, industrial, and assisted living facilities across Colorado. NFPA 72 compliance, Gamewell-FCI authorized dealer, 24/7 emergency response."
>
  <div class="av-page">

    <!-- ══════════════════════════════════════════════════════════
         §0. PAGE-TITLE BANNER (sprinkler-page §0 pattern)
         ══════════════════════════════════════════════════════════ -->
    <div class="ptbanner">
      <div class="ptbanner__bg" style={`background-image: url('${bannerImage}');`} aria-hidden="true"></div>
      <div class="ptbanner__overlay" aria-hidden="true"></div>
      <div class="ptbanner__inner">
        <h1 class="ptbanner__title rr-reveal">Fire Alarm Service &amp; Systems</h1>
        <div class="ptbanner__breadcrumbs rr-reveal" data-reveal-delay="100">
          <a href="/">Home</a>
          <span class="ptbanner__divider">-</span>
          <a href="/services">Services</a>
          <span class="ptbanner__divider">-</span>
          <span class="ptbanner__current">Fire Alarm Service &amp; Systems</span>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════
         §1. SOLUTIONS GRID — 2×2 ibox (sprinkler-page §1, white)
         ══════════════════════════════════════════════════════════ -->
    <section class="sol">
      <div class="sol__left">
        <div class="sol__sticky">
          <div class="av-dblh__subtitle rr-reveal">
            <span class="divider-icon" set:html={diamondIcon} />
            <span>What Fire Alarm Service Covers</span>
          </div>
          <h2 class="sol__title rr-reveal" data-reveal-delay="100">
            <span>Service &amp; Systems</span>
            <span>Modifications – Replacement</span>
            <span>&amp; 24/7 Response.</span>
          </h2>
          <div class="sol__spacer" aria-hidden="true"></div>
          <div class="sol__cta rr-reveal" data-reveal-delay="200">
            <a href="/contact" class="av-wgl-btn av-wgl-btn--outline">
              <span class="av-wgl-btn__text">Schedule Site Visit to Receive Complimentary Quote</span>
              <span class="av-wgl-btn__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg>
              </span>
            </a>
          </div>
        </div>
      </div>

      <div class="sol__grid">
        {categories.map((c, i) => (
          <a href="/contact" class="ibox rr-reveal" data-icon-slot={i} data-reveal-delay={i * 100}>
            <span class="ibox__bg" aria-hidden="true"></span>
            <span class="ibox__icon" aria-hidden="true">
              <iconify-icon icon={c.icon} width="50" height="50"></iconify-icon>
            </span>
            <span class="ibox__content">
              <h3 class="ibox__title">{c.title}</h3>
              <span class="ibox__text">{c.body}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════
         §2. WHY RED ROCKS — tan bg image + gradient overlay
            (sprinkler-page §2 pattern)
         ══════════════════════════════════════════════════════════ -->
    <section class="fa-whyrr rr-band rr-band--reveal-top">
      <div class="fa-whyrr__bg" aria-hidden="true"></div>
      <div class="fa-whyrr__overlay" aria-hidden="true"></div>
      <div class="rr-container fa-container">
        <div class="fa-why-grid">
          <div class="fa-why-grid__left">
            <p class="rr-eyebrow fa-whyrr__eyebrow mb-5 rr-reveal">Why Red Rocks Fire Alarms</p>
            <h2
              class="font-display font-black tracking-tight fa-whyrr__title rr-reveal"
              data-reveal-delay="100"
              style="font-size: clamp(36px, 5vw, 56px); line-height: 1; letter-spacing: -0.04em;"
            >
              <span class="fa-whyrr__title-black">Your Trusted</span>
              <br />
              <span class="fa-whyrr__title-black">Partner for</span>
              <br />
              <span class="fa-whyrr__title-red">Fire Alarm</span>
              <br />
              <span class="fa-whyrr__title-red">Service &amp; Systems.</span>
            </h2>
          </div>

          <div class="fa-why-grid__right">
            <p class="fa-whyrr__body rr-reveal" data-reveal-delay="200" style="font-size: var(--rr-text-lead); line-height: var(--rr-text-lead-lh); margin-top: 0;">
              At Red Rocks Fire Protection Services, we understand that a fire alarm system is far more than a network of panels, detectors, notification devices, and communication equipment. It is one of the most critical life safety systems in your building, providing the early warning occupants need to respond quickly and helping emergency personnel react when every second matters.
            </p>
            <p class="fa-whyrr__body rr-reveal" data-reveal-delay="300" style="font-size: var(--rr-text-lead); line-height: var(--rr-text-lead-lh); margin-top: 1.25rem;">
              Since 2010, Red Rocks Fire Protection Services has proudly served customers throughout Colorado as a trusted, family-owned life safety company. Our purpose is simple: to protect lives and property by simplifying life safety compliance and providing dependable service our clients can trust. Every fire alarm service call, repair, modification, system replacement, and installation is guided by that commitment.
            </p>

            <ul class="fa-whyrr__bullets rr-reveal" data-reveal-delay="400">
              <li class="fa-whyrr__bullet">
                <span class="fa-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[0]} width="20" height="20"></iconify-icon>
                </span>
                <span>Comprehensive fire alarm expertise — from troubleshooting and repairs to system modifications and complete replacements.</span>
              </li>
              <li class="fa-whyrr__bullet">
                <span class="fa-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[1]} width="20" height="20"></iconify-icon>
                </span>
                <span>Code-focused service and solutions designed to support compliance with NFPA 72 and local fire code requirements.</span>
              </li>
              <li class="fa-whyrr__bullet">
                <span class="fa-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[2]} width="20" height="20"></iconify-icon>
                </span>
                <span>Authorized Gamewell-FCI Dealer with factory-trained technicians, authorized programming capabilities, technical support, and access to genuine replacement parts.</span>
              </li>
              <li class="fa-whyrr__bullet">
                <span class="fa-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[3]} width="20" height="20"></iconify-icon>
                </span>
                <span>24/7 emergency response when fire alarm system problems cannot wait.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════
         §3. ACCORDION — 4 panels of service scope
            (sprinkler-page §3 pattern: dark bg image + centered
             white header + white-rectangle accordion cards)
         ══════════════════════════════════════════════════════════ -->
    <section class="fa-accordion">
      <div class="fa-accordion__bg" aria-hidden="true"></div>
      <div class="fa-accordion__overlay" aria-hidden="true"></div>
      <div class="fa-accordion__inner fa-container">
        <div class="fa-accordion__head">
          <p class="av-dblh__subtitle fa-accordion__eyebrow rr-reveal">
            <span class="fa-accordion__rule" aria-hidden="true"></span>
            <span>How We Serve</span>
            <span class="fa-accordion__rule" aria-hidden="true"></span>
          </p>
          <h3 class="fa-accordion__title rr-reveal" data-reveal-delay="100">Our Fire Alarm Services.</h3>
          <p class="fa-accordion__intro rr-reveal" data-reveal-delay="200">
            The work breaks into three primary service lines plus the warning signs that replacement may be the right call. Click each panel for the full scope.
          </p>
        </div>

        <div class="acc fa-accordion__list">
          {accordionPanels.map((p, i) => (
            <div class:list={['acc__panel', 'acc__panel--card', 'rr-reveal', p.open && 'is-active']} data-acc-panel data-reveal-delay={i * 100}>
              <button type="button" class="acc__header" aria-expanded={p.open ? 'true' : 'false'}>
                <span class="acc__panel-icon" aria-hidden="true">
                  <iconify-icon icon={accordionIcons[i]} width="22" height="22"></iconify-icon>
                </span>
                <span class="acc__title">{p.title}</span>
                <span class="acc__caret" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor"><path d={arrowPath}></path></svg>
                </span>
              </button>
              <div class="acc__content" hidden={!p.open}>
                <p>{p.body}</p>
                {p.bullets && p.bullets.length > 0 && (
                  <ul class="acc__bullets">
                    {p.bullets.map((b) => (
                      <li class="acc__bullet">
                        <span class="acc__bullet-mark" aria-hidden="true">▸</span>
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {p.footer && (
                  <p class="acc__footer">{p.footer}</p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════
         §4. GAMEWELL AUTHORIZED DEALER — client-priority section.
            White bg (matches the logo's white background) with dark
            text and a red accent border so it still stands out.
            3 equal columns separated by full-height vertical
            dividers:
              col 1 — headline + description paragraphs
              col 2 — benefits bullet list
              col 3 — Gamewell-FCI logo card
         ══════════════════════════════════════════════════════════ -->
    <section class="fa-gamewell">
      <div class="fa-container fa-gamewell__inner">
        <div class="fa-gamewell__head">
          <h2 class="fa-gamewell__eyebrow rr-reveal">Authorized Gamewell-FCI Dealer</h2>
        </div>

        <div class="fa-gamewell__grid">
          <div class="fa-gamewell__col fa-gamewell__col--copy rr-reveal" data-reveal-delay="100">
            <h3 class="fa-gamewell__title">
              Factory-Trained.<br />
              Factory-Backed. <span class="fa-gamewell__title-red">Authorized.</span>
            </h3>
            <p class="fa-gamewell__body">
              Red Rocks Fire Protection is proud to be an Authorized Gamewell-FCI Dealer, providing our customers with access to one of the most respected fire alarm manufacturers in the industry.
            </p>
            <p class="fa-gamewell__body">
              As an authorized dealer, our technicians receive factory training and support directly from Gamewell-FCI, allowing us to properly design, install, program, service, and maintain Gamewell systems. We have access to factory-authorized programming software, technical support, replacement parts, and the latest product updates.
            </p>
            <p class="fa-gamewell__body fa-gamewell__body--closer">
              Whether you need service on an existing Gamewell system or are considering a new fire alarm installation, Red Rocks Fire Protection has the expertise and factory backing to support your facility.
            </p>
          </div>

          <div class="fa-gamewell__col fa-gamewell__col--benefits rr-reveal" data-reveal-delay="200">
            <h3 class="fa-gamewell__benefits-title">Benefits of Working with a Gamewell Authorized Dealer</h3>
            <ul class="fa-gamewell__benefits">
              <li class="fa-gamewell__benefit"><span aria-hidden="true">▸</span><span>Factory-trained technicians</span></li>
              <li class="fa-gamewell__benefit"><span aria-hidden="true">▸</span><span>Authorized programming capabilities</span></li>
              <li class="fa-gamewell__benefit"><span aria-hidden="true">▸</span><span>Access to genuine replacement parts</span></li>
              <li class="fa-gamewell__benefit"><span aria-hidden="true">▸</span><span>Manufacturer technical support</span></li>
              <li class="fa-gamewell__benefit"><span aria-hidden="true">▸</span><span>System design assistance</span></li>
              <li class="fa-gamewell__benefit"><span aria-hidden="true">▸</span><span>Warranty support</span></li>
              <li class="fa-gamewell__benefit"><span aria-hidden="true">▸</span><span>Code-compliant installations</span></li>
              <li class="fa-gamewell__benefit"><span aria-hidden="true">▸</span><span>Long-term system support</span></li>
            </ul>
          </div>

          <div class="fa-gamewell__col fa-gamewell__col--logo rr-reveal" data-reveal-delay="300">
            <div class="fa-gamewell__logo-card">
              <img
                src="/images/rrfps-fci-gamewell-logo.webp"
                alt="Gamewell-FCI — Authorized Dealer"
                loading="lazy"
                decoding="async"
                class="fa-gamewell__logo"
              />
              <span class="fa-gamewell__logo-caption">Authorized Dealer</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════
         §5. MORE THAN A FIRE ALARM CONTRACTOR
            (white-bg SplitPanel rhythm — 3 paragraphs, image right)
         ══════════════════════════════════════════════════════════ -->
    <section class="fa-splitpanel bg-rr-white rr-band rr-band--reveal-top">
      <div class="rr-container fa-container">
        <div class="grid gap-10 md:gap-12 lg:gap-16 items-center md:grid-cols-2">
          <div class="order-2 md:order-1">
            <p class="rr-eyebrow mb-5 text-rr-grey rr-reveal">How We Work</p>
            <h2 class="font-display font-black uppercase tracking-tight rr-reveal" data-reveal-delay="100" style="font-size: var(--rr-text-section); line-height: 0.95;">
              More Than a Fire Alarm Contractor.
            </h2>
            <div class="mt-6 rr-reveal fa-split-body" data-reveal-delay="200">
              <p>While many companies can repair or replace fire alarm equipment, Red Rocks Fire Protection Services takes a different approach. We believe our responsibility extends well beyond completing a service call.</p>
