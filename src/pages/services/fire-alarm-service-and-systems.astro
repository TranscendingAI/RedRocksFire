<script>
  /**
   * Accordion toggle for the §3 "Our Fire Alarm Services" section.
   * Same defensive binding pattern as the fire-sprinkler page:
   * one panel open at a time; clicking the open panel closes it.
   *
   * IMPORTANT: kept to plain JavaScript (no TypeScript casts) — the
   * previous `(header as any)` TS syntax compiled fine in the
   * production Rollup build but was silently dropped by the dev
   * server's esbuild transform, leaving the accordion dead in dev.
   * Re-registers on astro:page-load / after-swap / DOMContentLoaded
   * so View Transitions navigations get wired too.
   */
  function initFireAlarmAccordion() {
    var panels = Array.prototype.slice.call(document.querySelectorAll('[data-acc-panel]'));
    if (!panels.length) return false;
    panels.forEach(function (panel) {
      var header = panel.querySelector('.acc__header');
      var content = panel.querySelector('.acc__content');
      if (!header || !content) return;
      if (header.__faAccordionWired) return;
      header.__faAccordionWired = true;
      header.addEventListener('click', function () {
        var wasOpen = panel.classList.contains('is-active');
        panels.forEach(function (p) {
          p.classList.remove('is-active');
          var h = p.querySelector('.acc__header');
          if (h) h.setAttribute('aria-expanded', 'false');
          var c = p.querySelector('.acc__content');
          if (c) c.hidden = true;
        });
        if (!wasOpen) {
          panel.classList.add('is-active');
          header.setAttribute('aria-expanded', 'true');
          content.hidden = false;
        }
      });
    });
    return true;
  }

  function bindFireAlarmAccordion() {
    if (!initFireAlarmAccordion()) {
      setTimeout(initFireAlarmAccordion, 100);
    }
  }

  document.addEventListener('astro:page-load', bindFireAlarmAccordion);
  document.addEventListener('astro:after-swap', bindFireAlarmAccordion);
  document.addEventListener('DOMContentLoaded', bindFireAlarmAccordion);
  if (document.readyState !== 'loading') bindFireAlarmAccordion();

  /**
   * Entrance-animation support for the fire-alarm page.
   *
   * 1. STAGGER — the global reveal system (BaseLayout's Intersection-
   *    Observer on .rr-reveal) never consumes the data-reveal-delay
   *    attribute this page sets on its elements. This script copies
   *    each value into a --reveal-delay CSS custom property (consumed
   *    by the scoped transition-delay rule above) and clears it once
   *    the element has entered, so hover transitions stay instant.
   *
   * 2. SHARED COMPONENTS — IndustriesGrid and ClosingCTA are shared
   *    files used verbatim across the site, so instead of editing
   *    them this script animates their top-level blocks at runtime,
   *    on this page only: the industries section head + its 15 cards
   *    (staggered), and the ClosingCTA body copy.
   *
   * All plain JS (no TS casts) so the dev server's esbuild transform
   * doesn't drop the module.
   */
  function initFireAlarmRevealStagger() {
    // 1. Copy data-reveal-delay → --reveal-delay on page-owned elements.
    document.querySelectorAll('.rr-reveal[data-reveal-delay]').forEach(function (el) {
      el.style.setProperty('--reveal-delay', el.getAttribute('data-reveal-delay') + 'ms');
    });

    // 2. Animate the shared IndustriesGrid on this page only.
    var industries = document.querySelector('section.industries');
    if (industries && !industries.classList.contains('rr-reveal')) {
      var indHead = industries.querySelector('.industries__head');
      if (indHead) {
        indHead.classList.add('rr-reveal');
      }
      var cards = industries.querySelectorAll('.industry-card');
      cards.forEach(function (card, i) {
        card.classList.add('rr-reveal');
        card.setAttribute('data-reveal-delay', String(Math.min(i, 8) * 80));
        card.style.setProperty('--reveal-delay', Math.min(i, 8) * 80 + 'ms');
      });
    }

    // 3. Animate the shared ClosingCTA body on this page only.
    var ctaBody = document.querySelector('.cta__body');
    if (ctaBody && !ctaBody.classList.contains('rr-reveal')) {
      ctaBody.classList.add('rr-reveal');
    }

    /* 3b. The global reveal observer (BaseLayout) registers its
     * astro:page-load listener BEFORE this script, so it never sees
     * the .rr-reveal classes added to the shared components above.
     * Observe any not-yet-visible reveal element with a matching
     * observer (same threshold/rootMargin) so nothing stays hidden.
     * Idempotent: elements already handled by the global observer
     * are .is-visible and skipped here. */
    var pending = document.querySelectorAll('.rr-reveal:not(.is-visible)');
    if (pending.length) {
      var pageObserver = new IntersectionObserver(function (entries) {
        for (var i = 0; i < entries.length; i++) {
          if (entries[i].isIntersecting) {
            entries[i].target.classList.add('is-visible');
            pageObserver.unobserve(entries[i].target);
          }
        }
      }, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });
      pending.forEach(function (el) { pageObserver.observe(el); });
    }

    // 4. Clean up delays once elements have entered, so hover
    //    transitions (ibox bg, accordion shadow, buttons) are
    //    instant after the entrance finishes. Watch for both the
    //    page-owned elements and the ones added above.
    document.querySelectorAll('.rr-reveal').forEach(function (el) {
      if (el.classList.contains('is-visible')) {
        el.style.removeProperty('--reveal-delay');
        return;
      }
      // Fires once, when the global observer adds .is-visible.
      var cleanup = new MutationObserver(function () {
        if (el.classList.contains('is-visible')) {
          el.style.removeProperty('--reveal-delay');
          cleanup.disconnect();
        }
      });
      cleanup.observe(el, { attributes: true, attributeFilter: ['class'] });
    });
  }

  function bindFireAlarmReveal() {
    initFireAlarmRevealStagger();
  }

  document.addEventListener('astro:page-load', bindFireAlarmReveal);
  document.addEventListener('DOMContentLoaded', bindFireAlarmReveal);
  if (document.readyState !== 'loading') bindFireAlarmReveal();
</script>