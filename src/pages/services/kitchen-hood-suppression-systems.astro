---
/**
 * Kitchen Hood Suppression Systems — RRFPS landing page for
 * /services/kitchen-hood-suppression-systems/.
 *
 * Layout cloned 1:1 from fire-sprinkler-service-and-systems.astro
 * (per Zack's direction) with the copy swapped verbatim from
 * reference/content/rrfps-9-service-pages-with-why-red-rocks-sections.md
 * (Page 6 — Kitchen Hood Suppression Systems).
 *
 * Sections, in order:
 *   0. ptbanner
 *   1. 2×2 ibox grid (4 kitchen hood service categories)
 *   2. `kh-whyrr` tan bg-image intro band
 *   3. 3-panel accordion (Inspection & Testing / Service & Repair /
 *      Modifications — the .md H2s)
 *   4. SplitPanel — More Than a Service Contractor
 *   5. SplitPanel — Advocacy (#DBDADA bg)
 *   6. Why Clients Stay — dark bg + 5 value cards
 *   7. SplitPanel — Experience (white bg)
 *   8. SplitPanel — Ready When You Are. (#DBDADA bg)
 *   9. IndustriesGrid (shared)
 *  10. ClosingCTA (shared, kitchen-hood-themed paragraph)
 *
 * Image assets — all placeholders, to be swapped for page-specific
 * Nano Banana imagery after the batch build:
 *   • Hero           — /images/rrfps-fire-sprinkler-systems-hero.jpg
 *   • §2 tan band bg — /images/red-rocks-fire-alarm-why-bg.jpg
 *   • §3 accordion bg — /images/red-rocks-fire-alarm-accordion-bg.jpg
 *   • §4 more than    — /images/rrfps-fa-more-than-contractor.jpg
 *   • §5 advocacy     — /images/rrfps-fa-advocacy.jpg
 *   • §6 values bg    — /images/rrfps-fa-why-clients-stay-bg.jpg
 *   • §7 experience   — /images/rrfps-fa-experience.jpg
 *   • §8 promise      — /images/rrfps-fa-promise.jpg
 *   • ClosingCTA bg   — /images/rrfps-services-cta-bg.png
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import IndustriesGrid from '../../components/IndustriesGrid.astro';

const arrowPath = 'M0 6.78247C0 6.52555 0.102065 6.27914 0.283741 6.09746C0.465416 5.91579 0.711822 5.81372 0.96875 5.81372H12.1927L8.03288 1.65585C7.85097 1.47394 7.74878 1.22723 7.74878 0.969974C7.74878 0.712721 7.85097 0.466004 8.03288 0.284099C8.21478 0.102194 8.4615 0 8.71875 0C8.976 0 9.22272 0.102194 9.40463 0.284099L15.2171 6.0966C15.3073 6.18659 15.3789 6.29349 15.4278 6.41118C15.4766 6.52888 15.5017 6.65505 15.5017 6.78247C15.5017 6.9099 15.4766 7.03607 15.4278 7.15376C15.3789 7.27146 15.3073 7.37836 15.2171 7.46835L9.40463 13.2808C9.22272 13.4628 8.976 13.5649 8.71875 13.5649C8.4615 13.5649 8.21478 13.4628 8.03288 13.2808C7.85097 13.0989 7.74878 12.8522 7.74878 12.595C7.74878 12.3377 7.85097 12.091 8.03288 11.9091L12.1927 7.75122H0.96875C0.711822 7.75122 0.465416 7.64916 0.283741 7.46748C0.102065 7.28581 0 7.0394 0 6.78247Z';

const diamondIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="20" viewBox="0 0 15 20"><path d="M0.660472 19.6191L0.47542 6.53585L13.7437 19.8041L0.660472 19.6191Z"></path><path d="M14.3396 0.939992L14.5246 14.0232L1.25635 0.754941L14.3396 0.939992Z"></path></svg>';

const bannerImage = '/images/rrfps-fire-sprinkler-systems-hero.jpg';

const categories = [
  {
    title: 'Annual Inspection & Testing.',
    icon: 'mdi:silverware-fork-knife',
    body: 'Routine semiannual inspection and testing services for wet chemical, dry chemical, and CO2 kitchen suppression systems to verify proper operation and code compliance.',
  },
  {
    title: 'Service & Repair.',
    icon: 'mdi:wrench',
    body: 'Service and repair solutions for commercial kitchen fire suppression systems — pressure verification, nozzle replacement, fusible link replacement, cylinder recharging, and system troubleshooting.',
  },
  {
    title: 'System Modifications.',
    icon: 'mdi:tune',
    body: 'Professional modifications to existing kitchen suppression systems to match cooking equipment changes, hood changes, and remodel requirements — including nozzle relocation, repositioning, and updated hazard coverage.',
  },
  {
    title: 'New Installations.',
    icon: 'mdi:package-variant-closed',
    body: 'New kitchen fire suppression system installations for restaurants, commercial kitchens, food trucks, and other cooking operations — designed to fit your specific cooking equipment and fire protection requirements.',
  },
] as const;

const bulletIcons = [
  'mdi:check-decagram-outline',         // Annual inspection/testing
  'mdi:wrench-outline',                  // Service & repair
  'mdi:tune-variant',                    // Modifications
  'mdi:shield-check-outline',            // New installations
] as const;

const accordionIcons = [
  'mdi:silverware-fork-knife',         // Inspection & Testing
  'mdi:wrench',                         // Service & Repair
  'mdi:tune',                           // Modifications
] as const;

const accordionPanels = [
  {
    title: 'Kitchen Hood Inspection & Testing',
    body: 'A commercial kitchen fire suppression system must be ready to respond when needed. Routine semiannual inspection and testing are required to confirm proper operation, verify compliance, and identify any components that need to be serviced or replaced. Red Rocks Fire Protection provides complete inspection and testing services for wet chemical, dry chemical, and CO2 kitchen hood fire suppression systems throughout Colorado.',
    bullets: [
      'Semiannual fire suppression system inspections',
      'Inspection and testing of all system components',
      'Verification of proper operation',
      'Pressure gauge inspections',
      'Fusible link and detection inspections',
      'Nozzle inspection and alignment',
      'Manual pull station testing',
      'Cylinder pressure verification',
      'Fuel shut-off verification',
      'Hood and duct inspections',
      'Deficiency identification and reporting',
    ],
    open: false,
  },
  {
    title: 'Kitchen Hood Service & Repair',
    body: 'Routine maintenance and timely service help ensure that a kitchen fire suppression system will perform reliably during an emergency. Our service and repair solutions for commercial kitchen fire suppression systems include a full range of maintenance and replacement services designed to keep your system operating properly and to support compliance with applicable codes and standards.',
    bullets: [
      'Pressure gauge replacement',
      'Nozzle replacement and cleaning',
      'Fusible link replacement',
      'Cylinder recharging and replacement',
      'Hose and piping replacement',
      'Detection system service',
      'Manual pull station replacement',
      'Equipment shut-down verification and service',
      'Emergency service response',
    ],
    open: false,
  },
  {
    title: 'Kitchen Hood System Modifications',
    body: 'As kitchen operations evolve, cooking equipment is replaced, hoods are upgraded, and cooking lines are reconfigured. When changes occur, the existing suppression system often needs to be modified to maintain proper coverage and code compliance. Red Rocks Fire Protection provides professional kitchen suppression system modifications to match your updated layout and equipment.',
    bullets: [
      'Cooking equipment change-out coordination',
      'Hood replacements and upgrades',
      'Nozzle relocation',
      'Nozzle repositioning',
      'Cylinder relocation',
      'Piping modifications',
      'Detection system modifications',
      'Kitchen expansions and remodels',
      'Compliance upgrades',
    ],
    footer: 'Common Signs a System May Need Modification: new cooking appliances, rearranged cooking line, hood replacement, equipment that exceeds original system design, regulatory changes, or changes in the type of cooking being performed.',
    open: false,
  },
] as const;

const whyClientsIcons = [
  'solar:shield-check-bold-duotone',
  'solar:hand-heart-bold-duotone',
  'solar:rocket-2-bold-duotone',
  'solar:medal-ribbon-star-bold-duotone',
  'solar:users-group-rounded-bold-duotone',
] as const;

const whyClientsValues = [
  { title: 'We lead with safety.', body: 'Protecting lives and property is both our responsibility and our privilege.' },
  { title: 'We advocate for our clients.', body: 'We stay ahead of changing requirements and help simplify compliance.' },
  { title: 'We go the extra mile.', body: 'We take ownership of every project until the job is completed correctly.' },
  { title: 'We demonstrate character.', body: 'Integrity, professionalism, accountability, and respect guide every interaction.' },
  { title: 'And we operate as one family.', body: 'We support one another while building lasting partnerships with every client we serve.' },
] as const;

const moreThanImage = '/images/rrfps-fa-more-than-contractor.jpg';
const advocacyImage = '/images/rrfps-fa-advocacy.jpg';
const experienceImage = '/images/rrfps-fa-experience.jpg';
const promiseImage = '/images/rrfps-fa-promise.jpg';
---

<BaseLayout
  title="Kitchen Hood Suppression Systems | Red Rocks Fire Protection | Colorado"
  description="Inspection, service, repair, modifications, and new installations for commercial kitchen hood fire suppression systems throughout Colorado. Wet chemical, dry chemical, and CO2 systems — semiannual inspection and testing, nozzle replacement, fusible link service, cylinder recharging, and system modifications for remodels and equipment changes."
>
  <div class="av-page">

    <!-- §0. PAGE-TITLE BANNER -->
    <div class="ptbanner">
      <div class="ptbanner__bg" style={`background-image: url('${bannerImage}');`} aria-hidden="true"></div>
      <div class="ptbanner__overlay" aria-hidden="true"></div>
      <div class="ptbanner__inner">
        <h1 class="ptbanner__title rr-reveal">Kitchen Hood Suppression Systems</h1>
        <div class="ptbanner__breadcrumbs rr-reveal" data-reveal-delay="100">
          <a href="/">Home</a>
          <span class="ptbanner__divider">-</span>
          <a href="/services">Services</a>
          <span class="ptbanner__divider">-</span>
          <span class="ptbanner__current">Kitchen Hood Suppression Systems</span>
        </div>
      </div>
    </div>

    <!-- §1. SOLUTIONS GRID — 2×2 ibox -->
    <section class="sol">
      <div class="sol__left">
        <div class="sol__sticky">
          <div class="av-dblh__subtitle rr-reveal">
            <span class="divider-icon" set:html={diamondIcon} />
            <span>What Kitchen Hood Service Covers</span>
          </div>
          <h2 class="sol__title rr-reveal" data-reveal-delay="100">
            <span>Inspection –</span>
            <span>Service, Repair &amp;</span>
            <span>Modifications &amp; New Installs.</span>
          </h2>
          <div class="sol__spacer" aria-hidden="true"></div>
          <div class="sol__cta rr-reveal" data-reveal-delay="200">
            <a href="/contact" class="av-wgl-btn av-wgl-btn--outline">
              <span class="av-wgl-btn__text">Schedule Site Visit to Receive Complimentary Quote</span>
              <span class="av-wgl-btn__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg>
              </span>
            </a>
          </div>
        </div>
      </div>

      <div class="sol__grid">
        {categories.map((c, i) => (
          <a href="/contact" class="ibox rr-reveal" data-icon-slot={i} data-reveal-delay={i * 100}>
            <span class="ibox__bg" aria-hidden="true"></span>
            <span class="ibox__icon" aria-hidden="true">
              <iconify-icon icon={c.icon} width="50" height="50"></iconify-icon>
            </span>
            <span class="ibox__content">
              <h3 class="ibox__title">{c.title}</h3>
              <span class="ibox__text">{c.body}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- §2. WHY RED ROCKS — tan bg image + gradient overlay -->
    <section class="kh-whyrr rr-band rr-band--reveal-top">
      <div class="kh-whyrr__bg" aria-hidden="true"></div>
      <div class="kh-whyrr__overlay" aria-hidden="true"></div>
      <div class="rr-container kh-container">
        <div class="kh-why-grid">
          <div class="kh-why-grid__left">
            <p class="rr-eyebrow kh-whyrr__eyebrow mb-5 rr-reveal">Why Red Rocks Kitchen Hood</p>
            <h2
              class="font-display font-black tracking-tight kh-whyrr__title rr-reveal"
              data-reveal-delay="100"
              style="font-size: clamp(36px, 5vw, 56px); line-height: 1; letter-spacing: -0.04em;"
            >
              <span class="kh-whyrr__title-black">Commercial Kitchen</span>
              <br />
              <span class="kh-whyrr__title-black">Protection That</span>
              <br />
              <span class="kh-whyrr__title-red">Adapts to Your</span>
              <br />
              <span class="kh-whyrr__title-red">Operations.</span>
            </h2>
          </div>

          <div class="kh-why-grid__right">
            <p class="kh-whyrr__body rr-reveal" data-reveal-delay="200" style="font-size: var(--rr-text-lead); line-height: var(--rr-text-lead-lh); margin-top: 0;">
              Commercial kitchen operations are dynamic. Cooking equipment changes, hoods are upgraded, menus evolve, and kitchen layouts shift. At Red Rocks Fire Protection Services, we understand that a kitchen fire suppression system must be regularly inspected, properly maintained, and updated as the kitchen itself changes.
            </p>
            <p class="kh-whyrr__body rr-reveal" data-reveal-delay="300" style="font-size: var(--rr-text-lead); line-height: var(--rr-text-lead-lh); margin-top: 1.25rem;">
              Since 2010, our family-owned company has provided dependable life safety service to restaurants, hospitality, healthcare kitchens, educational kitchens, and other commercial operations throughout Colorado. Our kitchen hood services are designed to keep your suppression system ready, compliant, and aligned with the way your kitchen actually operates.
            </p>

            <ul class="kh-whyrr__bullets rr-reveal" data-reveal-delay="400">
              <li class="kh-whyrr__bullet">
                <span class="kh-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[0]} width="20" height="20"></iconify-icon>
                </span>
                <span>Semiannual inspection and testing of all suppression system components for wet chemical, dry chemical, and CO2 systems.</span>
              </li>
              <li class="kh-whyrr__bullet">
                <span class="kh-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[1]} width="20" height="20"></iconify-icon>
                </span>
                <span>Pressure verification, nozzle replacement, fusible link service, hose and piping replacement, cylinder recharging, and emergency service.</span>
              </li>
              <li class="kh-whyrr__bullet">
                <span class="kh-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[2]} width="20" height="20"></iconify-icon>
                </span>
                <span>Modifications for equipment changes, hood upgrades, kitchen expansions, remodels, and compliance upgrades.</span>
              </li>
              <li class="kh-whyrr__bullet">
                <span class="kh-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[3]} width="20" height="20"></iconify-icon>
                </span>
                <span>New kitchen suppression system installations tailored to specific cooking equipment and fire protection requirements.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- §3. ACCORDION — 3 panels (the .md H2s) -->
    <section class="kh-accordion">
      <div class="kh-accordion__bg" aria-hidden="true"></div>
      <div class="kh-accordion__overlay" aria-hidden="true"></div>
      <div class="kh-accordion__inner kh-container">
        <div class="kh-accordion__head">
          <p class="av-dblh__subtitle kh-accordion__eyebrow rr-reveal">
            <span class="kh-accordion__rule" aria-hidden="true"></span>
            <span>How We Serve</span>
            <span class="kh-accordion__rule" aria-hidden="true"></span>
          </p>
          <h3 class="kh-accordion__title rr-reveal" data-reveal-delay="100">Our Kitchen Hood Services.</h3>
          <p class="kh-accordion__intro rr-reveal" data-reveal-delay="200">
            Click each panel for the full scope of our inspection, service, and modification services.
          </p>
        </div>

        <div class="acc kh-accordion__list">
          {accordionPanels.map((p, i) => (
            <div class:list={['acc__panel', 'acc__panel--card', 'rr-reveal', p.open && 'is-active']} data-acc-panel data-reveal-delay={i * 100}>
              <button type="button" class="acc__header" aria-expanded={p.open ? 'true' : 'false'}>
                <span class="acc__panel-icon" aria-hidden="true">
                  <iconify-icon icon={accordionIcons[i]} width="22" height="22"></iconify-icon>
                </span>
                <span class="acc__title">{p.title}</span>
                <span class="acc__caret" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor"><path d={arrowPath}></path></svg>
                </span>
              </button>
              <div class="acc__content" hidden={!p.open}>
                <p>{p.body}</p>
                {p.bullets && p.bullets.length > 0 && (
                  <ul class="acc__bullets">
                    {p.bullets.map((b) => (
                      <li class="acc__bullet">
                        <span class="acc__bullet-mark" aria-hidden="true">▸</span>
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {p.footer && (
                  <p class="acc__footer">{p.footer}</p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- §4. MORE THAN A SERVICE CONTRACTOR -->
    <section class="kh-splitpanel bg-rr-white rr-band rr-band--reveal-top">
      <div class="rr-container kh-container">
        <div class="grid gap-10 md:gap-12 lg:gap-16 items-center md:grid-cols-2">
          <div class="order-2 md:order-1">
            <p class="rr-eyebrow mb-5 text-rr-grey rr-reveal">How We Work</p>
            <h2 class="font-display font-black uppercase tracking-tight rr-reveal" data-reveal-delay="100" style="font-size: var(--rr-text-section); line-height: 0.95;">
              More Than a Service Contractor.
            </h2>
            <div class="mt-6 rr-reveal kh-split-body" data-reveal-delay="200">
              <p>Our team supports clients with a full understanding of how a kitchen suppression system connects to hoods, ducts, cooking equipment, fuel shut-off valves, and the overall operation of the kitchen. When a system needs service, repair, or modification, we look at the full picture so the system continues to provide proper coverage and remains aligned with applicable code requirements.</p>
            </div>
            <div class="mt-8 rr-reveal" data-reveal-delay="240">
              <a href="/services" class="av-wgl-btn av-wgl-btn--outline">
                <span class="av-wgl-btn__text">See All Services</span>
                <span class="av-wgl-btn__icon">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg>
                </span>
              </a>
            </div>
          </div>
          <div class="order-1 md:order-2 rr-reveal" data-reveal-delay="300">
            <div class="overflow-hidden rounded-rr-card aspect-[4/3] bg-rr-bg-panel">
              <img src={moreThanImage} alt="Red Rocks Fire Protection technician working alongside a kitchen manager on suppression system details" loading="lazy" decoding="async" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- §5. ADVOCACY — #DBDADA bg panel -->
    <section class="kh-edge rr-band rr-band--reveal-top">
      <div class="rr-container kh-container">
        <div class="grid gap-10 md:gap-12 lg:gap-16 items-center md:grid-cols-2">
          <div class="order-2 md:order-1">
            <p class="rr-eyebrow mb-5 kh-edge__eyebrow rr-reveal">Our Edge</p>
            <h2
              class="font-display font-black uppercase tracking-tight rr-reveal kh-edge__title"
              data-reveal-delay="100"
              style="font-size: var(--rr-text-section); line-height: 0.95;"
            >
              Advocacy That Protects Your People, Property &amp; Investment.
            </h2>
            <div class="mt-6 rr-reveal kh-edge__body" data-reveal-delay="200">
              <p>Kitchen operations are rarely static. Our advocacy means helping clients understand how new equipment, hood upgrades, or operational changes affect the suppression system and what to do about it. We work to identify issues early, recommend practical solutions, and help avoid the more costly path of correcting a deficiency, a failed inspection, or a system that no longer matches the cooking line.</p>
            </div>
          </div>
          <div class="order-1 md:order-2 kh-edge-img rr-reveal" data-reveal-delay="300">
            <div class="overflow-hidden rounded-rr-card bg-rr-black kh-edge-img__wrap">
              <img
                src={advocacyImage}
                alt="Red Rocks Fire Protection advocating for the right kitchen suppression path as the client's operations evolve"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover kh-edge-img__img"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- §6. WHY CLIENTS STAY — dark bg + 5 value cards -->
    <section class="kh-why">
      <div class="kh-why__bg" aria-hidden="true"></div>
      <div class="kh-why__inner">
        <div class="rr-reveal max-w-3xl mb-12 md:mb-16">
          <p class="rr-eyebrow mb-5" style="color: rgba(255,255,255,0.7);">Why Clients Stay</p>
          <h2
            class="font-display font-black uppercase tracking-tight"
            style="font-size: var(--rr-text-section); line-height: 0.95; color: #fff;"
          >
            Why Clients Continue to Choose RRFPS.
          </h2>
          <p class="mt-6" style="font-size: var(--rr-text-lead); color: rgba(255,255,255,0.9);">
            Everything we do is built upon the values that have guided our company since its founding. These principles are reflected in our Brand Promise: we communicate clearly, we honor our commitments, we arrive prepared, we respond when it matters most, we price fairly, we stand behind our work, and we remain committed until every issue has been fully resolved.
          </p>
        </div>

        <div class="grid gap-4 md:gap-6 sm:grid-cols-2 lg:grid-cols-5">
          {whyClientsValues.map((v, i) => (
            <article class="rr-reveal kh-flowcard rounded-rr-card p-6 flex flex-col" data-reveal-delay={i * 100}>
              <span class="kh-flowcard__icon" aria-hidden="true">
                <iconify-icon icon={whyClientsIcons[i]} width="40" height="40"></iconify-icon>
              </span>
              <h3 class="font-display font-bold tracking-tight" style="font-size: var(--rr-text-card); line-height: 1.05; color: #fff;">
                {v.title}
              </h3>
              <p class="mt-3 leading-relaxed flex-1" style="font-size: var(--rr-text-lead); color: rgba(255,255,255,0.85);">
                {v.body}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- §7. EXPERIENCE — white-bg SplitPanel -->
    <section class="kh-splitpanel bg-rr-white rr-band rr-band--reveal-top">
      <div class="rr-container kh-container">
        <div class="grid gap-10 md:gap-12 lg:gap-16 items-center md:grid-cols-2">
          <div class="order-2 md:order-1">
            <p class="rr-eyebrow mb-5 text-rr-grey rr-reveal">Experience</p>
            <h2 class="font-display font-black uppercase tracking-tight rr-reveal" data-reveal-delay="100" style="font-size: var(--rr-text-section); line-height: 0.95;">
              Kitchen Hood Suppression Experience You Can Trust.
            </h2>
            <div class="mt-6 rr-reveal kh-split-body" data-reveal-delay="200">
              <p>Our technicians understand how suppression systems connect to cooking equipment, hoods, ducts, fusible links, detection, manual pull stations, and fuel shut-off valves. We support wet chemical, dry chemical, and CO2 systems, providing inspection, service, repair, modification, and new installation support that helps clients maintain reliable kitchen fire protection as their operations evolve.</p>
            </div>
          </div>
          <div class="order-1 md:order-2 rr-reveal" data-reveal-delay="300">
            <div class="overflow-hidden rounded-rr-card aspect-[4/3] bg-rr-bg-panel">
              <img src={experienceImage} alt="Red Rocks Fire Protection experienced kitchen hood suppression technician servicing a system" loading="lazy" decoding="async" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- §8. READY WHEN YOU ARE — #DBDADA bg panel -->
    <section class="kh-splitpanel kh-promise rr-band rr-band--reveal-top">
      <div class="rr-container kh-container">
        <div class="grid gap-10 md:gap-12 lg:gap-16 items-center md:grid-cols-2">
          <div class="order-2 md:order-1">
            <p class="rr-eyebrow mb-5 kh-promise__eyebrow rr-reveal">Our Promise</p>
            <h2 class="font-display font-black uppercase tracking-tight rr-reveal" data-reveal-delay="100" style="font-size: var(--rr-text-section); line-height: 0.95;">
              Ready When You Are.
            </h2>
            <div class="mt-6 rr-reveal kh-promise__body" data-reveal-delay="200">
