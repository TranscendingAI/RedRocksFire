---
/**
 * 24-Hour Emergency Service — RRFPS landing page for
 * /services/24-hour-service/.
 *
 * Layout cloned 1:1 from fire-sprinkler-service-and-systems.astro
 * (per Zack's direction) with the copy swapped verbatim from
 * reference/content/rrfps-9-service-pages-with-why-red-rocks-sections.md
 * (Page 9 — 24-Hour Emergency Service).
 *
 * Sections, in order:
 *   0. ptbanner
 *   1. 2×2 ibox grid (4 emergency service categories)
 *   2. `es-whyrr` tan bg-image intro band
 *   3. 3-panel accordion (Emergency Services We Provide / Common
 *      Emergency Service Calls / Fire Watch & Impairment Support —
 *      the .md H2s)
 *   4. SplitPanel — More Than a Service Contractor
 *   5. SplitPanel — Advocacy (#DBDADA bg)
 *   6. Why Clients Stay — dark bg + 5 value cards
 *   7. SplitPanel — Experience (white bg)
 *   8. SplitPanel — Ready When You Are. (#DBDADA bg)
 *   9. IndustriesGrid (shared)
 *  10. ClosingCTA (shared, emergency-service-themed paragraph)
 *
 * Image assets — all placeholders, to be swapped for page-specific
 * Nano Banana imagery after the batch build:
 *   • Hero           — /images/rrfps-fire-sprinkler-systems-hero.jpg
 *   • §2 tan band bg — /images/red-rocks-fire-alarm-why-bg.jpg
 *   • §3 accordion bg — /images/red-rocks-fire-alarm-accordion-bg.jpg
 *   • §4 more than    — /images/rrfps-fa-more-than-contractor.jpg
 *   • §5 advocacy     — /images/rrfps-fa-advocacy.jpg
 *   • §6 values bg    — /images/rrfps-fa-why-clients-stay-bg.jpg
 *   • §7 experience   — /images/rrfps-fa-experience.jpg
 *   • §8 promise      — /images/rrfps-fa-promise.jpg
 *   • ClosingCTA bg   — /images/rrfps-services-cta-bg.png
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import IndustriesGrid from '../../components/IndustriesGrid.astro';

const arrowPath = 'M0 6.78247C0 6.52555 0.102065 6.27914 0.283741 6.09746C0.465416 5.91579 0.711822 5.81372 0.96875 5.81372H12.1927L8.03288 1.65585C7.85097 1.47394 7.74878 1.22723 7.74878 0.969974C7.74878 0.712721 7.85097 0.466004 8.03288 0.284099C8.21478 0.102194 8.4615 0 8.71875 0C8.976 0 9.22272 0.102194 9.40463 0.284099L15.2171 6.0966C15.3073 6.18659 15.3789 6.29349 15.4278 6.41118C15.4766 6.52888 15.5017 6.65505 15.5017 6.78247C15.5017 6.9099 15.4766 7.03607 15.4278 7.15376C15.3789 7.27146 15.3073 7.37836 15.2171 7.46835L9.40463 13.2808C9.22272 13.4628 8.976 13.5649 8.71875 13.5649C8.4615 13.5649 8.21478 13.4628 8.03288 13.2808C7.85097 13.0989 7.74878 12.8522 7.74878 12.595C7.74878 12.3377 7.85097 12.091 8.03288 11.9091L12.1927 7.75122H0.96875C0.711822 7.75122 0.465416 7.64916 0.283741 7.46748C0.102065 7.28581 0 7.0394 0 6.78247Z';

const diamondIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="20" viewBox="0 0 15 20"><path d="M0.660472 19.6191L0.47542 6.53585L13.7437 19.8041L0.660472 19.6191Z"></path><path d="M14.3396 0.939992L14.5246 14.0232L1.25635 0.754941L14.3396 0.939992Z"></path></svg>';

const bannerImage = '/images/rrfps-fire-sprinkler-systems-hero.jpg';

const categories = [
  {
    title: '24/7 Emergency Response.',
    icon: 'mdi:phone-in-talk',
    body: 'Around-the-clock emergency response for fire alarm, sprinkler, backflow, fire pump, suppression, ERRCS, security, and monitoring systems — staffed and ready to dispatch when problems occur.',
  },
  {
    title: 'Diagnostics & Emergency Repair.',
    icon: 'mdi:wrench',
    body: 'Rapid diagnosis, troubleshooting, and emergency repair solutions for impaired life safety systems — including fire alarm troubles, communication failures, ground faults, and system outages.',
  },
  {
    title: 'Impairment & Fire Watch Support.',
    icon: 'mdi:fire-hydrant',
    body: 'System impairment evaluations, fire watch guidance, AHJ coordination, temporary protection planning, and compliance documentation when a life safety system is down.',
  },
  {
    title: 'Restoration & Compliance Follow-Through.',
    icon: 'mdi:shield-check-outline',
    body: 'Restoring system functionality is only the start — we follow through with documentation, post-repair testing, and recommendations so you are not surprised at the next inspection.',
  },
] as const;

const bulletIcons = [
  'mdi:phone-clock',                  // 24/7 response
  'mdi:wrench-outline',                // Diagnostics & repair
  'mdi:fire-hydrant-outline',          // Impairment / fire watch
  'mdi:shield-check-outline',          // Restoration & follow-through
] as const;

const accordionIcons = [
  'mdi:phone-in-talk',                // Emergency Services We Provide
  'mdi:alert-octagon-outline',         // Common Emergency Service Calls
  'mdi:fire-hydrant',                 // Fire Watch & Impairment Support
] as const;

const accordionPanels = [
  {
    title: 'Emergency Services We Provide',
    body: 'Our emergency response team is equipped to diagnose, repair, and restore a wide variety of life safety systems, including:',
    bullets: [
      'Fire Alarm Systems',
      'Fire Sprinkler Systems',
      'Dry Pipe Systems',
      'Fire Pumps',
      'Backflow Preventers',
      'Fire Extinguishers',
      'Kitchen Hood Suppression Systems',
      'ERRCS / BDA Systems',
      'Area of Refuge Communication Systems',
      'Elevator Emergency Communication Systems',
      'Security Systems',
      'Monitoring Communication Failures',
    ],
    open: false,
  },
  {
    title: 'Common Emergency Service Calls',
    body: 'Our technicians regularly respond to emergency situations such as:',
    bullets: [
      'Fire alarm troubles and communication failures',
      'Ground faults and system outages',
      'Broken sprinkler piping',
      'Freeze damage',
      'Activated sprinkler systems',
      'Leaking sprinkler valves',
      'Dry system failures',
      'Fire pump troubles',
      'Backflow preventer failures',
      'Monitoring communication outages',
      'Kitchen hood system impairments',
      'Emergency responder communication system failures',
    ],
    footer: 'Our goal is to restore system functionality quickly while helping property owners maintain compliance and minimize disruption.',
    open: false,
  },
  {
    title: 'Fire Watch & Impairment Support',
    body: 'When a life safety system becomes impaired, building owners may be required to implement temporary protection measures until repairs can be completed. Red Rocks Fire Protection assists clients with the practical and regulatory work of running an impaired property:',
    bullets: [
      'System impairment evaluations',
      'Emergency repair recommendations',
      'Fire watch guidance',
      'Coordination with Authorities Having Jurisdiction (AHJs)',
      'Temporary protection planning',
      'Compliance documentation',
    ],
    open: false,
  },
] as const;

const whyClientsIcons = [
  'solar:shield-check-bold-duotone',
  'solar:hand-heart-bold-duotone',
  'solar:rocket-2-bold-duotone',
  'solar:medal-ribbon-star-bold-duotone',
  'solar:users-group-rounded-bold-duotone',
] as const;

const whyClientsValues = [
  { title: 'We lead with safety.', body: 'Protecting lives and property is both our responsibility and our privilege.' },
  { title: 'We advocate for our clients.', body: 'We stay ahead of changing requirements and help simplify compliance.' },
  { title: 'We go the extra mile.', body: 'We take ownership of every project until the job is completed correctly.' },
  { title: 'We demonstrate character.', body: 'Integrity, professionalism, accountability, and respect guide every interaction.' },
  { title: 'And we operate as one family.', body: 'We support one another while building lasting partnerships with every client we serve.' },
] as const;

const moreThanImage = '/images/rrfps-fa-more-than-contractor.jpg';
const advocacyImage = '/images/rrfps-fa-advocacy.jpg';
const experienceImage = '/images/rrfps-fa-experience.jpg';
const promiseImage = '/images/rrfps-fa-promise.jpg';
---

<BaseLayout
  title="24-Hour Emergency Service | Red Rocks Fire Protection | Colorado"
  description="24/7 emergency response for fire alarm, sprinkler, backflow, fire pump, suppression, ERRCS, area of refuge, elevator, security, and monitoring systems throughout Colorado. Diagnostics, emergency repair, impairment support, fire watch guidance, AHJ coordination, and compliance documentation."
>
  <div class="av-page">

    <!-- §0. PAGE-TITLE BANNER -->
    <div class="ptbanner">
      <div class="ptbanner__bg" style={`background-image: url('${bannerImage}');`} aria-hidden="true"></div>
      <div class="ptbanner__overlay" aria-hidden="true"></div>
      <div class="ptbanner__inner">
        <h1 class="ptbanner__title rr-reveal">24-Hour Emergency Service</h1>
        <div class="ptbanner__breadcrumbs rr-reveal" data-reveal-delay="100">
          <a href="/">Home</a>
          <span class="ptbanner__divider">-</span>
          <a href="/services">Services</a>
          <span class="ptbanner__divider">-</span>
          <span class="ptbanner__current">24-Hour Emergency Service</span>
        </div>
      </div>
    </div>

    <!-- §1. SOLUTIONS GRID — 2×2 ibox -->
    <section class="sol">
      <div class="sol__left">
        <div class="sol__sticky">
          <div class="av-dblh__subtitle rr-reveal">
            <span class="divider-icon" set:html={diamondIcon} />
            <span>What 24-Hour Service Covers</span>
          </div>
          <h2 class="sol__title rr-reveal" data-reveal-delay="100">
            <span>24/7 Response –</span>
            <span>Repair, Impairment Support</span>
            <span>&amp; Compliance Follow-Through.</span>
          </h2>
          <div class="sol__spacer" aria-hidden="true"></div>
          <div class="sol__cta rr-reveal" data-reveal-delay="200">
            <a href="/contact" class="av-wgl-btn av-wgl-btn--outline">
              <span class="av-wgl-btn__text">Schedule Site Visit to Receive Complimentary Quote</span>
              <span class="av-wgl-btn__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg>
              </span>
            </a>
          </div>
        </div>
      </div>

      <div class="sol__grid">
        {categories.map((c, i) => (
          <a href="/contact" class="ibox rr-reveal" data-icon-slot={i} data-reveal-delay={i * 100}>
            <span class="ibox__bg" aria-hidden="true"></span>
            <span class="ibox__icon" aria-hidden="true">
              <iconify-icon icon={c.icon} width="50" height="50"></iconify-icon>
            </span>
            <span class="ibox__content">
              <h3 class="ibox__title">{c.title}</h3>
              <span class="ibox__text">{c.body}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- §2. WHY RED ROCKS — tan bg image + gradient overlay -->
    <section class="es-whyrr rr-band rr-band--reveal-top">
      <div class="es-whyrr__bg" aria-hidden="true"></div>
      <div class="es-whyrr__overlay" aria-hidden="true"></div>
      <div class="rr-container es-container">
        <div class="es-why-grid">
          <div class="es-why-grid__left">
            <p class="rr-eyebrow es-whyrr__eyebrow mb-5 rr-reveal">Why Red Rocks 24-Hour</p>
            <h2
              class="font-display font-black tracking-tight es-whyrr__title rr-reveal"
              data-reveal-delay="100"
              style="font-size: clamp(36px, 5vw, 56px); line-height: 1; letter-spacing: -0.04em;"
            >
              <span class="es-whyrr__title-black">When a Life Safety</span>
              <br />
              <span class="es-whyrr__title-black">System Cannot Wait,</span>
              <br />
              <span class="es-whyrr__title-red">We're Ready</span>
              <br />
              <span class="es-whyrr__title-red">to Respond.</span>
            </h2>
          </div>

          <div class="es-why-grid__right">
            <p class="es-whyrr__body rr-reveal" data-reveal-delay="200" style="font-size: var(--rr-text-lead); line-height: var(--rr-text-lead-lh); margin-top: 0;">
              Fire and life safety emergencies do not follow business hours. A broken sprinkler pipe, failed backflow preventer, fire alarm communication problem, impaired suppression system, or other critical system failure can create immediate concerns for safety, compliance, property protection, and ongoing operations.
            </p>
            <p class="es-whyrr__body rr-reveal" data-reveal-delay="300" style="font-size: var(--rr-text-lead); line-height: var(--rr-text-lead-lh); margin-top: 1.25rem;">
              Red Rocks Fire Protection Services provides 24-hour emergency service throughout Colorado. Since 2010, our family-owned company has built its reputation around accountability, responsive service, and doing what it takes to help clients protect people and property when problems cannot wait until the next business day.
            </p>

            <ul class="es-whyrr__bullets rr-reveal" data-reveal-delay="400">
              <li class="es-whyrr__bullet">
                <span class="es-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[0]} width="20" height="20"></iconify-icon>
                </span>
                <span>24-hour response for a wide range of fire, life safety, emergency communication, security, and monitoring systems.</span>
              </li>
              <li class="es-whyrr__bullet">
                <span class="es-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[1]} width="20" height="20"></iconify-icon>
                </span>
                <span>Diagnostics, emergency repairs, impairment evaluations, and recommendations for restoring system functionality.</span>
              </li>
              <li class="es-whyrr__bullet">
                <span class="es-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[2]} width="20" height="20"></iconify-icon>
                </span>
                <span>Support for sprinkler failures, freeze damage, alarm troubles, communication outages, backflow failures, suppression impairments, and other urgent conditions.</span>
              </li>
              <li class="es-whyrr__bullet">
                <span class="es-whyrr__bullet-icon" aria-hidden="true">
                  <iconify-icon icon={bulletIcons[3]} width="20" height="20"></iconify-icon>
                </span>
                <span>Fire watch guidance, temporary protection planning, AHJ coordination, and compliance documentation when systems are impaired.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- §3. ACCORDION — 3 panels (the .md H2s) -->
    <section class="es-accordion">
      <div class="es-accordion__bg" aria-hidden="true"></div>
      <div class="es-accordion__overlay" aria-hidden="true"></div>
      <div class="es-accordion__inner es-container">
        <div class="es-accordion__head">
          <p class="av-dblh__subtitle es-accordion__eyebrow rr-reveal">
            <span class="es-accordion__rule" aria-hidden="true"></span>
            <span>How We Serve</span>
            <span class="es-accordion__rule" aria-hidden="true"></span>
          </p>
          <h3 class="es-accordion__title rr-reveal" data-reveal-delay="100">Our Emergency Services.</h3>
          <p class="es-accordion__intro rr-reveal" data-reveal-delay="200">
            Click each panel for the full scope of what our emergency response team can diagnose, repair, and support.
          </p>
        </div>

        <div class="acc es-accordion__list">
          {accordionPanels.map((p, i) => (
            <div class:list={['acc__panel', 'acc__panel--card', 'rr-reveal', p.open && 'is-active']} data-acc-panel data-reveal-delay={i * 100}>
              <button type="button" class="acc__header" aria-expanded={p.open ? 'true' : 'false'}>
                <span class="acc__panel-icon" aria-hidden="true">
                  <iconify-icon icon={accordionIcons[i]} width="22" height="22"></iconify-icon>
                </span>
                <span class="acc__title">{p.title}</span>
                <span class="acc__caret" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor"><path d={arrowPath}></path></svg>
                </span>
              </button>
              <div class="acc__content" hidden={!p.open}>
                <p>{p.body}</p>
                {p.bullets && p.bullets.length > 0 && (
                  <ul class="acc__bullets">
                    {p.bullets.map((b) => (
                      <li class="acc__bullet">
                        <span class="acc__bullet-mark" aria-hidden="true">▸</span>
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {p.footer && (
                  <p class="acc__footer">{p.footer}</p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- §4. MORE THAN A SERVICE CONTRACTOR -->
    <section class="es-splitpanel bg-rr-white rr-band rr-band--reveal-top">
      <div class="rr-container es-container">
        <div class="grid gap-10 md:gap-12 lg:gap-16 items-center md:grid-cols-2">
          <div class="order-2 md:order-1">
            <p class="rr-eyebrow mb-5 text-rr-grey rr-reveal">How We Work</p>
            <h2 class="font-display font-black uppercase tracking-tight rr-reveal" data-reveal-delay="100" style="font-size: var(--rr-text-section); line-height: 0.95;">
              More Than a Service Contractor.
            </h2>
            <div class="mt-6 rr-reveal es-split-body" data-reveal-delay="200">
              <p>An emergency service call is about more than arriving and making a repair. Our team works to understand what has failed, what immediate risk or impairment exists, what can be restored safely, and what additional steps may be required. We communicate with the client throughout the process so property owners and managers understand the condition of the system and the path toward full restoration.</p>
            </div>
            <div class="mt-8 rr-reveal" data-reveal-delay="240">
              <a href="/services" class="av-wgl-btn av-wgl-btn--outline">
                <span class="av-wgl-btn__text">See All Services</span>
                <span class="av-wgl-btn__icon">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg>
                </span>
              </a>
            </div>
          </div>
          <div class="order-1 md:order-2 rr-reveal" data-reveal-delay="300">
            <div class="overflow-hidden rounded-rr-card aspect-[4/3] bg-rr-bg-panel">
              <img src={moreThanImage} alt="Red Rocks Fire Protection emergency response technician on a jobsite late at night" loading="lazy" decoding="async" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- §5. ADVOCACY — #DBDADA bg panel -->
    <section class="es-edge rr-band rr-band--reveal-top">
      <div class="rr-container es-container">
        <div class="grid gap-10 md:gap-12 lg:gap-16 items-center md:grid-cols-2">
          <div class="order-2 md:order-1">
            <p class="rr-eyebrow mb-5 es-edge__eyebrow rr-reveal">Our Edge</p>
            <h2
              class="font-display font-black uppercase tracking-tight rr-reveal es-edge__title"
              data-reveal-delay="100"
              style="font-size: var(--rr-text-section); line-height: 0.95;"
            >
              Advocacy That Protects Your People, Property &amp; Investment.
            </h2>
            <div class="mt-6 rr-reveal es-edge__body" data-reveal-delay="200">
              <p>Emergencies can be stressful, especially when an impaired system triggers fire watch requirements, operational disruption, or coordination with an Authority Having Jurisdiction. This is where advocacy matters most. We help clients navigate the situation, explain options, provide repair recommendations, support temporary protection planning, and remain engaged until the issue has been properly addressed.</p>
            </div>
          </div>
          <div class="order-1 md:order-2 es-edge-img rr-reveal" data-reveal-delay="300">
            <div class="overflow-hidden rounded-rr-card bg-rr-black es-edge-img__wrap">
              <img
                src={advocacyImage}
                alt="Red Rocks Fire Protection advocating for the right emergency-response path during a critical life safety impairment"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover es-edge-img__img"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- §6. WHY CLIENTS STAY — dark bg + 5 value cards -->
    <section class="es-why">
      <div class="es-why__bg" aria-hidden="true"></div>
      <div class="es-why__inner">
        <div class="rr-reveal max-w-3xl mb-12 md:mb-16">
          <p class="rr-eyebrow mb-5" style="color: rgba(255,255,255,0.7);">Why Clients Stay</p>
          <h2
            class="font-display font-black uppercase tracking-tight"
            style="font-size: var(--rr-text-section); line-height: 0.95; color: #fff;"
          >
            Why Clients Continue to Choose RRFPS.
          </h2>
          <p class="mt-6" style="font-size: var(--rr-text-lead); color: rgba(255,255,255,0.9);">
            Everything we do is built upon the values that have guided our company since its founding. These principles are reflected in our Brand Promise: we communicate clearly, we honor our commitments, we arrive prepared, we respond when it matters most, we price fairly, we stand behind our work, and we remain committed until every issue has been fully resolved.
          </p>
        </div>

        <div class="grid gap-4 md:gap-6 sm:grid-cols-2 lg:grid-cols-5">
          {whyClientsValues.map((v, i) => (
            <article class="rr-reveal es-flowcard rounded-rr-card p-6 flex flex-col" data-reveal-delay={i * 100}>
              <span class="es-flowcard__icon" aria-hidden="true">
                <iconify-icon icon={whyClientsIcons[i]} width="40" height="40"></iconify-icon>
              </span>
              <h3 class="font-display font-bold tracking-tight" style="font-size: var(--rr-text-card); line-height: 1.05; color: #fff;">
                {v.title}
              </h3>
              <p class="mt-3 leading-relaxed flex-1" style="font-size: var(--rr-text-lead); color: rgba(255,255,255,0.85);">
                {v.body}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- §7. EXPERIENCE — white-bg SplitPanel -->
    <section class="es-splitpanel bg-rr-white rr-band rr-band--reveal-top">
      <div class="rr-container es-container">
        <div class="grid gap-10 md:gap-12 lg:gap-16 items-center md:grid-cols-2">
          <div class="order-2 md:order-1">
            <p class="rr-eyebrow mb-5 text-rr-grey rr-reveal">Experience</p>
            <h2 class="font-display font-black uppercase tracking-tight rr-reveal" data-reveal-delay="100" style="font-size: var(--rr-text-section); line-height: 0.95;">
              Emergency Response Experience You Can Trust.
            </h2>
            <div class="mt-6 rr-reveal es-split-body" data-reveal-delay="200">
              <p>Our emergency response capability extends across fire alarms, sprinkler systems, dry pipe systems, fire pumps, backflow preventers, extinguishers, kitchen hood suppression, ERRCS/BDA, Area of Refuge communications, elevator emergency communications, security systems, and monitoring communication failures. That broad experience gives clients one trusted life safety partner to call when the exact source or scope of an emergency may not yet be clear.</p>
            </div>
          </div>
          <div class="order-1 md:order-2 rr-reveal" data-reveal-delay="300">
            <div class="overflow-hidden rounded-rr-card aspect-[4/3] bg-rr-bg-panel">
              <img src={experienceImage} alt="Red Rocks Fire Protection experienced emergency response technician troubleshooting a system at night" loading="lazy" decoding="async" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- §8. READY WHEN YOU ARE — #DBDADA bg panel -->
    <section class="es-splitpanel es-promise rr-band rr-band--reveal-top">
      <div class="rr-container es-container">
        <div class="grid gap-10 md:gap-12 lg:gap-16 items-center md:grid-cols-2">
          <div class="order-2 md:order-1">
            <p class="rr-eyebrow mb-5 es-promise__eyebrow rr-reveal">Our Promise</p>
            <h2 class="font-display font-black uppercase tracking-tight rr-reveal" data-reveal-delay="100" style="font-size: var(--rr-text-section); line-height: 0.95;">
              Ready When You Are.
            </h2>
            <div class="mt-6 rr-reveal es-promise__body" data-reveal-delay="200">
              <p>When a critical life safety system becomes impaired, you need a team that responds, communicates, takes ownership, and helps you move from emergency to resolution. Red Rocks Fire Protection Services is ready around the clock to help restore system functionality, support compliance, and minimize disruption.</p>
            </div>
          </div>
          <div class="order-1 md:order-2 rr-reveal" data-reveal-delay="300">
