---
/**
 * Blog category archive — `/blog/category/<slug>/`.
 *
 * Reuses the same hero, post-grid, sidebar, and closing CTA as `/blog/`.
 * Filters the blog collection by `category === category.enumValue` and
 * hands the filtered list to `<BlogArchiveGrid>`.
 *
 * The `getStaticPaths` enumerates every entry in `blogCategories`
 * (src/data/blogCategories.ts) so adding a new category is a one-line
 * change there — no edits here required.
 *
 * Empty categories render an empty-state message inside the grid
 * component, so this page never throws.
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import ClosingCTA from '../../../components/ClosingCTA.astro';
import BlogSidebar from '../../../components/BlogSidebar.astro';
import BlogArchiveGrid from '../../../components/BlogArchiveGrid.astro';
import { getCollection } from 'astro:content';
import { blogCategories } from '../../../data/blogCategories';
import { leadership } from '../../../data/site';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  return blogCategories.map((category) => {
    const filtered = allPosts
      .filter((post) => post.data.category === category.enumValue)
      .sort(
        (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
      );
    return {
      params: { category: category.slug },
      props: { category, posts: filtered },
    };
  });
}

const { category, posts } = Astro.props;

const author = {
  name: leadership.ceo.name,
  role: 'CEO',
  avatar: '/images/brian-kakac-ceo-red-rocks-fire-protection-services.png',
  // Empty hrefs render the icon but stay non-clickable until real handles
  // are confirmed (per data/site.ts → contact.socials note). X and Facebook
  // are intentionally empty so the sidebar only shows Instagram + LinkedIn.
  socials: {
    x: '',
    facebook: '',
    instagram: '#',
    linkedin: '#',
  },
};
---

<BaseLayout
  title={`${category.label} | RRFPS Blog`}
  description={`Blog posts in the ${category.label} category — fire protection insights for Colorado property teams from Red Rocks Fire Protection Services.`}
>
  <!-- HERO — same pattern as /blog/index.astro, /inspections.astro, etc.
       Identical .ptbanner styles live in this page's <style> block below. -->
  <div
    class="ptbanner"
    style="background-image: url('/images/red-rocks-fire-protection-inspection-hero.jpg');"
  >
    <div class="ptbanner__inner">
      <h1 class="ptbanner__title">{category.label}</h1>
      <div class="ptbanner__breadcrumbs">
        <a href="/">Home</a>
        <span class="ptbanner__divider">-</span>
        <a href="/blog/">Blog</a>
        <span class="ptbanner__divider">-</span>
        <span class="ptbanner__current">{category.label}</span>
      </div>
    </div>
  </div>

  <!-- POSTS + SIDEBAR — same 3/4 + 1/4 layout as /blog/. -->
  <section class="rr-band" style="background: var(--rr-white);">
    <div class="rr-container">
      <div class="blog-layout">
        <BlogArchiveGrid posts={posts} />
        <BlogSidebar
          posts={posts}
          categories={blogCategories}
          author={author}
          activeCategory={category.slug}
        />
      </div>
    </div>
  </section>

  <!-- CLOSING CTA — same as /blog/. -->
  <ClosingCTA
    backgroundImage="/images/rrfps-county-cta-apartments.jpg"
    flipBackground={false}
  />
</BaseLayout>

<style>
  /* HERO — duplicated from /blog/index.astro and /blog/[slug].astro for
     visual cohesion. If you change one, change all three. */
  .ptbanner {
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center bottom;
    min-height: 450px;
    padding-top: 154px;
    padding-bottom: 20px;
    display: flex;
    align-items: flex-end;
  }
  .ptbanner__inner {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 15px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .ptbanner__title {
    margin: 0;
    color: #ffffff;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: clamp(38px, 5.5vw, 75px);
    line-height: 104px;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }
  .ptbanner__breadcrumbs {
    color: #ffffff;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 30px;
    letter-spacing: -0.04em;
    padding-bottom: 14px;
  }
  .ptbanner__breadcrumbs a {
    color: #ffffff;
    text-decoration: none;
    transition: 0.4s;
  }
  .ptbanner__breadcrumbs a:hover { color: #ffffff99; }
  .ptbanner__divider { margin: 0 10px; }
  .ptbanner__current {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* ── 3/4 + 1/4 layout — same as /blog/index.astro ──────────────── */
  .blog-layout {
    display: grid;
    gap: 32px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 1024px) {
    .blog-layout {
      grid-template-columns: 3fr 1fr;
      gap: 40px;
      align-items: start;
    }
  }

  @media (max-width: 1200px) {
    .ptbanner__title { font-size: 64px; line-height: 72px; }
  }
  @media (max-width: 767px) {
    .ptbanner { min-height: 320px; padding-top: 120px; }
    .ptbanner__title { font-size: 40px; line-height: 48px; }
  }
</style>
