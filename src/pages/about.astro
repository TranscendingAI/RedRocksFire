<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  declare const Swiper: any;

  function initAboutTestimonials() {
    if (typeof Swiper === 'undefined') return false;
    const element = document.querySelector('.about-tm__swiper') as any;
    if (!element) return false;
    if (element.swiper) return true;

    new Swiper(element, {
      slidesPerView: 1,
      spaceBetween: 30,
      loop: true,
      speed: 800,
      navigation: {
        prevEl: '.about-tm__prev',
        nextEl: '.about-tm__next',
      },
    });
    return true;
  }

  function bindAboutTestimonials() {
    if (!initAboutTestimonials()) setTimeout(initAboutTestimonials, 100);
  }

  document.addEventListener('astro:page-load', bindAboutTestimonials);
  document.addEventListener('astro:after-swap', bindAboutTestimonials);
  document.addEventListener('DOMContentLoaded', bindAboutTestimonials);
  if (document.readyState !== 'loading') bindAboutTestimonials();
</script>
