---
/**
 * About Red Rocks Fire Protection Services.
 *
 * Content source: reference/content/rrfps-about-page-content-and-design-guidance.md
 * Structured page data: src/data/site.ts → `about`
 *
 * Section order:
 *   0. Community image page-title banner
 *   1. Fast facts — 6 ibox-style cards, 3 per row
 *   2. Company overview — split panel
 *   3. Why we exist — homepage-inspired image statement
 *   4. Our capabilities — 12 linked icon cards, 4 per row
 *   5. Industries we serve — 14 linked cards, 3 per row
 *   6. CEO message — Brian Kakac portrait and introduction
 *   7. Learn more — Core / Team / Promise feature cards
 *   8. Testimonials — homepage carousel pattern with 5 avatar indicators
 *   9. The RRFPS Difference — Red Rocks background image
 *  10. Existing closing DualCTA and footer
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import DualCTA from '../components/DualCTA.astro';
import { about, testimonials } from '../data/site';

const arrowPath = 'M0 6.78247C0 6.52555 0.102065 6.27914 0.283741 6.09746C0.465416 5.91579 0.711822 5.81372 0.96875 5.81372H12.1927L8.03288 1.65585C7.85097 1.47394 7.74878 1.22723 7.74878 0.969974C7.74878 0.712721 7.85097 0.466004 8.03288 0.284099C8.21478 0.102194 8.4615 0 8.71875 0C8.976 0 9.22272 0.102194 9.40463 0.284099L15.2171 6.0966C15.3073 6.18659 15.3789 6.29349 15.4278 6.41118C15.4766 6.52888 15.5017 6.65505 15.5017 6.78247C15.5017 6.9099 15.4766 7.03607 15.4278 7.15376C15.3789 7.27146 15.3073 7.37836 15.2171 7.46835L9.40463 13.2808C9.22272 13.4628 8.976 13.5649 8.71875 13.5649C8.4615 13.5649 8.21478 13.4628 8.03288 13.2808C7.85097 13.0989 7.74878 12.8522 8.03288 11.9091L12.1927 7.75122H0.96875C0.711822 7.75122 0.465416 7.64916 0.283741 7.46748C0.102065 7.28581 0 7.0394 0 6.78247Z';

const diamondIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="20" viewBox="0 0 15 20"><path d="M0.660472 19.6191L0.47542 6.53585L13.7437 19.8041L0.660472 19.6191Z"></path><path d="M14.3396 0.939992L14.5246 14.0232L1.25635 0.754941L14.3396 0.939992Z"></path></svg>';

const testimonialSlides = [
  ...testimonials,
  {
    quote: 'Red Rocks Fire Protection Services brings clarity, responsiveness, and a true partnership mindset to every life safety need. Their coordinated approach makes complex compliance easier to manage.',
    attribution: { name: 'Colorado Property Partner', title: 'Property Management Client', company: '' },
    headline: 'A Proactive Partner in Life Safety.',
  },
] as const;

const testimonialAvatars = [
  '/images/home/testimonials-logo-1.webp',
  '/images/home/testimonials-logo-2.webp',
  '/images/home/testimonials-logo-3.webp',
  '',
  '',
] as const;
---

<BaseLayout title={about.seo.title} description={about.seo.description}>
  <div class="av-page about-page">
    <header class="ptbanner">
      <div
        class="ptbanner__bg"
        style={`background-image: url('${about.banner.backgroundImage}');`}
        aria-hidden="true"
      ></div>
      <div class="ptbanner__overlay" aria-hidden="true"></div>
      <div class="ptbanner__inner">
        <h1 class="ptbanner__title">{about.banner.title}</h1>
        <div class="ptbanner__breadcrumbs">
          <a href="/">Home</a>
          <span class="ptbanner__divider">-</span>
          <span class="ptbanner__current">{about.banner.subtitle}</span>
        </div>
      </div>
    </header>

    <section class="facts section-light" id="fast-facts">
      <div class="section-inner section-inner--wide">
        <div class="section-head section-head--center">
          <div class="av-dblh__subtitle section-eyebrow">
            <span class="divider-icon" set:html={diamondIcon} />
            <span>Fast Facts — Company Description</span>
          </div>
          <h2 class="section-title">Red Rocks at a Glance.</h2>
        </div>

        <div class="facts__grid">
          {about.fastFacts.map((fact, index) => (
            <article class="ibox">
              <span class="ibox__bg" aria-hidden="true"></span>
              <span class="ibox__icon" aria-hidden="true">
                <span class="ibox__glyph">{String(index + 1).padStart(2, '0')}</span>
              </span>
              <span class="ibox__content">
                <h3 class="ibox__title">{fact.title}</h3>
                <span class="ibox__text">{fact.body}</span>
              </span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="overview section-dark">
      <div class="section-inner">
        <div class="split-grid">
          <div class="split-copy">
            <div class="av-dblh__subtitle section-eyebrow section-eyebrow--light">
              <span class="divider-icon" set:html={diamondIcon} />
              <span>{about.companyOverview.eyebrow}</span>
            </div>
            <h2 class="section-title section-title--light">{about.companyOverview.title}</h2>
            <div class="overview__body">
              {about.companyOverview.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </div>
          <div class="split-image">
            <img
              src={about.companyOverview.image}
              alt={about.companyOverview.imageAlt}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="purpose">
      <div
        class="purpose__bg"
        style={`background-image: url('${about.whyWeExist.image}');`}
        aria-hidden="true"
      ></div>
      <div class="purpose__overlay" aria-hidden="true"></div>
      <div class="section-inner purpose__inner">
        <div class="purpose__mark" aria-hidden="true">
          <img src="/images/RRFPS_LOGO.png" alt="" loading="lazy" />
        </div>
        <div class="purpose__copy">
          <div class="av-dblh__subtitle section-eyebrow section-eyebrow--light">
            <span class="divider-icon" set:html={diamondIcon} />
            <span>{about.whyWeExist.eyebrow}</span>
          </div>
          <h2 class="section-title section-title--light">{about.whyWeExist.title}</h2>
          <p class="purpose__statement">{about.whyWeExist.statement}</p>
          <p class="purpose__body">{about.whyWeExist.body}</p>
        </div>
      </div>
    </section>

    <section class="capabilities section-light">
      <div class="section-inner section-inner--wide">
        <div class="section-head">
          <div class="av-dblh__subtitle section-eyebrow">
            <span class="divider-icon" set:html={diamondIcon} />
            <span>{about.capabilities.eyebrow}</span>
          </div>
          <h2 class="section-title">{about.capabilities.title}</h2>
          <p class="section-intro">{about.capabilities.intro}</p>
        </div>

        <div class="capabilities__grid">
          {about.capabilities.items.map((item, index) => (
            <a href={item.href} class="capability-card">
              <span class="capability-card__icon" aria-hidden="true">
                <span>{String(index + 1).padStart(2, '0')}</span>
              </span>
              <h3>{item.title}</h3>
              <span class="capability-card__link">
                Learn more
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg>
              </span>
            </a>
          ))}
        </div>
        <p class="capabilities__closing">{about.capabilities.closing}</p>
      </div>
    </section>

    <section class="industries">
      <div class="industries__bg" aria-hidden="true"></div>
      <div class="industries__overlay" aria-hidden="true"></div>
      <div class="section-inner section-inner--wide industries__inner">
        <div class="section-head">
          <div class="av-dblh__subtitle section-eyebrow section-eyebrow--light">
            <span class="divider-icon" set:html={diamondIcon} />
            <span>{about.industries.eyebrow}</span>
          </div>
          <h2 class="section-title section-title--light">{about.industries.title}</h2>
        </div>

        <div class="industries__grid">
          {about.industries.items.map((item) => (
            <a href={item.href} class="industry-card">
              <h3>{item.title}</h3>
              <span class="industry-card__link">
                Learn more
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="ceo section-light" id="ceo-message">
      <div class="section-inner">
        <div class="ceo__grid">
          <div class="ceo__portrait">
            <img
              src={about.ceoMessage.image}
              alt={about.ceoMessage.imageAlt}
              loading="eager"
              decoding="async"
            />
            <div class="ceo__nameplate">
              <strong>Brian Kakac</strong>
              <span>CEO & Owner</span>
            </div>
          </div>
          <div class="ceo__copy">
            <div class="av-dblh__subtitle section-eyebrow">
              <span class="divider-icon" set:html={diamondIcon} />
              <span>{about.ceoMessage.eyebrow}</span>
            </div>
            <h2 class="section-title">{about.ceoMessage.title}</h2>
            <p class="ceo__greeting">{about.ceoMessage.greeting}</p>
            <p class="ceo__intro">{about.ceoMessage.intro}</p>
            <p>{about.ceoMessage.body}</p>
            <a href="#ceo-message" class="av-wgl-btn av-wgl-btn--outline ceo__cta">
              <span class="av-wgl-btn__text">Read Our CEO’s Message</span>
              <span class="av-wgl-btn__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg>
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="learn-more section-dark">
      <div class="section-inner section-inner--wide">
        <div class="section-head section-head--center">
          <div class="av-dblh__subtitle section-eyebrow section-eyebrow--light">
            <span class="divider-icon" set:html={diamondIcon} />
            <span>{about.learnMore.eyebrow}</span>
          </div>
          <h2 class="section-title section-title--light">{about.learnMore.title}</h2>
          <p class="section-intro section-intro--light">{about.learnMore.intro}</p>
        </div>

        <div class="learn-more__grid">
          {about.learnMore.items.map((item) => (
            <a href={item.href} class="learn-card">
              {item.image ? (
                <img src={item.image} alt={item.imageAlt} loading="lazy" decoding="async" />
              ) : (
                <span class="learn-card__placeholder" aria-label="Team member photo coming soon">
                  <span aria-hidden="true"></span>
                </span>
              )}
              <span class="learn-card__overlay" aria-hidden="true"></span>
              <span class="learn-card__copy">
                <span class="learn-card__label">{item.label}</span>
                <strong>{item.title}</strong>
              </span>
              <span class="learn-card__arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="tm">
      <div class="av-loop tm__marquee" aria-hidden="true">
        {[0, 1, 2].map(() => (
          <div class="av-loop__track">
            <h3 class="tm__marquee-text">
              ABOUT US&nbsp; • &nbsp;WHAT OUR CLIENTS SAY&nbsp; ABOUT US&nbsp; • &nbsp;WHAT OUR CLIENTS SAY&nbsp; ABOUT US&nbsp; • &nbsp;WHAT OUR CLIENTS SAY&nbsp;
            </h3>
          </div>
        ))}
      </div>

      <div class="tm__row">
        <div class="tm__image">
          <img src="/images/rrfps-testimonials.jpg" alt="Red Rocks Fire Protection team serving Colorado clients" loading="lazy" />
        </div>

        <div class="tm__col">
          <div class="tm__carousel">
            <div class="swiper about-tm__swiper">
              <div class="swiper-wrapper">
                {testimonialSlides.map((testimonial) => (
                  <div class="swiper-slide">
                    <article class="tm-item">
                      <p class="tm-item__quote">“{testimonial.quote}”</p>
                      <div class="tm-item__author">
                        <h3 class="tm-item__name">{testimonial.attribution.name}</h3>
                        <span class="tm-item__position">
                          {testimonial.attribution.title}{testimonial.attribution.company ? `, ${testimonial.attribution.company}` : ''}
                        </span>
                      </div>
                    </article>
                  </div>
                ))}
              </div>
            </div>
            <div class="tm__nav">
              <button type="button" class="tm__nav-btn about-tm__prev" aria-label="Previous testimonial">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" style="transform: scaleX(-1)" aria-hidden="true"><path d={arrowPath}></path></svg>
                <span>PREV</span>
              </button>
              <button type="button" class="tm__nav-btn about-tm__next" aria-label="Next testimonial">
                <span>NEXT</span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg>
              </button>
            </div>
          </div>

          <div class="tm__bottom">
            <div class="tm__customers">
              {testimonialAvatars.map((avatar) => (
                avatar ? (
                  <img src={avatar} alt="" class="tm__avatar" loading="lazy" />
                ) : (
                  <span class="tm__avatar tm__avatar--placeholder" aria-hidden="true"></span>
                )
              ))}
              <h2 class="tm__customers-label">Trusted Across Colorado</h2>
            </div>
            <a href="/testimonials" class="av-wgl-btn av-wgl-btn--outline tm__more">
              <span class="av-wgl-btn__text">More Testimonials</span>
              <span class="av-wgl-btn__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg>
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="difference" id="rrfps-difference">
      <div
        class="difference__bg"
        style={`background-image: url('${about.difference.backgroundImage}');`}
        aria-hidden="true"
      ></div>
      <div class="difference__overlay" aria-hidden="true"></div>
      <div class="section-inner difference__inner">
        <div class="difference__copy">
          <div class="av-dblh__subtitle section-eyebrow section-eyebrow--light">
            <span class="divider-icon" set:html={diamondIcon} />
            <span>{about.difference.eyebrow}</span>
          </div>
          <h2 class="section-title section-title--light">{about.difference.title}</h2>
          <p class="difference__lead">{about.difference.lead}</p>
          <div class="difference__points">
            {about.difference.points.map((point) => <strong>{point}</strong>)}
          </div>
          <p class="difference__body">{about.difference.body}</p>
          <a href="#rrfps-difference" class="av-wgl-btn difference__cta">
            <span class="av-wgl-btn__text">Learn More</span>
            <span class="av-wgl-btn__icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg>
            </span>
          </a>
        </div>
      </div>
    </section>

    <DualCTA items={[...about.reachOut]} background="white" />
  </div>
</BaseLayout>

<style>
  .section-light { background: #ffffff; color: #0a0a0a; }
  .section-dark { background: #0d0d0b; color: #ffffff; }
  .section-inner {
    width: 100%;
    max-width: 1280px;
    margin-inline: auto;
    padding: 110px 40px;
  }
  .section-inner--wide { max-width: 1500px; }
  .section-head { max-width: 850px; margin-bottom: 58px; }
  .section-head--center { margin-inline: auto; text-align: center; }
  .section-head--center .section-eyebrow { justify-content: center; }
  .section-eyebrow { margin-bottom: 23px; display: flex; }
  .section-eyebrow--light { color: rgba(255, 255, 255, 0.72); }
  .section-title {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(38px, 5vw, 64px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    color: #0a0a0a;
  }
  .section-title--light { color: #ffffff; }
  .section-intro {
    max-width: 720px;
    margin: 24px 0 0;
    color: #626262;
    font-size: 18px;
    line-height: 1.7;
  }
  .section-head--center .section-intro { margin-inline: auto; }
  .section-intro--light { color: rgba(255, 255, 255, 0.78); }

  .ptbanner {
    position: relative;
    isolation: isolate;
    background: #0d0d0b;
    overflow: hidden;
  }
  .ptbanner__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 58%;
    z-index: -2;
  }
  .ptbanner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 7, 7, 0.46) 0%, rgba(7, 7, 7, 0.58) 100%);
    z-index: -1;
  }
  .ptbanner__inner {
    min-height: 560px;
    max-width: 1280px;
    margin-inline: auto;
    padding: 170px 40px 45px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
  }
  .ptbanner__title {
    margin: 0;
    max-width: 920px;
    color: #ffffff;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: clamp(64px, 8vw, 110px);
    line-height: 0.9;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }
  .ptbanner__breadcrumbs {
    padding-bottom: 10px;
    color: #ffffff;
    font-family: "Space Grotesk", sans-serif;
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
  }
  .ptbanner__breadcrumbs a { color: #ffffff; text-decoration: none; }
  .ptbanner__divider { margin-inline: 10px; }
  .ptbanner__current { text-decoration: underline; text-underline-offset: 4px; }

  .facts__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px;
  }
  .ibox {
    position: relative;
    display: flex;
    min-height: 300px;
    flex-direction: column;
    transition: background-color 0.4s;
  }
  .ibox__bg {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(10, 10, 10, 0.15);
    pointer-events: none;
    transition: border-color 0.4s;
  }
  .ibox__icon {
    display: inline-flex;
    align-self: flex-start;
    padding: 16px;
    background: #d41226;
    color: #ffffff;
    transition: background-color 0.4s, color 0.4s;
  }
  .ibox__glyph {
    color: currentColor;
    font-family: "Space Grotesk", sans-serif;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .ibox__content { padding: 45px 36px 36px; }
  .ibox__title {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(24px, 2vw, 30px);
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
    color: #0a0a0a;
    transition: color 0.4s;
  }
  .ibox__text {
    display: block;
    margin-top: 16px;
    color: #626262;
    font-size: 16px;
    line-height: 1.7;
    transition: color 0.4s;
  }
  .ibox:hover { background: #d41226; }
  .ibox:hover .ibox__bg { border-color: #d41226; }
  .ibox:hover .ibox__icon { background: #ffffff; color: #0a0a0a; }
  .ibox:hover .ibox__title,
  .ibox:hover .ibox__text { color: #ffffff; }

  .split-grid,
  .ceo__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 80px;
    align-items: center;
  }
  .overview__body p {
    margin: 22px 0 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 17px;
    line-height: 1.75;
  }
  .split-image { overflow: hidden; border-radius: 18px; }
  .split-image img { display: block; width: 100%; aspect-ratio: 4 / 4.2; object-fit: cover; }

  .purpose {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #0d0d0b;
    color: #ffffff;
  }
  .purpose__bg,
  .difference__bg,
  .industries__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    z-index: -2;
  }
  .purpose__overlay,
  .difference__overlay,
  .industries__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.68);
    z-index: -1;
  }
  .purpose__inner {
    display: grid;
    grid-template-columns: 0.65fr 1.35fr;
    gap: 80px;
    align-items: center;
  }
  .purpose__mark {
    width: min(310px, 100%);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(6px);
  }
  .purpose__mark img { width: 72%; height: auto; }
  .purpose__statement {
    margin: 30px 0 0;
    color: #ffffff;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(24px, 2.4vw, 34px);
    font-weight: 600;
    line-height: 1.35;
  }
  .purpose__body {
    margin: 24px 0 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 17px;
    line-height: 1.75;
  }

  .capabilities__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgba(10, 10, 10, 0.16);
    border-left: 1px solid rgba(10, 10, 10, 0.16);
  }
  .capability-card {
    min-height: 260px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    color: #0a0a0a;
    text-decoration: none;
    border-right: 1px solid rgba(10, 10, 10, 0.16);
    border-bottom: 1px solid rgba(10, 10, 10, 0.16);
    transition: background-color 0.35s, color 0.35s;
  }
  .capability-card__icon {
    width: 66px;
    height: 66px;
    display: grid;
    place-items: center;
    color: #ffffff;
    background: #d41226;
    transition: background-color 0.35s, color 0.35s;
  }
  .capability-card__icon > span {
    color: currentColor;
    font-family: "Space Grotesk", sans-serif;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .capability-card h3 {
    margin: 34px 0 24px;
    font-family: "Space Grotesk", sans-serif;
    font-size: 21px;
    font-weight: 700;
    line-height: 1.25;
