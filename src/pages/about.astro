  .purpose__stage-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.26) 36%, rgba(0, 0, 0, 0.42) 100%);
    z-index: -1;
