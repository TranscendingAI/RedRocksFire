    /* Full-bleed: break the stage out of .purpose__wrap's gutters so the
       image-bg rectangle (with .purpose__stage-overlay) spans the full
       viewport width, edge to edge. Title/copy above + below stay padded. */
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    border-radius: 0;
    display: grid;
    grid-template-columns: minmax(220px, 0.58fr) minmax(0, 1fr) auto;
    align-items: center;
    /* Right gutter for the CTA; left is 0 so the red badge background can
