  /* ---- §6. What Clients Say — rotating red "flow" border on the 5 cards.
     A conic-gradient sweeps brand red around each card via an animated
     custom property (@property enables the angle to transition). The card
     face sits on top as an inset solid panel, leaving a thin gradient ring.
     Honors prefers-reduced-motion (ring stays, rotation stops). */
  @property --fs-flow-angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  .fs-flowcard {
    position: relative;
    isolation: isolate;
    background: rgba(255, 255, 255, 0.10);
    border: 0;
    /* Square corners to match the About page card style (.capability-card).
       Overrides the rounded-rr-card utility; the ::before ring inherits this. */
    border-radius: 0;
  }
  .fs-flowcard::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    padding: 2px;
    background: conic-gradient(
      from var(--fs-flow-angle),
      rgba(255, 255, 255, 0.28) 0deg,
      #ff2438 70deg,
      #d41226 130deg,
      rgba(255, 255, 255, 0.28) 200deg,
      rgba(255, 255, 255, 0.28) 360deg
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    animation: fs-flow-spin 4s linear infinite;
  }
  @keyframes fs-flow-spin {
    to { --fs-flow-angle: 360deg; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fs-flowcard::before { animation: none; }
  }
  /* Card icon — matches About's .capability-card__icon (red square, white icon) */
  .fs-flowcard__icon {
    width: 74px;
    height: 74px;
    display: grid;
    place-items: center;
    color: #ffffff;
    background: #d41226;
    flex: 0 0 auto;
    margin-bottom: 22px;
  }
  .fs-flowcard__icon iconify-icon {
    color: currentColor;
    stroke: currentColor;
    stroke-width: 1;
  }

  /* ---- Gutter alignment — match the IndustriesGrid section width/padding
     (max-width 1340px, 80px desktop gutters) so all custom sections line up
     left/right with the Industries component. Overrides .rr-container on this
     page only (same element carries both classes). ---- */
  .fs-container {
    max-width: 1340px;
