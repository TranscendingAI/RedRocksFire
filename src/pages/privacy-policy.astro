---
/**
 * Privacy Policy — /privacy-policy/
 *
 * Plain-language policy describing what the site actually does:
 *   - Contact form (/contact) → /api/contact → emailed to staff via Resend
 *   - Google Analytics 4 + Microsoft Clarity (BaseLayout, production only)
 *   - Fire report lookup (/fire-reports) → search terms queried in Supabase
 *   - Hosting on Vercel; GSAP from jsDelivr; icons from the Iconify API
 *
 * Layout mirrors the other content pages: ptbanner hero (contact.astro §0
 * pattern) + a single boxed prose section. Contact details come from
 * src/data/site.ts so they stay in sync with the footer/contact page.
 *
 * Not legal advice — update LAST_UPDATED and the copy if the site starts
 * collecting anything new (e.g. ad pixels, newsletter, accounts).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../data/site';

const LAST_UPDATED = 'September 30, 2026';
const bannerImage = '/images/rrfps-services-hero-bg.webp';

const sections = [
  { id: 'who-we-are', title: 'Who We Are' },
  { id: 'information-we-collect', title: 'Information We Collect' },
  { id: 'how-we-use', title: 'How We Use Information' },
  { id: 'sharing', title: 'How Information Is Shared' },
  { id: 'cookies', title: 'Cookies, Analytics & Your Choices' },
  { id: 'retention', title: 'Data Retention' },
  { id: 'security', title: 'Security' },
  { id: 'your-rights', title: 'Your Rights & Requests' },
  { id: 'third-party-links', title: 'Third-Party Links' },
  { id: 'children', title: 'Children’s Privacy' },
  { id: 'changes', title: 'Changes to This Policy' },
  { id: 'contact', title: 'Contact Us' },
];
---

<BaseLayout
  title="Privacy Policy | Red Rocks Fire Protection"
  description="How Red Rocks Fire Protection (RRFPS) collects, uses, and protects information submitted through rrfps.com, including our contact form, analytics, and fire report lookup."
  canonical="https://www.rrfps.com/privacy-policy/"
>
  <div class="av-page">
    <div class="ptbanner" style={`background-image: linear-gradient(rgba(10, 10, 10, 0.35), rgba(10, 10, 10, 0.35)), url('${bannerImage}');`}>
      <div class="ptbanner__inner">
        <h1 class="ptbanner__title">Privacy Policy</h1>
        <div class="ptbanner__breadcrumbs">
          <a href="/">Home</a>
          <span class="ptbanner__divider">-</span>
          <span class="ptbanner__current">Privacy Policy</span>
        </div>
      </div>
    </div>

    <section class="pp">
      <div class="pp__inner rr-container">
        <p class="pp__updated">Last updated: {LAST_UPDATED}</p>

        <p class="pp__lead">
          Red Rocks Fire Protection Services (“RRFPS,” “we,” “us,” or “our”) respects your privacy.
          This Privacy Policy explains what information we collect when you visit{' '}
          <a href="/">www.rrfps.com</a> (the “Site”), how we use it, who we share it with, and the
          choices you have. By using the Site, you acknowledge the practices described here.
        </p>

        <nav class="pp__toc" aria-label="On this page">
          <p class="pp__toc-title">On this page</p>
          <ol>
            {sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
          </ol>
        </nav>

        <h2 id="who-we-are">1. Who We Are</h2>
        <p>
          RRFPS is a Colorado-based, family-owned life safety company located at
          {' '}{contact.address.line1}, {contact.address.city}, {contact.address.state} {contact.address.zip}.
          We provide fire protection inspections, service, and monitoring across the Colorado Front Range.
          This policy applies to the Site only. It does not cover information we collect offline or
          through separate service agreements, which are governed by those agreements.
        </p>

        <h2 id="information-we-collect">2. Information We Collect</h2>
        <h3>Information you give us</h3>
        <p>
          When you use our <a href="/contact">contact form</a>, we collect the information you enter:
          your <strong>name</strong>, <strong>email address</strong>, and <strong>message</strong>
          (required), and optionally your <strong>phone number</strong> and{' '}
          <strong>company or property name</strong>. If you email or call us directly, we receive the
          information you choose to share.
        </p>
        <h3>Fire report lookup</h3>
        <p>
          Our <a href="/fire-reports">fire report lookup</a> lets you search by property address or company
          name. The search terms you enter are sent to our database provider to find matching reports.
          No account is required, and we do not ask for your name or contact details to search.
        </p>
        <h3>Information collected automatically</h3>
        <p>
          Like most websites, when you visit the Site we and our service providers automatically receive
          certain technical information, such as your IP address, browser and device type, operating
          system, referring page, pages viewed, approximate location derived from your IP address, and the
          date and time of your visit. Some of this is collected through cookies and similar technologies
          described in <a href="#cookies">Section 5</a>. Our hosting provider also keeps standard server
          logs for security and reliability.
        </p>

        <h2 id="how-we-use">3. How We Use Information</h2>
        <ul>
          <li>To respond to your inquiries, quote requests, and service questions.</li>
          <li>To schedule, provide, and follow up on the services you request.</li>
          <li>To provide the fire report lookup and deliver the reports you search for.</li>
          <li>To understand how visitors use the Site so we can improve its content, design, and performance.</li>
          <li>To protect the Site, detect spam and abuse, and keep it secure.</li>
          <li>To comply with legal obligations and enforce our rights.</li>
        </ul>

        <h2 id="sharing">4. How Information Is Shared</h2>
        <p>
          <strong>We do not sell your personal information</strong>, and we do not share contact form
          submissions with third parties for their own marketing. We share information only as described
          below:
        </p>
        <ul>
          <li>
            <strong>Service providers</strong> that operate parts of the Site on our behalf, including:{' '}
            <strong>Resend</strong> (delivers contact form submissions to our staff by email),{' '}
            <strong>Vercel</strong> (website hosting), <strong>Supabase</strong> (database and file storage
            for the fire report lookup), <strong>Google Analytics</strong> and{' '}
            <strong>Microsoft Clarity</strong> (site analytics), and content delivery networks that serve
            scripts and icons used by the Site (such as jsDelivr and Iconify). These providers process
            information under their own terms and privacy policies.
          </li>
          <li>
            <strong>Legal and safety reasons</strong>, when we believe in good faith that disclosure is
            required by law, subpoena, or other legal process, or is necessary to protect the rights,
            property, or safety of RRFPS, our customers, or others.
          </li>
          <li>
            <strong>Business transfers</strong>, if RRFPS is involved in a merger, acquisition, or sale of
            assets, in which case information may be transferred as part of that transaction.
          </li>
        </ul>

        <h2 id="cookies">5. Cookies, Analytics &amp; Your Choices</h2>
        <p>
          Cookies are small text files stored by your browser. The Site uses cookies and similar
          technologies for analytics. We do not use them to show you targeted advertising.
        </p>
        <h3>Google Analytics 4</h3>
        <p>
          We use Google Analytics to understand how visitors find and use the Site (for example, which
          pages are viewed and whether a contact form was submitted). Google Analytics sets cookies
          (such as <code>_ga</code>) and collects information about your device and browsing activity
          on the Site. Learn more in
          {' '}<a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google’s Privacy Policy</a>
          {' '}and
          {' '}<a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer">how Google uses information from sites that use its services</a>.
          You can opt out with the
          {' '}<a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">Google Analytics Opt-out Browser Add-on</a>.
        </p>
        <h3>Microsoft Clarity</h3>
        <p>
          We use Microsoft Clarity to see how visitors interact with the Site through session
          recordings, heatmaps, and usage statistics (for example, clicks, scrolling, and mouse
          movement). This helps us find and fix usability problems. Clarity uses cookies (such as{' '}
          <code>_clck</code> and <code>_clsk</code>) and similar technologies. Microsoft states that
          Clarity masks sensitive text input by default. Learn more in the
          {' '}<a href="https://privacy.microsoft.com/privacystatement" target="_blank" rel="noopener noreferrer">Microsoft Privacy Statement</a>
          {' '}and Microsoft’s
          {' '}<a href="https://learn.microsoft.com/en-us/clarity/setup-and-installation/cookie-list" target="_blank" rel="noopener noreferrer">Clarity cookie documentation</a>.
        </p>
        <h3>How to opt out</h3>
        <ul>
          <li>
            <strong>Browser settings:</strong> most browsers let you block or delete cookies, or browse
            in a private window. Blocking cookies won’t stop you from using the Site.
          </li>
          <li>
            <strong>Google Analytics:</strong> install the opt-out add-on linked above.
          </li>
          <li>
            <strong>Content and tracker blockers:</strong> browser extensions and privacy features that
            block analytics scripts will prevent Google Analytics and Clarity from loading.
          </li>
          <li>
            <strong>Do Not Track:</strong> there is no common industry standard for “Do Not Track”
            browser signals, and the Site does not currently respond to them.
          </li>
        </ul>

        <h2 id="retention">6. Data Retention</h2>
        <p>
          We keep contact form submissions and related correspondence for as long as needed to respond to
          you, provide services, maintain business records, and meet legal obligations, and then delete or
          de-identify them. Analytics data is retained according to the settings and policies of the
          analytics providers.
        </p>

        <h2 id="security">7. Security</h2>
        <p>
          We use reasonable administrative, technical, and physical safeguards to protect information,
          including encrypted (HTTPS) connections to the Site. No method of transmission or storage is
          completely secure, however, so we cannot guarantee absolute security. Please do not send
          sensitive information (such as payment card or Social Security numbers) through the contact form.
        </p>

        <h2 id="your-rights">8. Your Rights &amp; Requests</h2>
        <p>
          You may ask us to access, correct, or delete personal information you have provided to us by
          contacting us using the details below. Depending on where you live and whether a law applies to
          us, you may have additional rights under state privacy laws, such as the Colorado Privacy Act.
          We will respond to verifiable requests as required by applicable law. We will not discriminate
          against you for exercising your privacy rights.
        </p>

        <h2 id="third-party-links">9. Third-Party Links</h2>
        <p>
          The Site may link to websites we do not operate, such as fire departments, permitting agencies,
          maps, and social media. We are not responsible for the privacy practices of those sites, and we
          encourage you to review their policies.
        </p>

        <h2 id="children">10. Children’s Privacy</h2>
        <p>
          The Site is intended for property owners, managers, and businesses. It is not directed to children
          under 13, and we do not knowingly collect personal information from children. If you believe a
          child has provided us with personal information, please contact us and we will delete it.
        </p>

        <h2 id="changes">11. Changes to This Policy</h2>
        <p>
          We may update this Privacy Policy from time to time to reflect changes to the Site or our
          practices. When we do, we will revise the “Last updated” date at the top of this page. Your
          continued use of the Site after an update means you accept the revised policy.
        </p>

        <h2 id="contact">12. Contact Us</h2>
        <p>If you have questions about this Privacy Policy or want to make a privacy request, contact us:</p>
        <address class="pp__address">
          <strong>Red Rocks Fire Protection Services</strong><br />
          {contact.address.line1}<br />
          {contact.address.city}, {contact.address.state} {contact.address.zip}<br />
          Email: <a href={contact.emailHref}>{contact.email}</a><br />
          Phone: <a href={contact.phoneHref}>{contact.phone}</a>
        </address>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Page-title banner — same values as contact.astro §0. */
  .ptbanner {
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center center;
    min-height: 450px;
    padding-top: 154px;
    padding-bottom: 20px;
    display: flex;
    align-items: flex-end;
  }
  .ptbanner__inner {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 15px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .ptbanner__title {
    margin: 0;
    color: #ffffff;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: clamp(38px, 5.5vw, 75px);
    line-height: 104px;
    letter-spacing: -0.05em;
    text-transform: uppercase;
  }
  .ptbanner__breadcrumbs {
    color: #ffffff;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 30px;
    letter-spacing: -0.04em;
    padding-bottom: 14px;
  }
  .ptbanner__breadcrumbs a { color: #ffffff; text-decoration: none; transition: 0.4s; }
  .ptbanner__breadcrumbs a:hover { color: #ffffff99; }
  .ptbanner__divider { margin: 0 10px; }
  .ptbanner__current { text-decoration: underline; text-underline-offset: 4px; }

  /* Policy body */
  .pp { background: #ffffff; padding-block: 96px; }
  @media (min-width: 768px) { .pp { padding-block: 120px; } }
  .pp__inner { max-width: 860px; }

  .pp__updated {
    margin: 0 0 18px;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--av-primary);
  }
  .pp__lead {
    margin: 0 0 36px;
    font-size: 18px;
    line-height: 1.6;
    color: #3a3a3a;
  }

  .pp__toc {
    margin: 0 0 56px;
    padding: 28px 32px;
    background: #f5f5f5;
    border-left: 4px solid var(--av-primary);
  }
  .pp__toc-title {
    margin: 0 0 12px;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0a0a0a;
  }
  .pp__toc ol {
    margin: 0;
    padding-left: 20px;
    columns: 2;
    column-gap: 32px;
    font-size: 15px;
    line-height: 1.9;
  }
  @media (max-width: 600px) { .pp__toc ol { columns: 1; } }
  .pp .pp__toc a { color: #0a0a0a; text-decoration: none; }
  .pp .pp__toc a:hover { color: var(--av-primary); }

  .pp h2 {
    margin: 56px 0 16px;
    scroll-margin-top: 120px;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1.15;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: #0a0a0a;
  }
  .pp h3 {
    margin: 28px 0 8px;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.01em;
    color: #0a0a0a;
  }
  .pp p,
  .pp li,
  .pp__address {
    font-size: 16px;
    line-height: 1.7;
    color: #3a3a3a;
  }
  .pp p { margin: 0 0 16px; }
  .pp ul { margin: 0 0 16px; padding-left: 22px; }
  .pp li { margin-bottom: 10px; }
  .pp li::marker { color: var(--av-primary); }
  .pp a { color: var(--av-primary); text-decoration: underline; text-underline-offset: 3px; }
  .pp a:hover { color: #0a0a0a; }
  .pp code {
    font-size: 0.92em;
    padding: 1px 5px;
    background: #f2f2f2;
  }
  .pp__address {
    font-style: normal;
    margin: 0;
    padding: 24px 28px;
    background: #f5f5f5;
  }

  @media (max-width: 1200px) {
    .ptbanner__title { font-size: 64px; line-height: 72px; }
  }
  @media (max-width: 767px) {
    .ptbanner { min-height: 320px; padding-top: 120px; }
    .ptbanner__title { font-size: 40px; line-height: 48px; }
    .pp { padding-block: 64px; }
    .pp__toc { padding: 22px 20px; }
  }
</style>
