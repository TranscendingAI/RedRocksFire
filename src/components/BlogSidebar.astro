---
/**
 * BlogSidebar — right rail for /blog.
 *
 * Vertical stack of 4 widgets, top-to-bottom:
 *   1. Author card (red square; matches blog-card height)
 *   2. Categories list (services catalog rendered as bullets)
 *   3. Latest posts list (top N posts, 70x70 thumb + date + title)
 *   4. CTA card (hard-hat bg + overlay + "Get in Touch" button)
 *
 * No search bar — see blog archive design decision (omitted as unnecessary).
 *
 * Props:
 *   - posts: BlogCollection[] — full blog collection, newest-first
 *   - services: typeof services.catalog — services to render as categories
 *   - author: { name, role, avatar, socials: {x, facebook, instagram, linkedin} }
 *   - latestCount: number — how many posts in the Latest list (default 4)
 */

interface BlogPost {
  id: string;
  data: {
    title: string;
    publishDate: Date;
    category: string;
    featuredImage: string;
    featuredImageAlt: string;
  };
}

interface ServiceItem {
  key: string;
  title: string;
}

interface AuthorInfo {
  name: string;
  role: string;
  avatar: string;
  socials: {
    x: string;
    facebook: string;
    instagram: string;
    linkedin: string;
  };
}

interface Props {
  posts: BlogPost[];
  services: readonly ServiceItem[];
  author: AuthorInfo;
  latestCount?: number;
}

const {
  posts,
  services,
  author,
  latestCount = 4,
} = Astro.props;

function formatDate(d: Date): string {
  return d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

// Slice the top N posts for the "Latest Posts" widget. The cards column on
// the left already shows every post, so the sidebar repeats the top few as
// a quick navigation aid.
const latestPosts = posts.slice(0, latestCount);

// Arrow path used in the CTA "Get in Touch" button.
const arrowPath =
  'M0 6.78247C0 6.52555 0.102065 6.27914 0.283741 6.09746C0.465416 5.91579 0.711822 5.81372 0.96875 5.81372H12.1927L8.03288 1.65585C7.85097 1.47394 7.74878 1.22723 7.74878 0.969974C7.74878 0.712721 7.85097 0.466004 8.03288 0.284099C8.21478 0.102194 8.4615 0 8.71875 0C8.976 0 9.22272 0.102194 9.40463 0.284099L15.2171 6.0966C15.3073 6.18659 15.3789 6.29349 15.4278 6.41118C15.4766 6.52888 15.5017 6.65505 15.5017 6.78247C15.5017 6.9099 15.4766 7.03607 15.4278 7.15376C15.3789 7.27146 15.3073 7.37836 15.2171 7.46835L9.40463 13.2808C9.22272 13.4628 8.976 13.5649 8.71875 13.5649C8.4615 13.5649 8.21478 13.4628 8.03288 13.2808C7.85097 13.0989 7.74878 12.8522 7.74878 12.595C7.74878 12.3377 7.85097 12.0910 8.03288 11.9091L12.1927 7.75122H0.96875C0.711822 7.75122 0.465416 7.64916 0.283741 7.46748C0.102065 7.28581 0 7.0394 0 6.78247Z';
---

<aside class="bsb">
  <!-- 1. AUTHOR CARD -->
  <div class="bsb__author">
    <img
      class="bsb__author-avatar"
      src={author.avatar}
      alt={`${author.name}, ${author.role}`}
      loading="lazy"
      decoding="async"
    />
    <h3 class="bsb__author-name">{author.name}</h3>
    <p class="bsb__author-role">{author.role}</p>
    <div class="bsb__author-socials" aria-label={`${author.name} social links`}>
      <a href={author.socials.x} class="bsb__social" aria-label="X / Twitter" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a href={author.socials.facebook} class="bsb__social" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </a>
      <a href={author.socials.instagram} class="bsb__social" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
      </a>
      <a href={author.socials.linkedin} class="bsb__social" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
    </div>
  </div>

  <!-- 2. CATEGORIES LIST -->
  <div class="bsb__widget">
    <h3 class="bsb__widget-title">Categories</h3>
    <ul class="bsb__cat-list">
      {services.map((service) => (
        <li class="bsb__cat-item">{service.title}</li>
      ))}
    </ul>
  </div>

  <!-- 3. LATEST POSTS -->
  <div class="bsb__widget">
    <h3 class="bsb__widget-title">Latest Posts</h3>
    <ul class="bsb__lp-list">
      {latestPosts.map((post) => (
        <li class="bsb__lp-item">
          <a href={`/blog/${post.id}/`} class="bsb__lp-link">
            <img
              class="bsb__lp-thumb"
              src={post.data.featuredImage}
              alt={post.data.featuredImageAlt}
              loading="lazy"
              decoding="async"
            />
            <span class="bsb__lp-text">
              <span class="bsb__lp-date">
                <time datetime={post.data.publishDate.toISOString()}>
                  {formatDate(post.data.publishDate)}
                </time>
              </span>
              <span class="bsb__lp-title">{post.data.title}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- 4. CTA CARD -->
  <div class="bsb__cta">
    <div
      class="bsb__cta-bg"
      style="background-image: url('/images/rrfps-hard-hat-cta.jpg');"
      aria-hidden="true"
    ></div>
    <div class="bsb__cta-overlay" aria-hidden="true"></div>
    <div class="bsb__cta-body">
      <h3 class="bsb__cta-title">Ready to Work Together?</h3>
      <a href="/contact" class="av-wgl-btn bsb__cta-btn">
        <span class="av-wgl-btn__text">Read Our Story</span>
        <span class="av-wgl-btn__icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg>
        </span>
      </a>
    </div>
  </div>
</aside>

<style>
  .bsb {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* ── 1. AUTHOR CARD ───────────────────────────────────────────── */
  .bsb__author {
    position: relative;
    isolation: isolate;
    /* aspect-ratio: 1/1 was locking the card to the sidebar width on
       desktop (~236px), squeezing the avatar/name/socials. Bumping the
       vertical padding and dropping the aspect lock so the card grows
       tall naturally on every breakpoint. */
    min-height: 360px;
    background: var(--rr-red);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* Generous top/bottom padding so the avatar + name + socials breathe. */
    padding: 72px 20px;
    color: #ffffff;
    overflow: hidden;
  }
  .bsb__author-avatar {
    width: 50%;
    max-width: 180px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 50%;
    margin-bottom: 22px;
    border: 4px solid rgba(255, 255, 255, 0.85);
  }
  .bsb__author-name {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-align: center;
  }
  .bsb__author-role {
    margin: 4px 0 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-align: center;
  }
  .bsb__author-socials {
    margin-top: 22px;
    display: flex;
    gap: 14px;
    align-items: center;
    justify-content: center;
  }
  .bsb__social {
    /* No shape background — just the white icon glyph (per request). */
    display: grid;
    place-items: center;
    color: #ffffff;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .bsb__social:hover {
    opacity: 0.7;
    transform: translateY(-1px);
  }
  .bsb__social svg { width: 16px; height: 16px; }

  /* ── 2/3. WIDGET SHARED (Categories + Latest Posts) ──────────── */
  .bsb__widget {
    background: #ffffff;
    border: 1px solid var(--rr-border-lt, rgba(10, 10, 10, 0.12));
    padding: 24px 22px;
  }
  .bsb__widget-title {
    margin: 0 0 18px;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--rr-black, #0a0a0a);
    text-transform: none;
  }

  /* Categories */
  .bsb__cat-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bsb__cat-item {
    position: relative;
    padding: 12px 0 12px 22px;
    font-size: 0.9375rem;
    color: var(--rr-black, #0a0a0a);
    border-bottom: 1px solid var(--rr-border-lt, rgba(10, 10, 10, 0.08));
    line-height: 1.4;
  }
  .bsb__cat-item:last-child { border-bottom: 0; }
  .bsb__cat-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    margin-top: -3px;
    width: 6px;
    height: 6px;
    background: var(--rr-red, #d41226);
    transform: rotate(45deg);
  }

  /* Latest Posts */
  .bsb__lp-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bsb__lp-item {
    border-bottom: 1px solid var(--rr-border-lt, rgba(10, 10, 10, 0.08));
  }
  .bsb__lp-item:last-child { border-bottom: 0; }
  .bsb__lp-link {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    text-decoration: none;
    color: inherit;
    align-items: center;
  }
  .bsb__lp-thumb {
    flex: 0 0 70px;
    width: 70px;
    height: 70px;
    object-fit: cover;
    display: block;
  }
  .bsb__lp-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }
  .bsb__lp-date {
    color: var(--rr-grey, #626262);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .bsb__lp-title {
    margin-top: 4px;
    color: var(--rr-black, #0a0a0a);
    font-family: "Space Grotesk", sans-serif;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    /* 2-line clamp */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: text-decoration-color 0.15s ease;
  }
  .bsb__lp-link:hover .bsb__lp-title {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  /* ── 4. CTA CARD ──────────────────────────────────────────────── */
  .bsb__cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* Dropped aspect-ratio: 1/1 — user wants the card taller so the hard-hat
       is visible above the title and the title has breathing room from
       the button. */
    min-height: 380px;
    display: flex;
    align-items: stretch; /* let .bsb__cta-body fill the full height */
  }
  .bsb__cta-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    z-index: -2;
  }
  /* Lighter overlay so the hard-hat stays clearly visible. */
  .bsb__cta-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(212, 18, 38, 0.25) 0%,
      rgba(212, 18, 38, 0.6) 100%
    );
    z-index: -1;
  }
  .bsb__cta-body {
    /* Flex so the title sits at the top of the column and the button
       pins to the bottom — letting the hard-hat bg fill the space
       between them. */
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1; /* fill .bsb__cta so top + bottom anchors actually have room */
    padding: 28px 24px 26px;
    color: #ffffff;
    width: 100%;
  }
  .bsb__cta-title {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(1.5rem, 2vw, 1.875rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #ffffff;
    text-transform: none;
  }
  /* WGL button — white border, transparent bg, white text. Matches the
     "Read Our Story" button on about.astro's Why We Exist section.
     Hover inverts: filled white bg + black text. */
  .bsb__cta-btn {
    --av-wgl-btn-bg: transparent;
    --av-wgl-btn-color: #ffffff;
    --av-wgl-btn-border: #ffffff;
    --av-wgl-btn-bg-hover: #ffffff;
    --av-wgl-btn-color-hover: #0a0a0a;
    --av-wgl-btn-border-hover: #ffffff;
    --av-wgl-icon-wrapper: 52px;
    font-size: 14px;
    line-height: 20px;
  }
  .bsb__cta-btn .av-wgl-btn__text { padding: 14px 26px; }
  .bsb__cta-btn .av-wgl-btn__icon svg { width: 14px; height: 12px; }

  /* ── Responsive ──────────────────────────────────────────────── */
  /* No aspect-ratio override needed here anymore — the author card uses
     min-height + flex to size itself on every breakpoint. The padding
     stays consistent across desktop/tablet/mobile. */
</style>