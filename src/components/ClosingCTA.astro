---
/**
 * ClosingCTA — About page closing section (replaces the DualCTA on About only).
 *
 * Design (per client reference): a rounded-rectangle banner (NOT full width) with a
 * background photo and a left→right gradient overlay — solid #EEECED on the left where
 * all the copy sits, fading to transparent on the right so the photo shows through.
 * Three white pill buttons span the bottom, each with a red circular icon on the left
 * and a red circular arrow on the right.
 *
 * Content: src/data/site.ts → about.closingCta
 *
 * Per-page override: pass `paragraphs` (string[]) to replace just the intro
 * copy while keeping the shared title, buttons, phone, and background. When
 * omitted, falls back to the shared about.closingCta.paragraphs (About page).
 */

import { about } from '../data/site';

interface Props {
  paragraphs?: readonly string[];
  backgroundImage?: string;
}

const { paragraphs, backgroundImage } = Astro.props;

const cta = about.closingCta;
const introParagraphs = paragraphs ?? cta.paragraphs;
const bgImage = backgroundImage ?? cta.backgroundImage;

const arrowPath =
  'M0 6.78247C0 6.52555 0.102065 6.27914 0.283741 6.09746C0.465416 5.91579 0.711822 5.81372 0.96875 5.81372H12.1927L8.03288 1.65585C7.85097 1.47394 7.74878 1.22723 7.74878 0.969974C7.74878 0.712721 7.85097 0.466004 8.03288 0.284099C8.21478 0.102194 8.4615 0 8.71875 0C8.976 0 9.22272 0.102194 9.40463 0.284099L15.2171 6.0966C15.3073 6.18659 15.3789 6.29349 15.4278 6.41118C15.4766 6.52888 15.5017 6.65505 15.5017 6.78247C15.5017 6.9099 15.4766 7.03607 15.4278 7.15376C15.3789 7.27146 15.3073 7.37836 15.2171 7.46835L9.40463 13.2808C9.22272 13.4628 8.976 13.5649 8.71875 13.5649C8.4615 13.5649 8.21478 13.4628 8.03288 13.2808C7.85097 13.0989 7.74878 12.8522 8.03288 11.9091L12.1927 7.75122H0.96875C0.711822 7.75122 0.465416 7.64916 0.283741 7.46748C0.102065 7.28581 0 7.0394 0 6.78247Z';

const flameIcon =
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2s5 4.5 5 9a5 5 0 0 1-10 0c0-1.7.9-3.2 1.7-4.2C8.4 8.3 9 9.4 9.9 9.9 9.4 8 10.2 4.8 12 2Z"/></svg>';
---

<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&display=swap"
/>

<section class="cta">
  <div class="cta__card">
    <div
      class="cta__bg"
      style={`background-image: url('${bgImage}');`}
      aria-hidden="true"
    ></div>
    <div class="cta__overlay" aria-hidden="true"></div>

    <div class="cta__body">
      <h2 class="cta__title">
        <span class="cta__title-1">{cta.titleLine1}</span>
        <span class="cta__title-2">{cta.titleLine2}</span>
        <span class="cta__script">
          <span class="cta__script-rule" aria-hidden="true"></span>
          {cta.script}
        </span>
      </h2>

      {introParagraphs.map((paragraph) => <p class="cta__para">{paragraph}</p>)}

      <p class="cta__para">
        {cta.closer} <strong>{cta.closerBold}</strong>
      </p>

      <p class="cta__phone">
        <span class="cta__phone-icon" aria-hidden="true">
          <iconify-icon icon="solar:phone-bold" width="18" height="18"></iconify-icon>
        </span>
        <span>
          Ready to start the conversation? Call us at{' '}
          <a href={`tel:${cta.phone.tel}`} class="cta__phone-num">{cta.phone.display}</a>{' '}
          or <a href={cta.contactHref} class="cta__contact-link">Contact Us</a> to connect with our team.
        </span>
      </p>

      <div class="cta__divider" aria-hidden="true">
        <span class="cta__divider-line"></span>
        <span class="cta__divider-mark" set:html={flameIcon} />
        <span class="cta__divider-line"></span>
      </div>

      <p class="cta__subcopy">
        {cta.subCopyLine1}<br />
        {cta.subCopyLine2}
      </p>

      <div class="cta__buttons">
        {cta.buttons.map((button) => (
          <a href={button.href} class="cta__btn">
            <span class="cta__btn-icon" aria-hidden="true">
              <iconify-icon icon={button.icon} width="22" height="22"></iconify-icon>
            </span>
            <span class="cta__btn-label">{button.label}</span>
            <span class="cta__btn-arrow" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor"><path d={arrowPath}></path></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .cta { background: #ffffff; }
  /* Full-bleed: the section spans the entire viewport edge-to-edge.
     The cream gradient still covers the left ~half so the copy reads
     against light; the photo bleeds off the right edge. */
  .cta {
    width: 100%;
  }

  .cta__card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* No border-radius / shadow — this is a full-bleed section now,
       not a contained card. */
  }
  .cta__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center right;
    /* Horizontally mirror the photo per client request. */
    transform: scaleX(-1);
    z-index: 0;
  }
  /* Left→right gradient: solid light where the copy sits, fading to the photo. */
  .cta__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      #eeeced 0%,
      #eeeced 34%,
      rgba(238, 236, 237, 0.94) 46%,
      rgba(238, 236, 237, 0.55) 58%,
      rgba(238, 236, 237, 0) 74%
    );
    z-index: 0;
  }

  /* Content sits in the left portion of the viewport on desktop so it
     reads against the solid-light portion of the gradient. The body
     wrapper caps at 1280px (centered) for predictable margins, but
     individual text elements stay narrower (560px) for readability,
     and the button row can extend wider to match the screenshot. */
  .cta__body {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin-inline: auto;
    padding: 64px 64px 44px;
  }
  .cta__body > * { max-width: 560px; }
  /* The button row spans the FULL width of the body content box (the copy
     stays capped at 560px on the left; the three buttons run edge-to-edge
     across the bottom of the full-bleed banner). */
  .cta__body > .cta__buttons { max-width: none; }

  .cta__title {
    margin: 0 0 26px;
    font-family: "Space Grotesk", "Archivo Variable", sans-serif;
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-transform: none;
  }
  .cta__title-1,
  .cta__title-2 {
    display: block;
    font-size: clamp(34px, 3.4vw, 52px);
  }
  .cta__title-1 { color: #171717; }
  .cta__title-2 { color: #d41226; }
  .cta__script {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 8px;
    font-family: "Dancing Script", cursive;
    font-weight: 700;
    font-size: clamp(30px, 3vw, 44px);
    letter-spacing: 0;
    color: #171717;
  }
  .cta__script-rule {
    display: inline-block;
    width: 44px;
    height: 3px;
    background: #d41226;
    border-radius: 2px;
  }

  .cta__para {
    margin: 0 0 16px;
    max-width: 560px;
    color: #333234;
    font-size: 16px;
    line-height: 1.7;
  }
  .cta__para strong { color: #171717; font-weight: 700; }

  .cta__phone {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin: 22px 0 0;
    max-width: 560px;
    color: #333234;
    font-size: 16px;
    line-height: 1.6;
  }
  .cta__phone-icon {
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #d41226;
    color: #ffffff;
    margin-top: 1px;
  }
  .cta__phone-num { color: #d41226; font-weight: 700; text-decoration: none; }
  .cta__phone-num:hover { text-decoration: underline; }
  .cta__contact-link { color: #d41226; font-weight: 600; text-decoration: underline; }

  .cta__divider {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 30px 0;
    max-width: 560px;
  }
  .cta__divider-line {
    flex: 1;
    height: 1px;
    background: rgba(10, 10, 10, 0.16);
  }
  .cta__divider-mark {
    display: inline-flex;
    color: #d41226;
  }
  .cta__divider-mark :global(svg) { width: 20px; height: 20px; }

  .cta__subcopy {
    margin: 0 0 34px;
    max-width: 560px;
    color: #4a494b;
    font-size: 15px;
    line-height: 1.7;
  }

  .cta__buttons {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    /* Span the full width of the body content box so the three equal-width
       buttons run across the bottom of the banner. `minmax(0, 1fr)` keeps
       them equal and prevents any button from overflowing its track. */
    width: 100%;
    max-width: none;
  }
  .cta__btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 12px;
    background: #ffffff;
    border: 1px solid rgba(10, 10, 10, 0.08);
    border-radius: 14px;
    box-shadow: 0 8px 20px rgba(10, 10, 10, 0.08);
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .cta__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 28px rgba(10, 10, 10, 0.14);
  }
  .cta__btn-icon {
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #d41226;
    color: #ffffff;
  }
  .cta__btn-label {
    flex: 1;
    min-width: 0;
    font-family: "Space Grotesk", "Archivo Variable", sans-serif;
    font-weight: 700;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: #171717;
  }
  .cta__btn-arrow {
    flex: 0 0 28px;
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #d41226;
    color: #ffffff;
  }
  .cta__btn-arrow svg { width: 13px; height: 12px; }

  @media (max-width: 1100px) {
    .cta__body { max-width: 72%; padding: 48px 48px 36px; }
    .cta__overlay {
      background: linear-gradient(
        100deg,
        #eeeced 0%,
        #eeeced 44%,
        rgba(238, 236, 237, 0.9) 58%,
        rgba(238, 236, 237, 0) 84%
      );
    }
  }

  @media (max-width: 767px) {
    .cta__body {
      max-width: 100%;
      padding: 34px 26px 30px;
    }
    /* On mobile the photo can't share the row — cover it fully for legibility. */
    .cta__overlay {
      background: linear-gradient(
        180deg,
        #eeeced 0%,
        rgba(238, 236, 237, 0.96) 100%
      );
    }
    .cta__buttons {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
