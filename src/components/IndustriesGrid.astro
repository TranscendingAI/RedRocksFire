---
/**
 * IndustriesGrid — the "Industries We Serve" section, extracted verbatim from
 * about.astro so the exact same block can be reused on multiple pages
 * (about, /industries-we-serve, fire-sprinkler) with zero copy drift.
 *
 * Renders the 14 industry cards from `about.industries` (single source of
 * truth in src/data/site.ts). Markup + scoped CSS are lifted 1:1 from the
 * original about.astro section so rendered output stays pixel-identical.
 *
 * Because Astro scopes styles per-component, the base layout helpers this
 * section relies on (.section-inner, .section-title, etc.) are copied in
 * here so the component looks correct on any page that mounts it — not just
 * inside about.astro. The .av-dblh__subtitle / .divider-icon styles are
 * global (BaseLayout) and are intentionally NOT re-declared.
 */

import { about } from '../data/site';

const arrowPath = 'M0 6.78247C0 6.52555 0.102065 6.27914 0.283741 6.09746C0.465416 5.91579 0.711822 5.81372 0.96875 5.81372H12.1927L8.03288 1.65585C7.85097 1.47394 7.74878 1.22723 7.74878 0.969974C7.74878 0.712721 7.85097 0.466004 8.03288 0.284099C8.21478 0.102194 8.4615 0 8.71875 0C8.976 0 9.22272 0.102194 9.40463 0.284099L15.2171 6.0966C15.3073 6.18659 15.3789 6.29349 15.4278 6.41118C15.4766 6.52888 15.5017 6.65505 15.5017 6.78247C15.5017 6.9099 15.4766 7.03607 15.4278 7.15376C15.3789 7.27146 15.3073 7.37836 15.2171 7.46835L9.40463 13.2808C9.22272 13.4628 8.976 13.5649 8.71875 13.5649C8.4615 13.5649 8.21478 13.4628 8.03288 13.2808C7.85097 13.0989 7.74878 12.8522 7.74878 12.595C7.74878 12.3377 7.85097 12.091 8.03288 11.9091L12.1927 7.75122H0.96875C0.711822 7.75122 0.465416 7.64916 0.283741 7.46748C0.102065 7.28581 0 7.0394 0 6.78247Z';

const diamondIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="20" viewBox="0 0 15 20"><path d="M0.660472 19.6191L0.47542 6.53585L13.7437 19.8041L0.660472 19.6191Z"></path><path d="M14.3396 0.939992L14.5246 14.0232L1.25635 0.754941L14.3396 0.939992Z"></path></svg>';
---

<section class="industries">
  <div class="section-inner section-inner--wide industries__inner">
    <div class="section-head industries__head">
      <div class="industries__head-copy">
        <div class="av-dblh__subtitle section-eyebrow">
          <span class="divider-icon" set:html={diamondIcon} />
          <span>{about.industries.eyebrow}</span>
        </div>
        <h2 class="section-title industries__title">{about.industries.title}</h2>
      </div>
      <a href="/services" class="av-wgl-btn av-wgl-btn--outline industries__cta">
        <span class="av-wgl-btn__text">All Services</span>
        <span class="av-wgl-btn__icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg>
        </span>
      </a>
    </div>

    <div class="industries__grid">
      {about.industries.items.map((item) => (
        <a href={item.href} class="industry-card">
          <div class="industry-card__image-wrap">
            <img
              src={item.image ?? about.industries.cardImage}
              alt=""
              loading="lazy"
              decoding="async"
              class="industry-card__image"
              style={'imagePosition' in item ? `object-position: ${(item as { imagePosition: string }).imagePosition};` : undefined}
            />
          </div>
          <div class="industry-card__body">
            <h3>{item.title}</h3>
            <p class="industry-card__meta">{item.meta}</p>
            <span class="industry-card__link">
              Learn more
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 14" fill="currentColor" aria-hidden="true"><path d={arrowPath}></path></svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Base layout helpers (copied from about.astro so this component
        renders identically on any page, not just inside about) ── */
  .section-inner {
    width: 100%;
    max-width: 1120px;
    margin-inline: auto;
    padding: 110px 80px;
  }
  .section-inner--wide { max-width: 1340px; }
  .section-head { max-width: 850px; margin-bottom: 58px; }
  .section-eyebrow { margin-bottom: 23px; display: flex; }
  .section-title {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(38px, 5vw, 64px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    color: #0a0a0a;
  }

  /* ── Industries section (verbatim from about.astro) ── */
  .industries {
    background: #ffffff;
    color: #0a0a0a;
  }
  .industries__inner { padding-top: 96px; padding-bottom: 96px; }
  .industries__head {
    max-width: none;
    margin-bottom: 26px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
  }
  .industries__head-copy { max-width: 860px; }
  .industries__title {
    max-width: 920px;
    font-size: clamp(40px, 4.8vw, 66px);
    line-height: 1.02;
  }
  .industries__cta {
    flex-shrink: 0;
    margin-bottom: 8px;
  }
  .industries__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px 28px;
  }
  .industry-card {
    display: flex;
    flex-direction: column;
    color: #0a0a0a;
    text-decoration: none;
    border: 1px solid rgba(10, 10, 10, 0.16);
    background: #ffffff;
    transition: transform 0.35s, box-shadow 0.35s, border-color 0.35s;
  }
  .industry-card__image-wrap {
    aspect-ratio: 2.6 / 1;
    overflow: hidden;
    background: #e8e8e8;
  }
  .industry-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .industry-card__body {
    min-height: 116px;
    padding: 0 14px 0;
    display: flex;
    flex-direction: column;
  }
  .industry-card h3 {
    margin: 2px 0 2px;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(17px, 1.3vw, 21px);
    font-weight: 700;
    line-height: 1.08;
    text-transform: uppercase;
    color: #0a0a0a;
  }
  .industry-card__meta {
    margin: 0;
    color: #414141;
    font-size: 14px;
    line-height: 1.35;
    text-transform: lowercase;
  }
  .industry-card__link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: "Space Grotesk", sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    width: 100%;
    justify-content: space-between;
    padding: 12px 0 10px;
    border-top: 1px solid rgba(212, 18, 38, 0.55);
    color: #0a0a0a;
  }
  .industry-card__link svg {
    width: 18px;
    height: 16px;
    color: #d41226;
  }
  .industry-card:hover {
    transform: translateY(-3px);
    border-color: rgba(212, 18, 38, 0.28);
    box-shadow: 0 16px 34px rgba(0, 0, 0, 0.08);
  }
  .industry-card:hover .industry-card__link { color: #d41226; }

  /* ── Responsive (verbatim from about.astro breakpoints) ── */
  @media (max-width: 1100px) {
    .section-inner { padding: 90px 60px; }
    .industries__head {
      flex-direction: column;
      align-items: flex-start;
    }
    .industries__cta { margin-bottom: 0; }
    .industries__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .section-inner { padding: 70px 28px; }
    .section-head { margin-bottom: 40px; }
    .section-title { font-size: 36px; }
    .industries__grid { grid-template-columns: 1fr; }
    .industries__inner { padding-top: 72px; padding-bottom: 72px; }
    .industries__head {
      margin-bottom: 20px;
      gap: 16px;
    }
    .industries__title { font-size: 38px; }
    .industry-card__body {
      min-height: 0;
      padding-inline: 12px;
    }
    .industry-card h3 { font-size: 16px; }
    .industry-card__meta { font-size: 13px; }
  }
</style>
