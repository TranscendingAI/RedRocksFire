  /* Mobile: collapse to a single column, full-width with a small inset. */
  @media (max-width: 980px) {
    .avh__item--about > .avh__submenu,
    .avh__item--industries > .avh__submenu {
      left: 16px !important;
      right: 16px !important;
      width: calc(100vw - 32px) !important;
