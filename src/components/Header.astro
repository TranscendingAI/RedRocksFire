---
/**
 * Header — 1:1 replica of the Avelon demo header (Elementor template 473),
 * with one addition: SERVICES is now a hover/click dropdown trigger (no
 * own-page navigation). Its dropdown menu lists "Services Overview"
 * (-> /services) and "Inspections" (-> /inspections).
 *
 *   Desktop:
 *     [ red logo box max(251px, 16.1%) ] [ right column:
 *         row 1 — social icons (left) · "Mon - Sat: 7.00am - 19.00pm" (right)
 *         row 2 — nav (94px tall, Space Grotesk 700 16px white) · CART · SEARCH ]
 *   Mobile (<1025px): 70px bar — logo left, white round hamburger right.
 *
 * Source of truth for nav data lives HERE so future nav edits are 1 place.
 */

import { contact } from '../data/site';

interface SubItem {
  href: string;
  label: string;
}

/**
 * Enhanced sub-item — used by the ABOUT dropdown. Renders as a tile card
 * (red icon square + title + body + LEARN MORE link) inside a 4-column
 * light-panel grid. Faithful to the colleague's screenshot.
 */
interface AboutSubItem extends SubItem {
  icon: string;        // iconify icon id
  body: string;        // short blurb shown under the title
}

interface NavItem {
  href?: string;
  label: string;
  /** If set, this nav item opens a dropdown of children instead of linking anywhere.
   *  Pass `AboutSubItem[]` for the rich tile-card dropdown layout. */
  children?: SubItem[] | AboutSubItem[];
}

/**
 * Industries We Serve dropdown — 14 sub-pages in 3 titled columns. Pages
 * all exist as light placeholders or fully-built landing pages.
 *
 * The 3-column titled mega-menu pattern (icon-square + label per row,
 * bold uppercase column title, no divider) is shared across the Industries
 * We Serve, Services, and Contact dropdowns — the per-column data shape
 * lives here, the shared CSS lives in `.avh__mm-*` rules below.
 */
interface MMItem extends SubItem {
  icon: string;   // iconify icon id, rendered in a small red square
}
interface MMColumn {
  title: string;
  items: MMItem[];
}
const industriesColumns: MMColumn[] = [
  {
    title: 'Property & Community',
    items: [
      { href: '/industries/multi-family-management-companies', label: 'Multi-Family Management Companies',              icon: 'mdi:domain' },
      { href: '/industries/commercial-property',               label: 'Commercial Properties & Management Companies',    icon: 'mdi:office-building' },
      { href: '/industries/hoa-management',                    label: 'HOA Management Companies',                        icon: 'mdi:home-group' },
      { href: '/industries/hotels-hospitality',                label: 'Hotels & Hospitality',                            icon: 'mdi:bed' },
      { href: '/industries/retail',                            label: 'Retail & Shopping Centers',                       icon: 'mdi:shopping' },
    ],
  },
  {
    title: 'Commercial & Institutional',
    items: [
      { href: '/industries/religious-institutions', label: 'Religious Institutions / Churches',        icon: 'mdi:church' },
      { href: '/industries/assisted-living',        label: 'Assisted Living Facilities & Healthcare',  icon: 'mdi:hospital-box' },
      { href: '/industries/education',              label: 'Education & Universities',                 icon: 'mdi:graduation-cap' },
      { href: '/industries/restaurants',            label: 'Restaurants & Food Trucks',                icon: 'mdi:silverware-fork-knife' },
      { href: '/industries/financial',              label: 'Financial Institutions',                   icon: 'mdi:bank' },
    ],
  },
  {
    title: 'Specialized Facilities',
    items: [
      { href: '/industries/warehouse-industrial',  label: 'Warehouse / Storage / Industrial',           icon: 'mdi:warehouse' },
      { href: '/industries/data-centers',          label: 'Data Centers',                               icon: 'mdi:server-network' },
      { href: '/industries/automotive',            label: 'Automotive Dealerships & Service Centers',   icon: 'mdi:car' },
      { href: '/industries/general-contractors',   label: 'General Contractors',                        icon: 'mdi:hard-hat' },
    ],
  },
];
/** Flat list of every industry sub-page — used for the mobile drawer and the
 *  isCurrent() roll-up (which just needs the hrefs, not the columns). */
const industriesNav: SubItem[] = industriesColumns.flatMap((c) => c.items);

/**
 * Services dropdown — 13 sub-pages in 3 titled columns. Layout matches
 * Industries We Serve: bold uppercase column titles, red square icon +
 * left-aligned label per row, items contained in cream panel.
 *
 * /services, /inspections, and /fire-sprinkler-service-and-systems are
 * already built. The remaining 10 are placeholder pages (see
 * src/pages/services/<slug>.astro).
 */
const servicesColumns: MMColumn[] = [
  {
    title: 'Explore Services',
    items: [
      { href: '/services',                                                label: 'Services Overview',     icon: 'mdi:file-document' },
      { href: '/inspections',                                             label: 'Inspections',           icon: 'mdi:clipboard-check' },
      { href: '/services/monitoring-services',                            label: 'Monitoring Services',   icon: 'mdi:monitor' },
      { href: '/services/24-hour-service',                                label: '24 Hour Service',       icon: 'mdi:alarm-clock' },
    ],
  },
  {
    title: 'Fire & Life Safety Systems',
    items: [
      { href: '/services/fire-alarm-service-and-systems',                 label: 'Fire Alarm Service & Systems',          icon: 'mdi:bell-ring' },
      { href: '/fire-sprinkler-service-and-systems',                      label: 'Fire Sprinkler Service & Systems',      icon: 'mdi:sprinkler' },
      { href: '/services/portable-fire-extinguishers',                     label: 'Portable Fire Extinguishers',           icon: 'mdi:fire-extinguisher' },
      { href: '/services/kitchen-hood-suppression-systems',               label: 'Kitchen Hood Suppression Systems',      icon: 'mdi:chef-hat' },
      { href: '/services/backflow-prevention-assemblies',                 label: 'Backflow Prevention Assemblies',        icon: 'mdi:pipe-valve' },
    ],
  },
  {
    title: 'Specialty & Support Services',
    items: [
      { href: '/services/distributed-antenna-systems',                    label: 'Distributed Antenna Systems (DAS)',                       icon: 'mdi:antenna' },
      { href: '/services/security-system-installation-and-monitoring',    label: 'Security System Installation & Monitoring',              icon: 'mdi:cctv' },
      { href: '/services/area-of-refuge-communication-systems',           label: 'Area of Refuge Communication Systems',                   icon: 'mdi:wheelchair-accessibility' },
      { href: '/services/consulting-services',                            label: 'Consulting Services',                                     icon: 'mdi:file-document' },
    ],
  },
];
/**
 * Contact mega menu — 2-column layout (different shape than Industries /
 * Services). Column 1 is a stack of icon + label + value rows (Office,
 * Phone, Email, Office Hours) separated by thin dividers, with social
 * icons below. Column 2 is "Get in Touch" copy + an embedded Google Map.
 *
 * Data shape differs from MMColumn because column-1 rows carry both a
 * label and a value (and an optional href for tel/mailto), not just an
 * href + label like the other dropdowns' items.
 */
interface ContactRow {
  icon: string;
  label: string;
  value: string;
  href?: string;
}
const contactMenu = {
  info: {
    title: 'Contact Information',
    address: {
      icon: 'mdi:office-building-marker',
      label: 'Office',
      value: '7076 S Alton Way # G-2,\nCentennial, CO 80112, USA',
      href: contact.mapsUrl,
    },
    phone: {
      icon: 'mdi:phone',
      label: 'Phone',
      value: contact.phone,
      href: contact.phoneHref,
    },
    email: {
      icon: 'mdi:email',
      label: 'Email',
      value: contact.email,
      href: contact.emailHref,
    },
    hours: {
      icon: 'mdi:clock',
      label: 'Office Hours',
      value: `${contact.officeHours} ${contact.officeClosed}`,
    },
  },
  intro: {
    title: 'Our Location',
    subhead: "Let's Protect What Matters Most – Together.",
    body: '',
  },
  /** Address encoded for Google Maps embed; URL-escaped once. Matches the
   *  display string in contactMenu.info.address.value above. */
  mapsEmbedUrl: 'https://www.google.com/maps?q=7076+S+Alton+Way+%23+G-2+Centennial+CO+80112+USA&output=embed',
} as const;

/** Two social links shown below the contact rows (column 1). Facebook
 *  was removed (2026-08) per client edit. LinkedIn + Instagram both use
 *  generic root URLs from src/data/site.ts (no canonical handles yet) —
 *  flag for the client to confirm the real brand profile URLs. */
const menuSocials = [
  { label: 'LinkedIn',  href: contact.socials.linkedin },
  { label: 'Instagram', href: 'https://www.instagram.com/' },
];

const servicesNav: SubItem[] = servicesColumns.flatMap((c) => c.items);

/**
 * About dropdown — 8 tile cards, 4×2 grid. Faithful to the colleague's
 * screenshot. Two items currently share anchors (Our Story + Message from
 * Our CEO → #ceo-message; Our Promise + RRFPS Difference → #rrfps-difference)
 * because the relevant sections are where those topics live. "Our Credentials
 * & Certifications" has no page yet and points to # until one is built.
 */
const aboutNav: AboutSubItem[] = [
  { href: '/about',                     label: 'About RRFPS',                     icon: 'mdi:landscape',                 body: 'Discover who we are, what drives us, and our commitment to protecting people and property.' },
  { href: '/meet-the-team',             label: 'Meet Our Team',                   icon: 'mdi:account-group',            body: 'Meet the experienced professionals who lead, serve, and represent the RRFPS family.' },
  { href: '/about#ceo-message',         label: 'Our Story',                       icon: 'mdi:book-open-variant',         body: 'Learn how family, legacy, and a commitment to life safety shaped the RRFPS story.' },
  { href: '/about#fast-facts',          label: 'Mission / Vision / Values',       icon: 'mdi:compass',                   body: 'Explore the principles and purpose that guide how we serve our customers and one another.' },
  { href: '/about#rrfps-difference',    label: 'The RRFPS Difference',            icon: 'mdi:fire-circle',               body: 'See how advocacy, capability, and trust create a different fire protection experience.' },
  { href: '/about#rrfps-difference',    label: 'Our Promise',                     icon: 'mdi:handshake',                  body: 'The commitments we make to deliver responsive service, accountability, and peace of mind.' },
  { href: '#',                          label: 'Our Credentials & Certifications', icon: 'mdi:certificate',              body: 'Explore the credentials and certifications behind our commitment to professional life safety services.' },
  { href: '/about#ceo-message',         label: 'Message from Our CEO',            icon: 'mdi:account-voice',              body: 'Hear from CEO Brian Kakac about our purpose, our people, and the future of RRFPS.' },
];

const navItems: NavItem[] = [
  {
    label: 'ABOUT',
    children: aboutNav,
  },
  {
    label: 'SERVICES',
    children: [...servicesNav],
  },
  {
    label: 'INDUSTRIES WE SERVE',
    href: '/industries',
    children: [...industriesNav],
  },
  { href: '/testimonials', label: 'TESTIMONIALS' },
  { href: '/service-areas', label: 'SERVICE AREAS' },
  { href: '/blog', label: 'BLOG' },
  {
    label: 'CONTACT',
    href: '/contact',
    /* Contact is a 2-column mega menu; the submenu branch renders the
     * info rows + socials + "Get in Touch" + map directly from
     * contactMenu data instead of a flat children array. */
    children: [
      { href: '/contact', label: 'Contact' },
    ],
  },
];

const currentPath = typeof Astro !== 'undefined' ? Astro.url.pathname : '/';

/**
 * Match logic
 *  - Plain href items: current iff currentPath === href
 *  - Items with children: current iff currentPath matches any child href
 *    (so highlighting rolls up to the parent). This lets a top-level item
 *    styled as "active" stay active across /services, /inspections, etc.
 */
function isCurrent(item: NavItem): boolean {
  if (item.children && item.children.length) {
    return item.children.some((c) => currentPath === c.href || currentPath.startsWith(c.href + '/'));
  }
  if (!item.href) return false;
  if (item.href === '/') return currentPath === '/' || currentPath === '';
  return currentPath === item.href || currentPath.startsWith(item.href + '/');
}

const socials = [
  {
    href: 'https://www.instagram.com/', label: 'Instagram',
    path: 'M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z',
    viewBox: '0 0 448 512',
  },
  {
    href: 'https://linkedin.com/', label: 'Linkedin',
    path: 'M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z',
    viewBox: '0 0 448 512',
  },
];
---

<header transition:persist class="avh" data-header>
  {/* ── Desktop header ── */}
  <div class="avh__desktop">
    <div class="avh__logo-box">
      <a href="/" aria-label="Red Rocks Fire Protection home">
        <img
          src="/images/RRFPS_LOGO.png"
          alt="Red Rocks Fire Protection"
          class="avh__logo"
        />
      </a>
    </div>

    <div class="avh__right">
      <div class="avh__toprow">
        <div class="avh__socials">
          {socials.map((s) => (
            <a href={s.href} aria-label={s.label} class="avh__social" target="_blank" rel="noopener">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox={s.viewBox} fill="currentColor" aria-hidden="true">
                <path d={s.path}></path>
              </svg>
            </a>
          ))}
        </div>
        <h6 class="avh__hours">(720) 733-8050</h6>
      </div>

      <div class="avh__navrow">
        <nav aria-label="Primary" class="avh__nav">
          <ul>
            {navItems.map((item) => (
              <li class:list={['avh__item', item.children && 'avh__item--has-children', item.label === 'ABOUT' && 'avh__item--about', (item.label === 'INDUSTRIES WE SERVE' || item.label === 'SERVICES') && 'avh__item--mm', item.label === 'CONTACT' && 'avh__item--contact']}>
                {item.children ? (
                  /* Dropdown parent. If the item ALSO has an href, the label is a
                   * real link (<a>) that navigates on click while the dropdown
                   * still opens on hover/focus. Otherwise it's a non-navigating
                   * <button> toggle (ABOUT, SERVICES). */
                  <>
                    {item.href ? (
                      <a
                        href={item.href}
                        class:list={['avh__link', 'avh__link--trigger', isCurrent(item) && 'avh__link--current']}
                        aria-haspopup="menu"
                        aria-expanded="false"
                        data-dropdown-trigger
                        aria-current={isCurrent(item) ? 'page' : undefined}
                      >
                        <span>{item.label}</span>
                        <svg class="avh__caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
                          <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </a>
                    ) : (
                      <button
                        type="button"
                        class:list={['avh__link', 'avh__link--trigger', isCurrent(item) && 'avh__link--current']}
                        aria-haspopup="menu"
                        aria-expanded="false"
                        data-dropdown-trigger
                        aria-current={isCurrent(item) ? 'page' : undefined}
                      >
                        <span>{item.label}</span>
                        <svg class="avh__caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
                          <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </button>
                    )}
                    <ul class="avh__submenu" role="menu" data-dropdown-menu>
                      {item.label === 'CONTACT' ? (
                        /* Contact mega menu — 2 columns (info rows + socials
                         * on the left, copy + map on the right). Styled by
                         * .avh__contact-* rules. */
                        <li role="none" class="avh__contact-grid">
                          {/* ── Column 1: Contact Information ── */}
                          <div class="avh__contact-col">
                            <p class="avh__contact-title">{contactMenu.info.title}</p>
                            <div class="avh__contact-rows">
                              {[contactMenu.info.address, contactMenu.info.phone, contactMenu.info.email, contactMenu.info.hours].map((row) => {
                                const valueHtml = row.value.split('\n').map((line) => `<span>${line}</span>`).join('');
                                return (
                                  <div class="avh__contact-row">
                                    <span class="avh__contact-row-icon" aria-hidden="true">
                                      <iconify-icon icon={row.icon} width="22" height="22"></iconify-icon>
                                    </span>
                                    <div class="avh__contact-row-body">
                                      <div class="avh__contact-row-label">{row.label}</div>
                                      <div class="avh__contact-row-value">
                                        {row.href ? (
                                          <a href={row.href} set:html={valueHtml} />
                                        ) : (
                                          <span set:html={valueHtml} />
                                        )}
                                      </div>
                                    </div>
                                  </div>
                                );
                              })}
                            </div>
                            <div class="avh__contact-socials">
                              {menuSocials.map((s) => (
                                <a href={s.href} aria-label={s.label} class="avh__contact-social" target="_blank" rel="noopener noreferrer">
                                  {s.label === 'Facebook' && (
                                    <svg width="20" height="20" viewBox="0 0 320 512" aria-hidden="true" fill="currentColor"><path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"/></svg>
                                  )}
                                  {s.label === 'LinkedIn' && (
                                    <svg width="20" height="20" viewBox="0 0 448 512" aria-hidden="true" fill="currentColor"><path d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z"/></svg>
                                  )}
                                  {s.label === 'Instagram' && (
                                    <svg width="20" height="20" viewBox="0 0 448 512" aria-hidden="true" fill="currentColor"><path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9 114.9-51.3 114.9-114.9S287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"/></svg>
                                  )}
                                </a>
                              ))}
                            </div>
                          </div>
                          {/* ── Column 2: Get in Touch + map ── */}
                          <div class="avh__contact-col">
                            <p class="avh__contact-title">{contactMenu.intro.title}</p>
                            {/* Subhead + body restored (2026-08) — column 2 has the
                                "Our Location" title, a red subhead, then the map.
                                (Body paragraph removed per client edit, 2026-08-31.)
                                Per client edit v4. */}
                            <p class="avh__contact-subhead">{contactMenu.intro.subhead}</p>
                            <div class="avh__contact-map">
                              <iframe
                                src={contactMenu.mapsEmbedUrl}
                                title="RRFPS office location"
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade"
                                allowfullscreen
                              ></iframe>
                            </div>
                          </div>
                        </li>
                      ) : (item.label === 'INDUSTRIES WE SERVE' || item.label === 'SERVICES') ? (
                        /* Shared 3-column mega menu (Industries + Services).
                         * Renders title + icon-square + label per item from
                         * the per-label columns data (industriesColumns /
                         * servicesColumns). Styled by .avh__mm-* rules. */
                        (item.label === 'INDUSTRIES WE SERVE' ? industriesColumns : servicesColumns).map((col) => (
                          <li role="none" class="avh__mm-col">
                            <p class="avh__mm-col-title">{col.title}</p>
                            <ul class="avh__mm-col-list" role="none">
                              {col.items.map((child) => {
                                const isChildCurrent = currentPath === child.href || currentPath.startsWith(child.href + '/');
                                return (
                                  <li role="none">
                                    <a
                                      href={child.href}
                                      role="menuitem"
                                      class:list={['avh__mm-link', isChildCurrent && 'avh__mm-link--current']}
                                      aria-current={isChildCurrent ? 'page' : undefined}
                                    >
                                      <span class="avh__mm-icon" aria-hidden="true">
                                        <iconify-icon icon={child.icon} width="28" height="28"></iconify-icon>
                                      </span>
                                      <span class="avh__mm-label">{child.label}</span>
                                    </a>
                                  </li>
                                );
                              })}
                            </ul>
                          </li>
                        ))
                      ) : (
                      item.children.map((child) => {
                        const isChildCurrent = currentPath === child.href || currentPath.startsWith(child.href + '/');
                        /* Enhanced (rich-card) variant — used by ABOUT. Detected by
                         * the presence of the extra fields on AboutSubItem. */
                        if ('icon' in child && 'body' in child) {
                          const card = child as AboutSubItem;
                          return (
                            <li role="none" class="avh__submenu-item--card">
                              <a href={card.href} role="menuitem" class="avh__about-card" aria-current={isChildCurrent ? 'page' : undefined}>
                                <span class="avh__about-icon" aria-hidden="true">
                                  <iconify-icon icon={card.icon} width="28" height="28"></iconify-icon>
                                </span>
                                <span class="avh__about-title">{card.label}</span>
                                <span class="avh__about-body">{card.body}</span>
                                <span class="avh__about-cta">LEARN MORE <span class="avh__about-arrow" aria-hidden="true">→</span></span>
                              </a>
                            </li>
                          );
                        }
                        return (
                          <li role="none">
                            <a
                              href={child.href}
                              role="menuitem"
                              class:list={['avh__sublink', isChildCurrent && 'avh__sublink--current']}
                              aria-current={isChildCurrent ? 'page' : undefined}
                            >
                              {child.label}
                            </a>
                          </li>
                        );
                      })
                      )}
                    </ul>
                  </>
                ) : (
                  <a
                    href={item.href}
                    class:list={['avh__link', isCurrent(item) && 'avh__link--current']}
                    aria-current={isCurrent(item) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                )}
              </li>
            ))}
          </ul>
        </nav>

      </div>
    </div>
  </div>

  {/* ── Mobile header ── */}
  <div class="avh__mobile">
    <a href="/" aria-label="Red Rocks Fire Protection home" class="avh__logo-box--mobile">
      <img
        src="/images/RRFPS_LOGO.png"
        alt="Red Rocks Fire Protection"
        class="avh__logo avh__logo--mobile"
      />
    </a>
    <button
      type="button"
      class="avh__burger"
      aria-label="Open menu"
      aria-expanded="false"
      data-menu-trigger
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  {/* Mobile drawer */}
  <div class="avh__drawer" data-menu-overlay aria-hidden="true">
    <nav aria-label="Mobile primary">
      <ul>
        {navItems.map((item) => (
          <li>
            {item.children ? (
              /* Mobile: parent is a header. If it has an href (INDUSTRIES WE
               * SERVE) it links to its page; otherwise it's a plain label.
               * Children are always listed indented below. */
              <>
                {item.href ? (
                  <a
                    href={item.href}
                    class:list={['avh__drawer-parent', 'avh__drawer-parent--link', isCurrent(item) && 'avh__drawer-link--current']}
                    aria-current={currentPath === item.href ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                ) : (
                  <span class="avh__drawer-parent">{item.label}</span>
                )}
                <ul class="avh__drawer-sub">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class:list={[
                          currentPath === child.href && 'avh__drawer-link--current',
                        ]}
                        aria-current={currentPath === child.href ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

