  /* ── About dropdown — rich tile-card variant ─────────────────────────
   * Faithful to the colleague's screenshot: light cream panel with a
   * 4×2 grid of cards. Each card has a red icon square, a title, a body
   * blurb, and a red "LEARN MORE →" CTA. Uses class:list to scope every
   * rule to .avh__item--about so Services + Industries dropdowns are
   * untouched.
   */
  .avh__item--about > .avh__submenu,
  .avh__item--industries > .avh__submenu {
    /* Full-width: anchor to viewport edges. Because the dropdown's
       containing block is the <li> (which is much narrower than the
       viewport), we use `position: fixed` to escape it and place the
       panel relative to the viewport directly. `top` matches the
       header's effective height so the panel sits flush below the nav.
       !important on width/max-width defeats the base rule's
       max-width: 320px which would otherwise cap the grid container. */
    position: fixed !important;
    left: 0 !important;
    right: 0 !important;
    width: 100vw !important;
    max-width: none !important;
    top: 135px;            /* matches .avh desktop header height (overridden in mobile breakpoint) */
    margin: 0 !important;
    transform: none;
    height: auto;            /* override the implicit height inherited via the parent <li> */
    padding: 36px 40px 32px;
    background: #F4F2F1;
    box-shadow: 0 18px 40px rgba(10, 10, 10, 0.22);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: auto auto;
    gap: 24px 28px;
    z-index: 60;
    isolation: isolate;
  }
  /* Industries has 14 cards → let the grid flow to as many rows as needed
     (4 columns × 4 rows) instead of being locked to About's 2 rows. */
  .avh__item--industries > .avh__submenu {
    grid-template-rows: none;
    grid-auto-rows: auto;
  }
  /* When opening via hover/focus/.is-open, just make it visible (no transform) */
  .avh__item--about:hover > .avh__submenu,
  .avh__item--about:focus-within > .avh__submenu,
  .avh__item--about.is-open > .avh__submenu,
  .avh__item--industries:hover > .avh__submenu,
  .avh__item--industries:focus-within > .avh__submenu,
  .avh__item--industries.is-open > .avh__submenu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  /* Re-trigger hover-open path (trigger sits above menu in DOM, but our
     fixed-positioning means transform doesn't matter — just show) */
  .avh__item--about .avh__link--trigger:hover + .avh__submenu,
  .avh__item--about .avh__link--trigger:focus-visible + .avh__submenu,
  .avh__item--industries .avh__link--trigger:hover + .avh__submenu,
  .avh__item--industries .avh__link--trigger:focus-visible + .avh__submenu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .avh__item--about > .avh__submenu > li,
  .avh__item--industries > .avh__submenu > li {
    width: auto;
    display: block;
    list-style: none;
  }
  .avh__about-card {
