---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Absolute URL of the canonical page (used for og:url + rel=canonical). */
  canonical?: string;
  /** Absolute URL of the social-share image. */
  image?: string;
  /** og:type — "website" (default) or "article" for blog posts. */
  type?: 'website' | 'article';
  /** ISO publish date — used for article:published_time. */
  publishDate?: string;
  /** ISO modified date — used for article:modified_time. */
  modifiedDate?: string;
  /** Author byline for og:article:author. */
  author?: string;
  /** Pre-built JSON-LD payload (stringified). Inserted verbatim. */
  schema?: string;
}

const {
  title,
  description = 'Red Rocks Fire Protection — Colorado fire safety inspections, sprinkler systems, and 24/7 monitoring.',
  canonical,
  image,
  type = 'website',
  publishDate,
  modifiedDate,
  author,
  schema,
} = Astro.props;

// Launch integrations. PUBLIC_* vars are inlined at build time, so changing
// one in Vercel needs a redeploy.
//   - GA4 + Clarity: public IDs with committed defaults; the env vars only
//     override them. Rendered in production builds only (never `astro dev`),
//     so local work doesn't pollute analytics.
//   - Search Console: optional; the meta tag is omitted when unset.
const DEFAULT_GA_MEASUREMENT_ID = 'G-KNQDF95RGK';
const DEFAULT_CLARITY_PROJECT_ID = 'yqnio023pg';
const isProd = import.meta.env.PROD;
const gaMeasurementId = isProd
  ? import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() || DEFAULT_GA_MEASUREMENT_ID
  : undefined;
const clarityProjectId = isProd
  ? import.meta.env.PUBLIC_CLARITY_PROJECT_ID?.trim() || DEFAULT_CLARITY_PROJECT_ID
  : undefined;
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION?.trim();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta property="og:site_name" content="Red Rocks Fire Protection" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    {type === 'article' && publishDate && (
      <meta property="article:published_time" content={publishDate} />
    )}
    {type === 'article' && modifiedDate && (
      <meta property="article:modified_time" content={modifiedDate} />
    )}
    {type === 'article' && author && (
      <meta property="article:author" content={author} />
    )}
    {schema && <script type="application/ld+json" set:html={schema} />}
    {/* Google Analytics 4 (gtag.js). Lives in <head>, so ClientRouter keeps
     * it across soft navigations instead of re-running it; GA4's enhanced
     * measurement ("page changes based on browser history events", on by
     * default) records those navigations as page_views. Lead events are
     * sent from the contact form (src/pages/contact.astro). */}
    {gaMeasurementId && (
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaMeasurementId)}`}></script>
    )}
    {gaMeasurementId && (
      <script is:inline define:vars={{ gaMeasurementId }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function gtag() { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', gaMeasurementId);
      </script>
    )}
    {/* Microsoft Clarity — official loader, kept inline (not bundled) with
     * the project ID passed in via define:vars. In <head> so it persists
     * across ClientRouter navigations; Clarity tracks history changes. */}
    {clarityProjectId && (
      <script is:inline define:vars={{ clarityProjectId }}>
        (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window, document, "clarity", "script", clarityProjectId);
      </script>
    )}
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body class="bg-rr-bg-light text-rr-black min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    {/* Iconify icon web-component runtime — registers <iconify-icon>
     * globally so any page can drop in <iconify-icon icon="mdi:..." />.
     * Bundled by Vite from node_modules rather than served raw. */}
    <script>import 'iconify-icon';</script>

    {/* GSAP + ScrollTrigger — loaded on every page so sections that want
     * scroll-triggered reveals work without each page re-loading them.
     * is:inline keeps them as plain <script src> tags (not bundled) so
     * they execute before any module scripts that depend on `gsap`.
     */}
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js"></script>

    {/* Reveal-on-scroll observer — design.md §5
 * Re-runs on every astro:page-load event so SPA-navigated pages
 * (via ClientRouter) also get their content revealed.
 */}
    <script>
      function initRevealObserver() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (reduceMotion) {
          // No motion: show final state immediately
          document.querySelectorAll('.rr-reveal').forEach((el) => el.classList.add('is-visible'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
        );

        document.querySelectorAll('.rr-reveal').forEach((el) => observer.observe(el));
      }

      // Runs on initial load AND after every ClientRouter navigation.
      document.addEventListener('astro:page-load', initRevealObserver);
    </script>

    {/* Accordions — one shared binder so a page cannot attach a second
     * click listener that immediately collapses the panel it just opened. */}
    <script>
      import { bindAccordions } from '../scripts/accordion';
      bindAccordions();
    </script>
  </body>
</html>